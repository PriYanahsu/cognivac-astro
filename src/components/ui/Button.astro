---
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

/**
 * Port of components/ui/button.tsx. The Next version used `cva`; the variant
 * maps below hold the identical class strings, resolved at build time.
 *
 * `asChild` (Radix Slot) has no Astro equivalent — pass `href` instead and the
 * component renders an <a> with the same classes.
 */
export type ButtonVariant =
  | "default"
  | "ghost"
  | "outline"
  | "secondary"
  | "link";
export type ButtonSize = "default" | "sm" | "lg" | "icon";

interface Props extends Omit<HTMLAttributes<"button">, "size"> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  type?: "button" | "submit" | "reset";
}

const BASE =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full text-sm font-semibold transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50";

const VARIANTS: Record<ButtonVariant, string> = {
  default:
    "bg-accent text-white shadow-glow hover:bg-[#1a1a1c] hover:text-white hover:shadow-none",
  ghost:
    "border border-primary/30 bg-transparent text-primary hover:border-accent hover:bg-accent hover:text-white",
  outline: "border border-white/40 bg-transparent text-white hover:bg-white/10",
  secondary: "bg-lavender text-primary hover:bg-lavender/80",
  link: "rounded-none text-accent underline-offset-4 hover:underline",
};

const SIZES: Record<ButtonSize, string> = {
  default: "h-11 px-6 py-2",
  sm: "h-9 px-4 text-xs",
  lg: "h-14 px-8 text-base",
  icon: "h-10 w-10",
};

const {
  variant = "default",
  size = "default",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const classes = cn(BASE, VARIANTS[variant], SIZES[size], className);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
