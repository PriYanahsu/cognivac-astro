---
import { cn } from "@/lib/utils";

/** Port of components/shared/section-label.tsx. */
interface Props {
  class?: string;
  tone?: "accent" | "primary" | "white";
}

const { class: className, tone = "accent" } = Astro.props;
---

<p
  class={cn(
    "text-mono-eyebrow mb-0",
    tone === "accent" && "text-accent",
    tone === "primary" && "text-foreground",
    tone === "white" && "text-white/80",
    className,
  )}
>
  <slot />
</p>
