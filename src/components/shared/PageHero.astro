---
import { ChevronRight } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import { cn } from "@/lib/utils";

/**
 * Port of components/shared/page-hero.tsx.
 * The framer-motion stagger (0.08s between children, 0.04s lead-in) is now a
 * `data-reveal-stagger` container; lib/reveal.ts assigns each child its delay.
 */
interface Crumb {
  label: string;
  href?: string;
}

interface HeroCta {
  label: string;
  href: string;
}

interface Props {
  label: string;
  title: string;
  description: string;
  /** Trail after Home — e.g. [{ label: "Careers" }]. */
  breadcrumbs?: Crumb[];
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  /** Short proof chips under the CTAs — keep to three or fewer. */
  highlights?: readonly string[];
  class?: string;
}

const {
  label,
  title,
  description,
  breadcrumbs,
  primaryCta,
  secondaryCta,
  highlights,
  class: className,
} = Astro.props;
---

<section
  class={cn(
    "relative overflow-hidden bg-[#1a1a1c] pb-14 pt-24 text-white sm:pb-20 sm:pt-32 lg:pb-24 lg:pt-38",
    className,
  )}
>
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-70"></div>
  <div
    aria-hidden="true"
    class="page-hero-halo pointer-events-none absolute left-1/2 top-0 h-[280px] w-[520px] rounded-full bg-accent/25 blur-[90px] sm:h-[420px] sm:w-[820px] sm:blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-linear-to-r from-transparent via-white/20 to-transparent"
  >
  </div>

  <Container class="relative z-10">
    <div
      data-reveal-stagger
      data-reveal-margin="-80px"
      data-stagger="0.08"
      data-delay-children="0.04"
      style="--reveal-item-y:18px;--reveal-item-duration:0.6s"
      class="mx-auto max-w-4xl text-center"
    >
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <nav
            data-reveal-item
            aria-label="Breadcrumb"
            class="mb-5 flex flex-wrap items-center justify-center gap-1.5 text-[12px] text-white/50 sm:mb-7 sm:text-[13px]"
          >
            <a href="/" class="transition-colors hover:text-white">
              Home
            </a>
            {breadcrumbs.map((crumb) => (
              <span class="flex items-center gap-1.5">
                <ChevronRight class="h-3.5 w-3.5 text-white/30" />
                {crumb.href ? (
                  <a
                    href={crumb.href}
                    class="transition-colors hover:text-white"
                  >
                    {crumb.label}
                  </a>
                ) : (
                  <span class="text-white/80">{crumb.label}</span>
                )}
              </span>
            ))}
          </nav>
        )
      }

      <div data-reveal-item>
        <SectionLabel class="mb-0 text-accent-on-dark">{label}</SectionLabel>
      </div>

      <h1
        data-reveal-item
        class="text-hero mx-auto mt-3.5 max-w-[20ch] leading-[1.05] text-white sm:mt-5 sm:max-w-[26ch] sm:leading-[1.08]"
      >
        {title}
      </h1>

      <p
        data-reveal-item
        class="mx-auto mt-3.5 max-w-[46ch] text-[14.5px] leading-[1.55] text-white/75 sm:mt-5 sm:max-w-[62ch] sm:text-[18px] sm:leading-[1.6]"
      >
        {description}
      </p>

      {
        (primaryCta || secondaryCta) && (
          <div
            data-reveal-item
            class="mt-7 flex flex-col items-stretch justify-center gap-2.5 sm:mt-9 sm:flex-row sm:items-center sm:gap-4"
          >
            {primaryCta && (
              <GradientButton
                href={primaryCta.href}
                size="lg"
                class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto"
              >
                {primaryCta.label}
              </GradientButton>
            )}
            {secondaryCta && (
              <GhostButton
                href={secondaryCta.href}
                tone="light"
                size="lg"
                class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto"
              >
                {secondaryCta.label}
              </GhostButton>
            )}
          </div>
        )
      }

      {
        highlights && highlights.length > 0 && (
          <ul
            data-reveal-item
            class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:mt-9 sm:gap-2.5"
          >
            {highlights.map((highlight) => (
              <li class="rounded-full border border-white/15 bg-white/[0.06] px-3 py-1.5 text-[12px] font-medium text-white/75 sm:px-4 sm:py-2 sm:text-[13px]">
                {highlight}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Container>
</section>
