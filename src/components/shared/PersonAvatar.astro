---
import { cn } from "@/lib/utils";

/**
 * Port of components/shared/person-avatar.tsx.
 * A portrait if there is one, a monogram if there is not.
 */

function initialsOf(name: string) {
  return name
    .split(" ")
    .filter(Boolean)
    .map((part) => part[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
}

interface Props {
  name: string;
  image?: string;
  size?: number;
  shape?: "circle" | "rounded";
  tone?: "dark" | "light";
  class?: string;
}

const {
  name,
  image,
  size = 48,
  shape = "circle",
  tone = "dark",
  class: className,
} = Astro.props;

const radius = shape === "circle" ? "rounded-full" : "rounded-md";
const initials = initialsOf(name);
---

<span
  class={cn(
    "relative inline-flex shrink-0 items-center justify-center overflow-hidden",
    radius,
    tone === "dark"
      ? "bg-linear-to-br from-accent/85 to-indigo text-white ring-1 ring-white/15"
      : "bg-linear-to-br from-lavender to-border text-foreground ring-1 ring-border",
    className,
  )}
  style={`width:${size}px;height:${size}px`}
>
  {
    image ? (
      <img
        src={image}
        alt={name}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span
        aria-hidden="true"
        class="font-bold leading-none tracking-[0.02em]"
        style={`font-size:${Math.round(size * 0.36)}px`}
      >
        {initials}
      </span>
    )
  }
</span>
