---
import { cn } from "@/lib/utils";

/** Port of components/shared/ghost-button.tsx. */
interface Props {
  href?: string;
  class?: string;
  tone?: "dark" | "light";
  size?: "default" | "lg" | "sm";
  type?: "button" | "submit";
}

const SIZE_CLASSES = {
  sm: "h-9 min-h-9 px-1.5 text-button-md",
  default: "h-11 min-h-11 px-[14px] text-button-lg",
  lg: "h-14 min-h-14 px-8 text-button-lg",
} as const;

const {
  href,
  class: className,
  tone = "dark",
  size = "default",
  type = "button",
} = Astro.props;

const isSm = size === "sm";

const classes = cn(
  "inline-flex items-center justify-center gap-2 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2",
  SIZE_CLASSES[size],
  tone === "dark" &&
    (isSm
      ? "button-ghost-sm text-ink hover:border-accent hover:bg-accent hover:text-on-primary"
      : "button-secondary rounded-pill text-ink hover:border-accent hover:bg-accent hover:text-on-primary"),
  tone === "light" &&
    (isSm
      ? "button-ghost-sm border-white/40 bg-transparent text-white hover:border-accent hover:bg-accent hover:text-on-primary"
      : "rounded-pill border border-white/40 bg-transparent text-button-lg text-white hover:border-accent hover:bg-accent hover:text-on-primary"),
  className,
);
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
