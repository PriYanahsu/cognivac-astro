---
import { cn } from "@/lib/utils";

/** Port of components/shared/ghost-button.tsx. */
interface Props {
  href?: string;
  class?: string;
  /**
   * Kept from the original API, and it names the band rather than the button:
   * `dark` is the dark-text button that sits on a light band, `light` is the
   * white-text one on a dark band.
   */
  tone?: "dark" | "light";
  size?: "default" | "lg" | "sm";
  type?: "button" | "submit";
  /**
   * Adds the arrow-travel hover for a slotted `ArrowUpRight`, which leaves up
   * and to the right rather than straight forward.
   */
  diagonalArrow?: boolean;
}

const SIZE_CLASSES = {
  sm: "h-9 min-h-9 px-1.5 text-button-md",
  default: "cta-outline h-11 min-h-11 px-6",
  lg: "cta-outline h-14 min-h-14 px-8",
} as const;

const {
  href,
  class: className,
  tone = "dark",
  size = "default",
  type = "button",
  diagonalArrow = false,
} = Astro.props;

const isSm = size === "sm";

const classes = cn(
  "inline-flex items-center justify-center gap-2 focus-visible:outline-none",
  SIZE_CLASSES[size],
  isSm &&
    (tone === "dark"
      ? "button-ghost-sm text-ink transition-all duration-300 hover:border-accent hover:bg-accent hover:text-on-primary"
      : "button-ghost-sm border-white/40 bg-transparent text-white transition-all duration-300 hover:border-accent hover:bg-accent hover:text-on-primary"),
  !isSm && tone === "light" && "cta-outline-on-dark",
  !isSm && diagonalArrow && "cta-arrow-diagonal",
  className,
);
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
