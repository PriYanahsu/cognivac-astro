---
import { cn } from "@/lib/utils";

/**
 * Port of components/shared/chip-cloud.tsx.
 *
 * A wrapped set of tags that assembles itself on arrival. No vertical travel,
 * only scale and opacity — a wrapped list has no single reading direction.
 */
interface Props {
  items: readonly string[];
  /** `dark` for the near-black bands, `light` for canvas and card. */
  tone?: "light" | "dark";
  align?: "left" | "center";
  class?: string;
}

const {
  items,
  tone = "light",
  align = "center",
  class: className,
} = Astro.props;

const dark = tone === "dark";
---

<ul
  data-reveal-stagger
  data-reveal-margin="-10% 0px"
  data-stagger="0.035"
  style="--reveal-item-y:0px;--reveal-item-duration:0.4s"
  class={cn(
    "flex flex-wrap gap-2 sm:gap-2.5",
    align === "center" ? "justify-center" : "justify-start",
    className,
  )}
>
  {
    items.map((label) => (
      <li
        data-reveal-item
        data-reveal-scale
        class={cn(
          "rounded-full border px-3 py-1.5 text-[12.5px] font-medium transition-colors duration-300 sm:px-4 sm:py-2 sm:text-[13.5px]",
          dark
            ? "border-white/15 bg-white/6 text-white/75 hover:border-white/35 hover:text-white"
            : "border-border bg-card text-muted hover:border-accent/40 hover:text-foreground",
        )}
      >
        {label}
      </li>
    ))
  }
</ul>
