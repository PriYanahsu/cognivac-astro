---
import { cn } from "@/lib/utils";

/** Port of components/shared/container.tsx. */
interface Props {
  class?: string;
  as?: "div" | "section" | "article" | "main";
}

const { class: className, as: Tag = "div" }: Props = Astro.props;
---

<Tag class={cn("section-container", className)}>
  <slot />
</Tag>
