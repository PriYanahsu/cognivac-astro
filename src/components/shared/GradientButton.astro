---
import { ArrowRight } from "@lucide/astro";
import { cn } from "@/lib/utils";

/** Port of components/shared/gradient-button.tsx. */
interface Props {
  href?: string;
  class?: string;
  showArrow?: boolean;
  size?: "default" | "lg" | "sm";
  type?: "button" | "submit";
  ariaLabel?: string;
  id?: string;
}

const SIZE_CLASSES = {
  sm: "button-primary-sm h-9 min-h-9 px-1.5 text-button-md",
  default: "button-primary h-11 min-h-11 px-[14px] text-button-lg rounded-pill",
  lg: "button-primary h-14 min-h-14 px-8 text-button-lg rounded-pill",
} as const;

const {
  href,
  class: className,
  showArrow = true,
  size = "default",
  type = "button",
  ariaLabel,
  id,
} = Astro.props;

const classes = cn(
  "inline-flex items-center justify-center gap-2 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2",
  size === "sm" ? "shadow-none" : "shadow-glow hover:bg-ink hover:shadow-none",
  SIZE_CLASSES[size],
  className,
);
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel} id={id}>
      <slot />
      {showArrow && <ArrowRight class="h-4 w-4" />}
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} id={id}>
      <slot />
      {showArrow && <ArrowRight class="h-4 w-4" />}
    </button>
  )
}
