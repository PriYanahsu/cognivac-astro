---
import { ArrowRight } from "@lucide/astro";
import { cn } from "@/lib/utils";

/** Port of components/shared/gradient-button.tsx. */
interface Props {
  href?: string;
  class?: string;
  showArrow?: boolean;
  size?: "default" | "lg" | "sm";
  type?: "button" | "submit";
  ariaLabel?: string;
  id?: string;
  /**
   * Which band the button is sitting on, not what colour it is. Cobalt on
   * near-black needs a stronger ambient glow and inverts to white on hover;
   * cobalt on near-white needs a contact shadow and deepens to ink. Sections
   * used to hand-roll the dark case as `hover:bg-white hover:text-accent`
   * overrides at each call site, which is why no two of them matched.
   */
  surface?: "light" | "dark";
  /** Button form only — a link cannot be disabled. */
  disabled?: boolean;
}

const SIZE_CLASSES = {
  sm: "button-primary-sm h-9 min-h-9 px-1.5 text-button-md",
  default: "cta-fill h-11 min-h-11 px-6",
  lg: "cta-fill h-14 min-h-14 px-8",
} as const;

const {
  href,
  class: className,
  showArrow = true,
  size = "default",
  type = "button",
  ariaLabel,
  id,
  surface = "light",
  disabled = false,
} = Astro.props;

const isSm = size === "sm";

const classes = cn(
  "inline-flex items-center justify-center gap-2 focus-visible:outline-none",
  SIZE_CLASSES[size],
  !isSm && surface === "dark" && "cta-fill-on-dark",
  disabled && "cursor-not-allowed opacity-60",
  className,
);
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel} id={id}>
      <slot />
      {showArrow && <ArrowRight class={isSm ? "h-4 w-4" : "cta-arrow"} />}
    </a>
  ) : (
    <button
      type={type}
      class={classes}
      aria-label={ariaLabel}
      id={id}
      disabled={disabled}
    >
      <slot />
      {showArrow && <ArrowRight class={isSm ? "h-4 w-4" : "cta-arrow"} />}
    </button>
  )
}
