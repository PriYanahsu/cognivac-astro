---
import CountUp from "@/components/shared/CountUp.astro";
import { cn } from "@/lib/utils";

/**
 * Port of components/shared/stat-counter.tsx.
 *
 * A figure with its caption, for light surfaces. The counting itself lives
 * in `CountUp` — this is the light band's presentation of it. Dark bands
 * compose `CountUp` directly rather than passing a tone through here:
 * `gradient-text` ends on the ink colour, which on a near-black band is
 * the background.
 */
interface Props {
  value: number;
  suffix?: string;
  prefix?: string;
  decimals?: number;
  label: string;
  class?: string;
  duration?: number;
}

const {
  value,
  suffix = "",
  prefix = "",
  decimals = 0,
  label,
  class: className,
  duration = 1600,
} = Astro.props;
---

<div class={cn("text-center", className)}>
  {/* The floor is 1.75rem, not 2.25rem: these bands run three across even
      on a phone, which leaves each figure about a third of a 350px column
      — and a figure that overflows its column is not a proof point. */}
  <p
    class="gradient-text text-[clamp(1.75rem,6vw,3.75rem)] font-bold leading-none tracking-[-0.02em]"
  >
    <CountUp
      value={value}
      prefix={prefix}
      suffix={suffix}
      decimals={decimals}
      durationMs={duration}
    />
  </p>
  <p
    class="mx-auto mt-2 max-w-[24ch] text-[11.5px] leading-snug text-muted sm:mt-3 sm:text-[15px]"
  >
    {label}
  </p>
</div>
