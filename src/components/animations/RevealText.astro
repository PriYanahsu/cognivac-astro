---
import { cn } from "@/lib/utils";

/**
 * Port of components/animations/reveal-text.tsx.
 * Words are split at build time rather than in the browser, so the text is
 * present in the served HTML for crawlers and there is no layout shift.
 */
interface Props {
  text: string;
  class?: string;
  as?: "h1" | "h2" | "h3" | "p";
  delay?: number;
}

const {
  text,
  class: className,
  as: Tag = "h2",
  delay = 0,
}: Props = Astro.props;

const words = text.split(" ");
---

<Tag data-reveal-word class={cn("overflow-hidden", className)}>
  {
    words.map((word, i) => (
      <span>
        <span style={`--reveal-delay:${delay + i * 0.04}s`}>
          {word}
          {i < words.length - 1 ? " " : ""}
        </span>
      </span>
    ))
  }
</Tag>
