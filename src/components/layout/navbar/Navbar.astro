---
import { NAV_ITEMS } from "@/constants/navigation";
import { NAV_ROUTES, SITE_CONFIG } from "@/constants/site";
import GradientButton from "@/components/shared/GradientButton.astro";
import NavLinks from "./NavLinks.astro";
import SearchButton from "./SearchButton.astro";
import MobileDrawer from "./MobileDrawer.astro";

/**
 * Port of components/layout/navbar/index.tsx.
 * `useScrolled(16)` becomes a passive scroll listener toggling `data-scrolled`.
 */
---

<header
  class="pointer-events-none fixed inset-x-0 top-0 z-50 w-full bg-transparent px-3 pt-[max(0.75rem,env(safe-area-inset-top))] sm:px-4"
>
  <div
    data-navbar
    data-scrolled="false"
    class="pointer-events-auto mx-auto flex h-12 w-full min-w-0 max-w-[1440px] items-center justify-between gap-2 rounded-2xl border border-white/10 bg-[#2f2f32]/90 px-2.5 shadow-[0_8px_32px_rgba(0,0,0,0.28)] backdrop-blur-xl transition-[background-color,box-shadow,height] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] sm:h-14 sm:gap-3 sm:px-3 lg:h-16 lg:px-5"
  >
    <a
      href={NAV_ROUTES.home}
      class="min-w-0 shrink-0"
      aria-label={`${SITE_CONFIG.name} home`}
    >
      <img
        src="/icons/cognivac.png"
        alt={SITE_CONFIG.name}
        width="200"
        height="56"
        fetchpriority="high"
        decoding="async"
        class="h-6 w-auto max-w-[7.5rem] object-contain brightness-0 invert sm:h-7 sm:max-w-none lg:h-8"
      />
    </a>

    <nav aria-label="Primary" class="hidden flex-1 justify-center lg:flex">
      <NavLinks items={NAV_ITEMS} />
    </nav>

    <div class="flex shrink-0 items-center gap-0.5 sm:gap-1.5">
      <SearchButton />
      <GradientButton
        href={NAV_ROUTES.contact}
        size="sm"
        showArrow={false}
        class="hidden lg:inline-flex"
      >
        Contact us
      </GradientButton>
      <MobileDrawer />
    </div>
  </div>
</header>

<style>
  /* Matches `scrolled && "bg-[#2b2b2e]/95 shadow-[...]"` in the React version. */
  [data-navbar][data-scrolled="true"] {
    height: 2.75rem;
    background-color: rgb(43 43 46 / 0.95);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 640px) {
    [data-navbar][data-scrolled="true"] {
      height: 3.25rem;
    }
  }

  @media (min-width: 1024px) {
    [data-navbar][data-scrolled="true"] {
      height: 3.5rem;
    }
  }
</style>

<script>
  function initNavbarScroll() {
    const navbar = document.querySelector<HTMLElement>("[data-navbar]");
    if (!navbar || navbar.dataset.scrollReady === "true") return;
    navbar.dataset.scrollReady = "true";

    const THRESHOLD = 16;
    const update = () => {
      navbar.dataset.scrolled = window.scrollY > THRESHOLD ? "true" : "false";
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  initNavbarScroll();
  document.addEventListener("astro:page-load", initNavbarScroll);
</script>
