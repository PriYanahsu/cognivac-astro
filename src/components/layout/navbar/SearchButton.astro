---
import { Search } from "@lucide/astro";
import Dialog from "@/components/ui/Dialog.astro";
import Input from "@/components/ui/Input.astro";

/** Search dialog — static index over pages + posts. */
---

<Dialog title="Search Cognivac" class="max-w-xl">
  <button
    slot="trigger"
    type="button"
    data-overlay-trigger
    data-search-trigger="hidden"
    aria-label="Search"
    aria-expanded="false"
    class="hidden"
  >
    <Search class="h-5 w-5" />
  </button>

  <form data-search-form class="mt-2">
    <Input
      type="search"
      name="q"
      placeholder="Search solutions, case studies, articles..."
      aria-label="Search query"
      data-autofocus
      autocomplete="off"
    />
    <ul data-search-results class="mt-4 max-h-80 space-y-1 overflow-y-auto"></ul>
    <p data-search-empty class="mt-3 hidden text-sm text-muted">
      No matches. Try a capability, industry, or article title.
    </p>
  </form>
</Dialog>

<script>
  import { openOverlay } from "@/lib/overlay";
  import type { SearchEntry } from "@/lib/search/catalog";

  let index: SearchEntry[] = [];
  let loaded = false;

  async function loadIndex() {
    if (loaded) return index;
    try {
      const res = await fetch("/search-index.json");
      index = (await res.json()) as SearchEntry[];
      loaded = true;
    } catch {
      index = [];
    }
    return index;
  }

  function renderResults(root: HTMLElement, query: string, entries: SearchEntry[]) {
    const list = root.querySelector<HTMLElement>("[data-search-results]");
    const empty = root.querySelector<HTMLElement>("[data-search-empty]");
    if (!list || !empty) return;

    const q = query.trim().toLowerCase();
    const hits = q
      ? entries
          .filter((entry) =>
            `${entry.title} ${entry.description} ${entry.category}`
              .toLowerCase()
              .includes(q),
          )
          .slice(0, 8)
      : entries.slice(0, 6);

    list.innerHTML = hits
      .map(
        (hit) => `
      <li>
        <a href="${hit.href}" class="block rounded-md px-3 py-2.5 hover:bg-lavender/60">
          <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-accent">${hit.category}</span>
          <span class="mt-0.5 block text-[15px] font-semibold text-foreground">${hit.title}</span>
          <span class="mt-0.5 block text-[13px] text-muted">${hit.description}</span>
        </a>
      </li>`,
      )
      .join("");

    empty.classList.toggle("hidden", hits.length > 0 || q.length === 0);
  }

  function initSearch() {
    const dialogRoot = document
      .querySelector<HTMLElement>("[data-search-form]")
      ?.closest<HTMLElement>("[data-overlay-root]");
    if (!dialogRoot || dialogRoot.dataset.searchReady === "true") return;
    dialogRoot.dataset.searchReady = "true";

    const form = dialogRoot.querySelector<HTMLFormElement>("[data-search-form]");
    const input = form?.querySelector<HTMLInputElement>("input[type='search']");

    const openSearch = async (trigger?: HTMLElement) => {
      openOverlay(dialogRoot, trigger);
      const entries = await loadIndex();
      if (form) renderResults(form, input?.value ?? "", entries);
    };

    const bindTriggers = () => {
      document.querySelectorAll<HTMLElement>("[data-search-trigger]").forEach(
        (trigger) => {
          if (trigger.dataset.searchTriggerBound === "true") return;
          if (trigger.dataset.searchTrigger === "hidden") return;
          trigger.dataset.searchTriggerBound = "true";
          trigger.addEventListener("click", () => openSearch(trigger));
        },
      );
    };

    bindTriggers();

    const onKeyDown = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        void openSearch();
      }
    };

    window.addEventListener("keydown", onKeyDown);

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const first = form.querySelector<HTMLAnchorElement>("[data-search-results] a");
      first?.click();
    });

    input?.addEventListener("input", async () => {
      const entries = await loadIndex();
      renderResults(form!, input.value, entries);
    });
  }

  initSearch();
  document.addEventListener("astro:page-load", initSearch);
</script>
