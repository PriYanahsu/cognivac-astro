---
import { Search } from "@lucide/astro";
import { cn } from "@/lib/utils";

/** Mobile-only search icon trigger — pairs with SearchButton dialog. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-search-trigger="icon-mobile"
  aria-label="Search"
  class={cn(
    "flex h-9 w-9 items-center justify-center rounded-full text-white/75 transition-colors hover:bg-white/10 hover:text-white sm:h-10 sm:w-10 lg:hidden",
    className,
  )}
>
  <Search class="h-5 w-5" />
</button>
