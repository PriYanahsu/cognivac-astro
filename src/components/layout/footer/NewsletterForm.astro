---
import { ArrowRight } from "@lucide/astro";
import Input from "@/components/ui/Input.astro";

/**
 * Port of components/layout/footer/newsletter-form.tsx.
 * react-hook-form + zod are replaced by the same single rule enforced inline.
 */
---

<form data-newsletter-form class="space-y-3" novalidate>
  <div>
    <p class="text-mono-eyebrow uppercase tracking-[0.12em] text-white/55">
      Newsletter
    </p>
    <p class="mt-2 text-body-md text-white/70">
      Monthly AI engineering notes — no spam, unsubscribe anytime.
    </p>
  </div>

  <div
    class="flex overflow-hidden rounded-full border border-white/15 bg-white/6 p-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] focus-within:border-accent/50 focus-within:bg-white/8"
  >
    <Input
      type="email"
      name="email"
      placeholder="you@company.com"
      aria-label="Email for newsletter"
      class="h-10 min-w-0 flex-1 border-0 bg-transparent px-3 text-body-md text-white shadow-none placeholder:text-white/40 focus-visible:border-transparent focus-visible:ring-0 sm:px-3.5"
    />
    <button
      type="submit"
      aria-label="Subscribe to newsletter"
      class="group inline-flex h-10 shrink-0 items-center gap-1.5 rounded-full bg-accent px-3 text-button-md font-semibold text-white transition-[background-color,box-shadow,transform] duration-300 sm:px-4 hover:bg-indigo hover:shadow-glow active:scale-[0.98] disabled:opacity-70"
    >
      <span data-newsletter-label>Subscribe</span>
      <ArrowRight
        class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
      />
    </button>
  </div>

  <p data-newsletter-error class="hidden text-xs text-error" role="alert"></p>
  <p data-newsletter-success class="hidden text-xs text-emerald-300" role="status">
    Thanks — you&apos;re subscribed.
  </p>
</form>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function initNewsletter() {
    document
      .querySelectorAll<HTMLFormElement>("[data-newsletter-form]")
      .forEach((form) => {
        if (form.dataset.newsletterReady === "true") return;
        form.dataset.newsletterReady = "true";

        const input = form.querySelector<HTMLInputElement>(
          'input[name="email"]',
        );
        const label = form.querySelector<HTMLElement>("[data-newsletter-label]");
        const submitBtn = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        const error = form.querySelector<HTMLElement>("[data-newsletter-error]");
        const success = form.querySelector<HTMLElement>(
          "[data-newsletter-success]",
        );
        if (!input || !label || !submitBtn || !error || !success) return;

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          error.classList.add("hidden");
          success.classList.add("hidden");

          if (!EMAIL_RE.test(input.value.trim())) {
            error.textContent = "Enter a valid email address";
            error.classList.remove("hidden");
            return;
          }

          submitBtn.disabled = true;
          label.textContent = "…";
          await new Promise((resolve) => setTimeout(resolve, 600));
          label.textContent = "Subscribe";
          submitBtn.disabled = false;

          form.reset();
          success.classList.remove("hidden");
        });
      });
  }

  initNewsletter();
  document.addEventListener("astro:page-load", initNewsletter);
</script>
