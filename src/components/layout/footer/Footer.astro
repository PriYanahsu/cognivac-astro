---
import { ArrowUp, ArrowUpRight, Mail, MapPin } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import CognivacLogo from "@/components/shared/CognivacLogo.astro";
import SocialIcon, {
  type SocialIconName,
} from "@/components/shared/SocialIcon.astro";
import { SITE_CONFIG, NAV_ROUTES } from "@/constants/site";
import {
  FOOTER_COMPANY_LINKS,
  FOOTER_SERVICE_LINKS,
  FOOTER_RESOURCE_LINKS,
  FOOTER_LEGAL_LINKS,
} from "./constants";
import NewsletterForm from "./NewsletterForm.astro";

/**
 * Three bands: a sign-off CTA, the directory, and a bottom rule.
 *
 * The previous footer put six outlined `bg-white/5` panels on the page — the
 * newsletter, four social cards, and a CTA box — at four different sizes and
 * three different corner radii. Every one of them was the same value, so
 * nothing led, and a grid of near-identical grey rectangles is the specific
 * thing that makes a footer look assembled rather than designed. There is one
 * panel left in here now, the newsletter, because a form is the only element
 * on the page that has to advertise where to type.
 *
 * The ground is `.gradient-dark`, the site's own dark surface — the same
 * radial the CTA card and the dark bands are cut from, which is why the
 * comment in CtaSection calls this "the gradient-dark footer". It carries its
 * own light: #232327 at the top through #0f0f12 at the floor, so the sign-off
 * sits in the lit part and the legal line settles into the dark. That is the
 * whole texture budget — no lattice, no dot field. A ruled grid behind a
 * copyright line is decoration where the page is meant to be ending.
 *
 * Labels sit at `white/55`, not lower. Against the middle of that gradient 45%
 * lands around 4.1:1 — under the floor for 11px uppercase, which is exactly
 * the size and treatment that can least afford it.
 */

const SOCIAL: Array<{
  label: string;
  href: string;
  handle: string;
  icon: SocialIconName;
}> = [
  {
    label: "LinkedIn",
    href: SITE_CONFIG.social.linkedin.href,
    handle: SITE_CONFIG.social.linkedin.handle,
    icon: "linkedin",
  },
  {
    label: "GitHub",
    href: SITE_CONFIG.social.github.href,
    handle: SITE_CONFIG.social.github.handle,
    icon: "github",
  },
  {
    label: "YouTube",
    href: SITE_CONFIG.social.youtube.href,
    handle: SITE_CONFIG.social.youtube.handle,
    icon: "youtube",
  },
  {
    label: "X",
    href: SITE_CONFIG.social.x.href,
    handle: SITE_CONFIG.social.x.handle,
    icon: "x",
  },
];

const LINK_COLUMNS = [
  { title: "Company", links: FOOTER_COMPANY_LINKS },
  { title: "Services", links: FOOTER_SERVICE_LINKS },
  { title: "Resources", links: FOOTER_RESOURCE_LINKS },
] as const;

const CONTACT = [
  {
    icon: Mail,
    label: SITE_CONFIG.email,
    href: `mailto:${SITE_CONFIG.email}`,
  },
  { icon: MapPin, label: SITE_CONFIG.address, href: undefined },
];

const year = new Date().getFullYear();
---

<footer class="gradient-dark relative overflow-hidden text-white">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-56 -top-64 h-160 w-200 rounded-full bg-[radial-gradient(ellipse,rgba(30,79,216,0.16),rgba(30,79,216,0.05)_45%,transparent_72%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-accent/60 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-64 bg-linear-to-t from-black/35 to-transparent"
  >
  </div>

  <Container class="relative py-12 sm:py-16 lg:py-20">
    {/* Sign-off — the last thing the page asks for */}
    <div
      class="flex flex-col gap-7 border-b border-white/10 pb-10 sm:pb-12 lg:flex-row lg:items-end lg:justify-between lg:gap-16"
    >
      <div>
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent-on-dark"
        >
          Start a project
        </p>
        <p
          class="mt-3.5 max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] font-bold leading-[1.1] tracking-[-0.03em] text-white"
        >
          Tell us what you&apos;re building
        </p>
        <p class="mt-3 max-w-[44ch] text-body-md leading-relaxed text-white/60">
          We&apos;ll reply with a clear next step.
        </p>
      </div>

      <a
        href={NAV_ROUTES.contact}
        class="group inline-flex h-13 w-fit shrink-0 items-center gap-2 rounded-full bg-white px-7 text-button-lg font-semibold text-[#06090f] shadow-[0_18px_40px_-18px_rgba(255,255,255,0.35)] transition-[background-color,color,box-shadow,transform] duration-300 hover:bg-accent hover:text-white hover:shadow-glow active:scale-[0.985]"
      >
        Contact {SITE_CONFIG.name}
        <ArrowUpRight
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>

    {/* Directory */}
    <div class="grid gap-10 pt-10 sm:pt-12 lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16">
      <div class="lg:col-span-4">
        <a
          href={NAV_ROUTES.home}
          class="inline-flex flex-col gap-1"
          aria-label={`${SITE_CONFIG.name} home`}
        >
          <CognivacLogo variant="light" class="h-9 w-auto sm:h-10" />
          <span class="text-[13px] font-medium tracking-wide text-white/55">
            {SITE_CONFIG.tagline}
          </span>
        </a>

        <p class="mt-5 max-w-[42ch] text-body-md leading-relaxed text-white/65">
          {SITE_CONFIG.description}
        </p>

        <ul class="mt-6 space-y-1">
          {
            CONTACT.map(({ icon: Icon, label, href }) => {
              const inner = (
                <>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 text-white/45 transition-colors duration-300 group-hover:border-accent/50 group-hover:text-accent-on-dark">
                    <Icon class="h-3.5 w-3.5" />
                  </span>
                  {label}
                </>
              );
              return (
                <li>
                  {href ? (
                    <a
                      href={href}
                      class="group inline-flex min-h-9 items-center gap-3 text-body-md text-white/72 transition-colors duration-300 hover:text-white"
                    >
                      {inner}
                    </a>
                  ) : (
                    <span class="group inline-flex min-h-9 items-center gap-3 text-body-md text-white/72">
                      {inner}
                    </span>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-10 lg:col-span-5">
        {
          LINK_COLUMNS.map((column) => (
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/55">
                {column.title}
              </p>
              <ul class="mt-4 space-y-0.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group relative inline-flex min-h-9 items-center text-body-md text-white/72 transition-colors duration-300 hover:text-white sm:min-h-0 sm:py-1.5"
                    >
                      {link.label}
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-accent-on-dark/60 transition-transform duration-300 ease-out group-hover:scale-x-100 sm:bottom-1"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div
        class="relative overflow-hidden rounded-lg border border-white/12 bg-[linear-gradient(165deg,rgba(255,255,255,0.075),rgba(255,255,255,0.025))] p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.09)] backdrop-blur-sm sm:p-6 lg:col-span-3 lg:self-start"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-8 top-0 h-px bg-linear-to-r from-transparent via-accent/50 to-transparent"
        >
        </span>
        <NewsletterForm />
      </div>
    </div>

    {/* Bottom rule */}
    <div
      class="mt-10 flex flex-col gap-6 border-t border-white/10 pt-7 sm:mt-12 sm:pt-8 lg:flex-row lg:items-center lg:justify-between lg:gap-10"
    >
      <p class="order-2 text-body-sm text-white/55 lg:order-1">
        © {year}
        {SITE_CONFIG.legalName}. All rights reserved.
      </p>

      <div
        class="order-1 flex flex-wrap items-center gap-x-6 gap-y-4 lg:order-2 lg:justify-end"
      >
        <ul class="flex items-center gap-2">
          {
            SOCIAL.map(({ label, href, handle, icon }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${label} — ${handle}`}
                  title={`${label} — ${handle}`}
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-white/12 text-white/60 transition-[color,border-color,background-color,transform] duration-300 hover:-translate-y-0.5 hover:border-accent/55 hover:bg-white/6 hover:text-white"
                >
                  <SocialIcon name={icon} class="h-4 w-4" />
                </a>
              </li>
            ))
          }
        </ul>

        <span aria-hidden="true" class="hidden h-4 w-px bg-white/12 sm:block">
        </span>

        <ul class="flex flex-wrap items-center gap-x-5">
          {
            FOOTER_LEGAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-9 items-center text-body-sm text-white/55 transition-colors duration-300 hover:text-white sm:min-h-0"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="#main-content"
          class="group inline-flex items-center gap-1.5 text-body-sm text-white/55 transition-colors duration-300 hover:text-white"
        >
          Back to top
          <span
            class="flex h-7 w-7 items-center justify-center rounded-full border border-white/12 transition-[border-color,transform] duration-300 group-hover:-translate-y-0.5 group-hover:border-accent/55"
          >
            <ArrowUp class="h-3.5 w-3.5" aria-hidden="true" />
          </span>
        </a>
      </div>
    </div>
  </Container>
</footer>
