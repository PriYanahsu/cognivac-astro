---
import Container from "@/components/shared/Container.astro";
import Separator from "@/components/ui/Separator.astro";
import SocialIcon, {
  type SocialIconName,
} from "@/components/shared/SocialIcon.astro";
import { SITE_CONFIG, NAV_ROUTES } from "@/constants/site";
import NewsletterForm from "./NewsletterForm.astro";

/** Port of components/layout/footer/index.tsx. */

const FOOTER_LINKS = {
  company: [
    { label: "About Us", href: NAV_ROUTES.about },
    { label: "Careers", href: NAV_ROUTES.careers },
    { label: "Contact", href: NAV_ROUTES.contact },
  ],
  resources: [
    { label: "Blog", href: NAV_ROUTES.blog },
    { label: "Case Studies", href: NAV_ROUTES.caseStudies },
    { label: "Services", href: NAV_ROUTES.services },
    { label: "Industries", href: NAV_ROUTES.industries },
  ],
  contact: [
    { label: "Contact Us", href: NAV_ROUTES.contact },
    { label: "Client Portal", href: NAV_ROUTES.contact },
    { label: "Careers", href: NAV_ROUTES.careers },
  ],
};

const SOCIAL: Array<{ label: string; href: string; icon: SocialIconName }> = [
  { label: "LinkedIn", href: SITE_CONFIG.social.linkedin, icon: "linkedin" },
  { label: "GitHub", href: SITE_CONFIG.social.github, icon: "github" },
  { label: "YouTube", href: SITE_CONFIG.social.youtube, icon: "youtube" },
  { label: "X", href: SITE_CONFIG.social.x, icon: "x" },
];

const LEGAL = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms and Conditions", href: "/terms" },
  { label: "Cookie Settings", href: "/cookies" },
];

const COLUMNS = [
  { title: "Company", links: FOOTER_LINKS.company },
  { title: "Resources", links: FOOTER_LINKS.resources },
  { title: "Contact", links: FOOTER_LINKS.contact },
];

const year = new Date().getFullYear();
---

<footer class="gradient-dark text-white">
  <Container class="py-12 sm:py-16 lg:py-28">
    {/* Row 1: Brand + socials */}
    <div
      class="flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center sm:gap-6"
    >
      <a
        href={NAV_ROUTES.home}
        class="text-xl font-bold tracking-wide sm:text-2xl lg:text-3xl"
      >
        COGNIVAC
      </a>
      <ul class="flex items-center gap-2.5 sm:gap-3">
        {
          SOCIAL.map(({ label, href, icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/10 transition-colors hover:bg-white/20 sm:h-10 sm:w-10"
              >
                <SocialIcon name={icon} class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <Separator class="my-7 bg-white/10 sm:my-10" />

    {/* Row 2: Nav columns + newsletter */}
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:gap-10 lg:grid-cols-4">
      {
        COLUMNS.map((column) => (
          <div>
            <p class="mb-3 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-white/70 sm:mb-5 sm:text-[0.875rem] sm:tracking-[0.2em]">
              {column.title}
            </p>
            <ul class="space-y-2.5 sm:space-y-4">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-white/80 transition-colors hover:text-white sm:text-base"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="col-span-2 lg:col-span-1">
        <NewsletterForm />
      </div>
    </div>

    <Separator class="my-7 bg-white/10 sm:my-10" />

    {/* Row 3: Legal */}
    <div
      class="flex flex-col justify-between gap-4 sm:gap-6 lg:flex-row lg:items-end"
    >
      <ul class="flex flex-wrap gap-x-4 gap-y-2 sm:gap-x-6">
        {
          LEGAL.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-xs text-white/60 transition-colors hover:text-white sm:text-sm"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p
        class="max-w-md text-xs leading-relaxed text-white/50 sm:text-sm lg:text-right"
      >
        © {year} Cognivac, Inc. All rights reserved. All proprietary information
        shall remain the sole and exclusive property of Cognivac, Inc.
      </p>
    </div>
  </Container>
</footer>
