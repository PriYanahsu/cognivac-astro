---
import { ArrowUp, ArrowUpRight, Mail, MapPin, Phone } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import CognivacLogo from "@/components/shared/CognivacLogo.astro";
import SocialIcon, {
  type SocialIconName,
} from "@/components/shared/SocialIcon.astro";
import { SITE_CONFIG, NAV_ROUTES } from "@/constants/site";
import {
  FOOTER_COMPANY_LINKS,
  FOOTER_SERVICE_LINKS,
  FOOTER_RESOURCE_LINKS,
  FOOTER_LEGAL_LINKS,
} from "./constants";
import NewsletterForm from "./NewsletterForm.astro";

const SOCIAL: Array<{
  label: string;
  href: string;
  handle: string;
  icon: SocialIconName;
}> = [
  {
    label: "LinkedIn",
    href: SITE_CONFIG.social.linkedin.href,
    handle: SITE_CONFIG.social.linkedin.handle,
    icon: "linkedin",
  },
  {
    label: "GitHub",
    href: SITE_CONFIG.social.github.href,
    handle: SITE_CONFIG.social.github.handle,
    icon: "github",
  },
  {
    label: "YouTube",
    href: SITE_CONFIG.social.youtube.href,
    handle: SITE_CONFIG.social.youtube.handle,
    icon: "youtube",
  },
  {
    label: "X",
    href: SITE_CONFIG.social.x.href,
    handle: SITE_CONFIG.social.x.handle,
    icon: "x",
  },
];

const LINK_COLUMNS = [
  { title: "Company", links: FOOTER_COMPANY_LINKS },
  { title: "Services", links: FOOTER_SERVICE_LINKS },
  { title: "Resources", links: FOOTER_RESOURCE_LINKS },
] as const;

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink-deep text-white">
  <div
    aria-hidden="true"
    class="dot-grid pointer-events-none absolute inset-0 opacity-70"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-80 bg-linear-to-b from-white/6 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-accent/55 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-32 -top-24 h-100 w-100 rounded-full bg-[radial-gradient(circle,rgba(30,79,216,0.20),transparent_66%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-24 bottom-0 h-90 w-90 rounded-full bg-[radial-gradient(circle,rgba(14,165,233,0.10),transparent_68%)]"
  >
  </div>

  <Container class="relative py-12 sm:py-16 lg:py-20">
    {/* Top band — brand, link columns, newsletter */}
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,2fr)_minmax(0,1fr)] lg:gap-x-12 xl:gap-x-16"
    >
      {/* Brand + contact */}
      <div class="max-w-sm">
        <a
          href={NAV_ROUTES.home}
          class="inline-flex flex-col gap-1"
          aria-label={`${SITE_CONFIG.name} home`}
        >
          <CognivacLogo variant="light" class="h-9 w-auto sm:h-10" />
          <span class="text-[13px] font-medium tracking-wide text-white/55">
            {SITE_CONFIG.tagline}
          </span>
        </a>

        <p
          class="mt-4 text-[14.5px] leading-[1.55] text-white/78 sm:mt-5 sm:text-body-md sm:leading-relaxed"
        >
          {SITE_CONFIG.description}
        </p>

        <ul class="mt-5 space-y-2.5 sm:mt-6">
          <li>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="group inline-flex items-center gap-2.5 text-body-md text-white/85 transition-colors hover:text-white"
            >
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/6 transition-colors group-hover:border-white/20 group-hover:bg-white/10"
              >
                <Mail class="h-3.5 w-3.5" />
              </span>
              {SITE_CONFIG.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${SITE_CONFIG.phone.replace(/\D/g, "")}`}
              class="group inline-flex items-center gap-2.5 text-body-md text-white/85 transition-colors hover:text-white"
            >
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/6 transition-colors group-hover:border-white/20 group-hover:bg-white/10"
              >
                <Phone class="h-3.5 w-3.5" />
              </span>
              {SITE_CONFIG.phone}
            </a>
          </li>
          <li class="inline-flex items-center gap-2.5 text-body-md text-white/75">
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/6"
            >
              <MapPin class="h-3.5 w-3.5" />
            </span>
            {SITE_CONFIG.address}
          </li>
        </ul>
      </div>

      {/* Link columns */}
      <div
        class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-10 lg:col-start-2 lg:row-start-1"
      >
        {
          LINK_COLUMNS.map((column) => (
            <div>
              <p class="mb-3.5 text-eyebrow uppercase tracking-[0.12em] text-white/70">
                {column.title}
              </p>
              <ul class="space-y-0.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group inline-flex min-h-9 items-center gap-1 text-body-md text-white/82 transition-colors hover:text-white sm:min-h-0 sm:py-1"
                    >
                      {link.label}
                      <ArrowUpRight class="h-3 w-3 opacity-0 transition-[opacity,transform] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-60" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      {/* Newsletter */}
      <div
        class="relative overflow-hidden rounded-lg border border-white/12 bg-white/5 p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] backdrop-blur-sm sm:p-6 lg:col-start-3 lg:row-start-1"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-8 top-0 h-px bg-linear-to-r from-transparent via-accent/45 to-transparent"
        >
        </span>
        <NewsletterForm />
      </div>
    </div>

    {/* Social + CTA strip */}
    <div
      class="mt-10 grid gap-8 border-t border-white/10 pt-10 sm:mt-12 sm:pt-12 lg:mt-14 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12"
    >
      <div>
        <p class="text-eyebrow uppercase tracking-[0.12em] text-white/70">
          Follow {SITE_CONFIG.name}
        </p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:max-w-xl">
          {
            SOCIAL.map(({ label, href, handle, icon }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-3 rounded-lg border border-white/10 bg-white/4 px-3 py-2.5 transition-[background-color,border-color,transform] duration-300 hover:border-white/20 hover:bg-white/8 hover:scale-[1.01]"
                >
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/6 text-white/85 transition-colors group-hover:border-white/22 group-hover:bg-white/10 group-hover:text-white">
                    <SocialIcon name={icon} class="h-4 w-4" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-body-sm font-medium text-white/90">
                      {label}
                    </span>
                    <span class="block truncate text-body-sm text-white/55">
                      {handle}
                    </span>
                  </span>
                  <ArrowUpRight class="ml-auto h-3.5 w-3.5 shrink-0 text-white/35 transition-[opacity,transform] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white/70" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="rounded-lg border border-white/12 bg-white/5 p-5 sm:p-6 lg:min-w-[18rem]"
      >
        <p class="text-eyebrow uppercase tracking-[0.12em] text-white/70">
          Start a project
        </p>
        <p class="mt-2 max-w-[28ch] text-body-md text-white/78">
          Tell us what you&apos;re building — we&apos;ll reply with a clear next
          step.
        </p>
        <a
          href={NAV_ROUTES.contact}
          class="group mt-4 inline-flex h-10 items-center gap-1.5 overflow-hidden rounded-full bg-accent px-4 text-button-md font-semibold text-white transition-[background-color,box-shadow,transform] duration-300 hover:bg-indigo hover:shadow-glow active:scale-[0.98]"
        >
          Contact {SITE_CONFIG.name}
          <ArrowUpRight class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
      </div>
    </div>

    {/* Bottom bar */}
    <div
      class="mt-10 flex flex-col gap-5 border-t border-white/10 pt-6 sm:mt-12 sm:flex-row sm:items-center sm:justify-between sm:pt-8"
    >
      <div class="space-y-1">
        <p class="text-body-sm text-white/75">
          © {year}
          {SITE_CONFIG.legalName}. All rights reserved.
        </p>
        <p class="text-body-sm text-white/50">
          {SITE_CONFIG.name} — {SITE_CONFIG.tagline}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <ul class="flex flex-wrap items-center gap-x-5">
          {
            FOOTER_LEGAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-9 items-center text-body-sm text-white/70 transition-colors hover:text-white/90 sm:min-h-0"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="#main-content"
          class="group inline-flex items-center gap-1.5 rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-body-sm text-white/80 transition-colors duration-300 hover:border-white/25 hover:bg-white/10 hover:text-white"
        >
          Back to top
          <ArrowUp
            class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </Container>
</footer>
