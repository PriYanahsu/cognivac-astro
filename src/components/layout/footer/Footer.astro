---
import { ArrowUp, ArrowUpRight, Mail, MapPin } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import CognivacLogo from "@/components/shared/CognivacLogo.astro";
import SocialIcon, {
  type SocialIconName,
} from "@/components/shared/SocialIcon.astro";
import { SITE_CONFIG, NAV_ROUTES } from "@/constants/site";
import NewsletterForm from "./NewsletterForm.astro";

/** Port of components/layout/footer/index.tsx. */

const FOOTER_LINKS = {
  company: [
    { label: "About Us", href: NAV_ROUTES.about },
    { label: "Team", href: NAV_ROUTES.team },
    { label: "Careers", href: NAV_ROUTES.careers },
    { label: "Contact", href: NAV_ROUTES.contact },
  ],
  solutions: [
    { label: "Services", href: NAV_ROUTES.services },
    { label: "Industries", href: NAV_ROUTES.industries },
    { label: "Case Studies", href: NAV_ROUTES.caseStudies },
    { label: "Blog", href: NAV_ROUTES.blog },
  ],
};

const SOCIAL: Array<{ label: string; href: string; icon: SocialIconName }> = [
  { label: "LinkedIn", href: SITE_CONFIG.social.linkedin, icon: "linkedin" },
  { label: "GitHub", href: SITE_CONFIG.social.github, icon: "github" },
  { label: "YouTube", href: SITE_CONFIG.social.youtube, icon: "youtube" },
  { label: "X", href: SITE_CONFIG.social.x, icon: "x" },
];

const LEGAL = [
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
  { label: "Cookies", href: "/cookies" },
];

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink-deep text-white">
  <div
    aria-hidden="true"
    class="dot-grid pointer-events-none absolute inset-0 opacity-70"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-80 bg-linear-to-b from-white/6 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-accent/55 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-32 -top-24 h-100 w-100 rounded-full bg-[radial-gradient(circle,rgba(30,79,216,0.20),transparent_66%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-24 bottom-0 h-90 w-90 rounded-full bg-[radial-gradient(circle,rgba(14,165,233,0.10),transparent_68%)]"
  >
  </div>

      <Container class="relative py-11 sm:py-16 lg:py-20">
        <div class="grid gap-8 sm:gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div class="max-w-md">
            <a
              href={NAV_ROUTES.home}
              class="inline-flex items-center"
              aria-label={`${SITE_CONFIG.name} home`}
            >
              <CognivacLogo variant="light" class="h-9 w-auto sm:h-11" />
            </a>
            <p class="mt-4 text-[14.5px] leading-[1.55] text-white/80 sm:mt-5 sm:text-body-lg sm:leading-relaxed">
          {SITE_CONFIG.description}
        </p>

            <ul class="mt-5 space-y-2.5 sm:mt-6">
          <li>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="inline-flex items-center gap-2.5 text-body-md text-white/85 transition-colors hover:text-white"
            >
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full border border-white/12 bg-white/6"
              >
                <Mail class="h-3.5 w-3.5" />
              </span>
              {SITE_CONFIG.email}
            </a>
          </li>
          <li class="inline-flex items-center gap-2.5 text-body-md text-white/75">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-full border border-white/12 bg-white/6"
            >
              <MapPin class="h-3.5 w-3.5" />
            </span>
            {SITE_CONFIG.address}
          </li>
        </ul>

            <ul class="mt-5 flex items-center gap-2 sm:mt-7">
          {
            SOCIAL.map(({ label, href, icon }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={label}
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-white/12 bg-white/6 text-white/80 transition-[background-color,border-color,color,transform] duration-300 hover:border-white/25 hover:bg-white/10 hover:text-white hover:scale-105"
                >
                  <SocialIcon name={icon} class="h-4 w-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="relative overflow-hidden rounded-lg border border-white/12 bg-white/5 p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] backdrop-blur-sm sm:p-6"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-8 top-0 h-px bg-linear-to-r from-transparent via-accent/45 to-transparent"
        >
        </span>
        <NewsletterForm />
      </div>
    </div>

    <div
      class="mt-9 grid grid-cols-2 gap-6 border-t border-white/10 pt-8 sm:mt-14 sm:grid-cols-3 sm:gap-10 sm:pt-12 lg:mt-16"
    >
      {
        (
          [
            { title: "Company", links: FOOTER_LINKS.company },
            { title: "Solutions", links: FOOTER_LINKS.solutions },
          ] as const
        ).map((column) => (
          <div>
            <p class="mb-4 text-eyebrow uppercase tracking-[0.12em] text-white/70">
              {column.title}
            </p>
            <ul class="space-y-0.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="group inline-flex min-h-9 items-center gap-1 text-body-md text-white/85 transition-colors hover:text-white sm:min-h-0 sm:py-1"
                  >
                    {link.label}
                    <ArrowUpRight class="h-3 w-3 opacity-0 transition-[opacity,transform] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-60" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="col-span-2 sm:col-span-1">
        <p class="mb-4 text-eyebrow uppercase tracking-[0.12em] text-white/70">
          Start a project
        </p>
        <p class="mb-4 max-w-[28ch] text-body-md text-white/78">
          Tell us what you&apos;re building — we&apos;ll reply with a clear next
          step.
        </p>
        <a
          href={NAV_ROUTES.contact}
          class="group inline-flex h-10 items-center gap-1.5 overflow-hidden rounded-full bg-accent px-4 text-button-md font-semibold text-white transition-[background-color,box-shadow,transform] duration-300 hover:bg-indigo hover:shadow-glow active:scale-[0.98]"
        >
          Contact us
          <ArrowUpRight class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
      </div>
    </div>

    <div
      class="mt-9 flex flex-col gap-4 border-t border-white/10 pt-6 sm:mt-14 sm:flex-row sm:items-center sm:justify-between sm:pt-8"
    >
      <p class="text-body-sm text-white/70">
        © {year} {SITE_CONFIG.name}. All rights reserved.
      </p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <ul class="flex flex-wrap items-center gap-x-5">
          {
            LEGAL.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-9 items-center text-body-sm text-white/70 transition-colors hover:text-white/90 sm:min-h-0"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="#main-content"
          class="group inline-flex items-center gap-1.5 rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-body-sm text-white/80 transition-colors duration-300 hover:border-white/25 hover:bg-white/10 hover:text-white"
        >
          Back to top
          <ArrowUp
            class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </Container>
</footer>
