---
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema, createPageMetadata } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";
import { SUPPORT_PAGE, SUPPORT_OFFERS, SUPPORT_SLAS } from "@/features/support/constants";

const metadata = createPageMetadata({
  title: "Support",
  description: SUPPORT_PAGE.description,
  path: NAV_ROUTES.support,
});
---

<Layout metadata={metadata}>
  <JsonLd
    data={breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Support", path: NAV_ROUTES.support },
    ])}
  />

  <PageHero
    label={SUPPORT_PAGE.label}
    title={SUPPORT_PAGE.title}
    description={SUPPORT_PAGE.description}
    breadcrumbs={[{ label: "Support" }]}
    primaryCta={{ label: "Talk through a retainer", href: NAV_ROUTES.contact }}
    secondaryCta={{ label: "How we work", href: NAV_ROUTES.services }}
    highlights={[...SUPPORT_PAGE.highlights]}
  />

  <section class="bg-background section-padding">
    <Container>
      <div class="card-grid md:grid-cols-2">
        {
          SUPPORT_OFFERS.map((offer, i) => (
            <FadeIn delay={0.06 * (i + 1)} class="h-full">
              <article class="flex h-full flex-col rounded-md border border-border bg-card p-5 sm:p-8">
                <h2 class="text-card-title text-foreground">{offer.title}</h2>
                <p class="mt-3 copy-md">{offer.body}</p>
              </article>
            </FadeIn>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="relative overflow-hidden bg-[#0f0f12] section-padding text-white">
    <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
    <Container class="relative z-10">
      <SectionIntro
        tone="dark"
        label="SLAs"
        title="Ack windows, not theatre"
        description="Written into the retainer. Severity is defined with you in week one so nobody argues the clock during an incident."
      />
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          SUPPORT_SLAS.map((row, i) => (
            <FadeIn delay={0.08 * (i + 1)} class="h-full">
              <div class="h-full rounded-md border border-white/12 bg-white/[0.04] p-6">
                <p class="text-[12px] font-bold tracking-[0.16em] text-teal">{row.severity}</p>
                <p class="mt-3 text-[22px] font-bold text-white">{row.window}</p>
                <p class="mt-3 text-[14.5px] leading-[1.55] text-white/80">{row.meaning}</p>
              </div>
            </FadeIn>
          ))
        }
      </div>
    </Container>
  </section>

  <CtaSection />
</Layout>
