---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { createPageMetadata } from "@/lib/seo";
import { SITE_CONFIG, NAV_ROUTES } from "@/constants/site";

const metadata = createPageMetadata({
  title: "Cookie Settings",
  description: "What Cognivac stores in your browser, why, and how to change it.",
  path: NAV_ROUTES.cookies,
});

const COOKIE_TYPES = [
  {
    id: "essential",
    title: "Essential",
    description:
      "Required for the site to function — routing, security, and form submission. These cannot be switched off.",
    locked: true,
  },
  {
    id: "analytics",
    title: "Analytics",
    description:
      "First-party aggregate data on which pages are read. Used to improve the site. Stored as a preference in this browser, not as a third-party cookie.",
    locked: false,
  },
  {
    id: "preferences",
    title: "Preferences",
    description:
      "Remembers choices such as dismissed notices so you are not asked twice.",
    locked: false,
  },
] as const;
---

<Layout metadata={metadata}>
  <PageHero
    label="Legal"
    title="Cookie Settings"
    description="What we store in your browser, why, and how to change it."
    breadcrumbs={[{ label: "Cookie Settings" }]}
  />

  <section class="bg-background section-padding">
    <Container>
      <div class="mx-auto max-w-3xl">
        <div class="grid gap-5" data-cookie-form>
          {
            COOKIE_TYPES.map((type, i) => (
              <FadeIn delay={0.07 * (i + 1)}>
                <div class="flex items-start justify-between gap-6 rounded-md border border-border bg-card p-6 sm:p-8">
                  <div class="min-w-0">
                    <h2 class="text-card-title text-foreground">{type.title}</h2>
                    <p class="mt-3 text-[15.5px] leading-[1.65] text-muted sm:text-[16.5px]">
                      {type.description}
                    </p>
                  </div>
                  {type.locked ? (
                    <span class="shrink-0 rounded-full border border-border px-3 py-1 text-[12px] font-semibold text-muted">
                      Always on
                    </span>
                  ) : (
                    <button
                      type="button"
                      data-cookie-toggle={type.id}
                      aria-pressed="true"
                      class="relative h-7 w-12 shrink-0 rounded-full bg-accent transition-colors"
                    >
                      <span
                        data-cookie-knob
                        class="absolute top-0.5 left-6 h-6 w-6 rounded-full bg-white shadow-sm transition-[left]"
                      />
                      <span class="sr-only">Toggle {type.title}</span>
                    </button>
                  )}
                </div>
              </FadeIn>
            ))
          }
        </div>

        <FadeIn delay={0.28}>
          <p data-cookie-status class="mt-8 text-[15px] leading-[1.7] text-muted"></p>
          <p class="mt-4 text-[15px] leading-[1.7] text-muted">
            Questions:{" "}
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="font-semibold text-foreground underline underline-offset-4 transition-colors hover:text-accent"
            >
              {SITE_CONFIG.email}
            </a>
          </p>
        </FadeIn>
      </div>
    </Container>
  </section>

  <CtaSection />
</Layout>

<script>
  const KEY = "cognivac-consent";

  type Consent = { analytics: boolean; preferences: boolean };

  const defaults: Consent = { analytics: true, preferences: true };

  const read = (): Consent => {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return { ...defaults };
      return { ...defaults, ...JSON.parse(raw) };
    } catch {
      return { ...defaults };
    }
  };

  const write = (value: Consent) => {
    localStorage.setItem(KEY, JSON.stringify(value));
    document.cookie = `cognivac-consent=${encodeURIComponent(JSON.stringify(value))}; path=/; max-age=31536000; SameSite=Lax`;
  };

  const paint = (consent: Consent) => {
    document.querySelectorAll<HTMLButtonElement>("[data-cookie-toggle]").forEach((button) => {
      const id = button.dataset.cookieToggle as keyof Consent;
      const on = consent[id];
      button.setAttribute("aria-pressed", on ? "true" : "false");
      button.classList.toggle("bg-accent", on);
      button.classList.toggle("bg-border", !on);
      const knob = button.querySelector<HTMLElement>("[data-cookie-knob]");
      if (knob) {
        knob.classList.toggle("left-6", on);
        knob.classList.toggle("left-0.5", !on);
      }
    });
    const status = document.querySelector("[data-cookie-status]");
    if (status) status.textContent = "Saved in this browser.";
  };

  const consent = read();
  write(consent);
  paint(consent);

  document.querySelectorAll<HTMLButtonElement>("[data-cookie-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.cookieToggle as keyof Consent;
      const next = read();
      next[id] = !next[id];
      write(next);
      paint(next);
    });
  });
</script>
