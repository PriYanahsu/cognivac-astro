---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/shared/Container.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import { createPageMetadata } from "@/lib/seo";

/** Port of app/not-found.tsx. */
const metadata = createPageMetadata({
  title: "Page not found",
  description: "The page you're looking for doesn't exist or has moved.",
  path: "/404",
  noIndex: true,
});
---

<Layout metadata={metadata}>
  <section class="section-padding">
    <Container class="text-center">
      <p class="text-label text-accent">404</p>
      <h1 class="text-section mt-4 text-primary">Page not found</h1>
      <p class="mx-auto mt-4 max-w-md text-body text-muted">
        The page you&apos;re looking for doesn&apos;t exist or has moved.
      </p>
      <div class="mt-8">
        <GradientButton href="/">Back to home</GradientButton>
      </div>
      <p class="mt-6 text-sm text-muted">
        Or visit our{" "}
        <a
          href="/contact"
          class="font-semibold text-accent hover:underline">contact page</a
        >.
      </p>
    </Container>
  </section>
</Layout>
