---
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema, createPageMetadata } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";
import { RESOURCES, RESOURCES_PAGE } from "@/features/resources/constants";

const metadata = createPageMetadata({
  title: "Resources",
  description: RESOURCES_PAGE.description,
  path: NAV_ROUTES.resources,
});
---

<Layout metadata={metadata}>
  <JsonLd
    data={breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Resources", path: NAV_ROUTES.resources },
    ])}
  />

  <PageHero
    label={RESOURCES_PAGE.label}
    title={RESOURCES_PAGE.title}
    description={RESOURCES_PAGE.description}
    breadcrumbs={[{ label: "Resources" }]}
    primaryCta={{ label: "Talk to an engineer", href: NAV_ROUTES.contact }}
    secondaryCta={{ label: "Insights", href: NAV_ROUTES.blog }}
  />

  <section class="bg-background section-padding">
    <Container>
      <div class="card-grid md:grid-cols-2">
        {
          RESOURCES.map((item, i) => (
            <FadeIn delay={0.06 * (i + 1)} class="h-full">
              <a
                href={item.href}
                class="flex h-full flex-col rounded-md border border-border bg-card p-5 transition-colors hover:border-accent/40 sm:p-8"
              >
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-accent">
                  {item.gated ? "Gated brief" : item.category}
                </p>
                <h2 class="text-card-title mt-3 text-foreground">{item.title}</h2>
                <p class="mt-3 copy-md">{item.excerpt}</p>
                <span class="mt-auto pt-5 text-[13.5px] font-semibold text-foreground">
                  {item.gated ? "Request the brief" : "Read"}
                </span>
              </a>
            </FadeIn>
          ))
        }
      </div>
    </Container>
  </section>

  <CtaSection />
</Layout>
