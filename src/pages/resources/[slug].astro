---
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema, createPageMetadata } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import ContactForm from "@/features/contact/components/ContactForm.astro";
import { NAV_ROUTES } from "@/constants/site";
import {
  RESOURCES,
  RESOURCE_BODIES,
} from "@/features/resources/constants";

export function getStaticPaths() {
  return RESOURCES.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const item = RESOURCES.find((entry) => entry.slug === slug)!;
const body = RESOURCE_BODIES[slug]!;

const metadata = createPageMetadata({
  title: item.title,
  description: item.excerpt,
  path: item.href,
});
---

<Layout metadata={metadata}>
  <JsonLd
    data={breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Resources", path: NAV_ROUTES.resources },
      { name: item.title, path: item.href },
    ])}
  />

  <PageHero
    label={item.gated ? "Lead magnet" : "Resource"}
    title={body.title}
    description={body.lede}
    breadcrumbs={[
      { label: "Resources", href: NAV_ROUTES.resources },
      { label: item.title },
    ]}
  />

  <section class="bg-background section-padding">
    <Container>
      <div class="grid gap-10 lg:grid-cols-12">
        <FadeIn class="space-y-10 lg:col-span-7">
          {
            body.sections.map((section) => (
              <section>
                <h2 class="text-[20px] font-bold tracking-[-0.02em] text-foreground sm:text-[23px]">
                  {section.heading}
                </h2>
                <ul class="mt-4 space-y-3">
                  {section.body.map((line) => (
                    <li class="flex gap-2.5 text-[15.5px] leading-[1.65] text-muted">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                      {line}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </FadeIn>

        {
          item.gated && (
            <div class="lg:col-span-5">
              <p class="mb-4 text-[13px] font-semibold uppercase tracking-[0.14em] text-accent">
                Send a note to get the longer pack
              </p>
              <ContactForm resource={item.slug} submitLabel="Send and continue" />
            </div>
          )
        }
      </div>
    </Container>
  </section>

  <CtaSection />
</Layout>
