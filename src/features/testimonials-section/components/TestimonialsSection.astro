---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { TESTIMONIALS } from "@/features/home/constants/content";
import { TESTIMONIALS_CONTENT } from "../constants";

/**
 * Port of features/testimonials-section/components/testimonials-section.tsx.
 * Framer stagger (0.1s / 0.05s lead-in, y:28, 0.65s) is data-reveal-stagger.
 * Hover lift lives on the figure, not the reveal wrapper — otherwise the
 * `[data-reveal-item]` transform wins on specificity and the card never lifts.
 */
---

<section
  class="relative overflow-hidden border-y border-border bg-card section-padding"
  aria-labelledby="testimonials-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 left-[-10%] h-120 w-120 rounded-full bg-[radial-gradient(circle,rgba(30,79,216,0.07),transparent_68%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 right-[-8%] h-130 w-130 rounded-full bg-[radial-gradient(circle,rgba(30,79,216,0.05),transparent_68%)]"
  >
  </div>

  <Container class="relative z-10">
    <FadeIn>
      <div class="mx-auto max-w-3xl text-center">
        <SectionLabel class="mb-0">
          {TESTIMONIALS_CONTENT.label}
        </SectionLabel>
        <h2
          id="testimonials-title"
          class="text-section stack-sm text-foreground"
        >
          {TESTIMONIALS_CONTENT.title}
        </h2>
        <p class="mx-auto stack-md lede max-w-[52ch]">
          {TESTIMONIALS_CONTENT.description}
        </p>
      </div>
    </FadeIn>

    <div
      data-reveal-stagger
      data-reveal-margin="-80px"
      data-stagger="0.1"
      data-delay-children="0.05"
      style="--reveal-item-y:28px;--reveal-item-duration:0.65s"
      class="card-grid md:grid-cols-3"
    >
      {
        TESTIMONIALS.map((testimonial) => (
          <div data-reveal-item class="h-full">
            <figure class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-border bg-background p-7 transition duration-500 ease-out hover:-translate-y-1 hover:border-accent/30 hover:shadow-[0_24px_60px_rgba(34,32,28,0.09)] sm:p-8">
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-linear-to-r from-accent to-accent/0 transition-transform duration-700 ease-out group-hover:scale-x-100"
              />

              <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-6 right-4 select-none font-serif text-[110px] leading-none text-accent/10 transition-colors duration-500 group-hover:text-accent/18"
              >
                &ldquo;
              </span>

              <blockquote class="relative flex-1 text-[17px] font-medium leading-[1.7] tracking-[-0.01em] text-pretty text-foreground sm:text-[18.5px]">
                {testimonial.quote}
              </blockquote>

              <figcaption class="mt-7 border-t border-border pt-5">
                <p class="text-[15px] font-bold leading-tight tracking-[-0.01em] text-foreground">
                  {testimonial.name}
                </p>
                <p class="mt-1.5 text-[13.5px] leading-snug text-muted">
                  {testimonial.role}
                  <span class="mx-1.5 text-border">·</span>
                  <span class="font-semibold text-body">{testimonial.company}</span>
                </p>
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </Container>
</section>
