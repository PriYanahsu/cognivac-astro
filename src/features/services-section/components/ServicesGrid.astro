---
import {
  Activity,
  Bot,
  Database,
  Gauge,
  LifeBuoy,
  Puzzle,
  Rocket,
  Users,
  Workflow,
  ArrowRight,
} from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import { NAV_ROUTES } from "@/constants/site";
import {
  SERVICE_OFFERS,
  SERVICES_HEADER,
} from "@/features/services-section/constants";

/**
 * Services, as a plain card grid.
 *
 * It has been two other things. First a rotating 3D wheel — nine cards on a
 * ring, drag to spin, a tab strip and arrows to drive it, ~400 lines of rAF
 * paint code — where only the crown card was ever fully legible, so seeing all
 * nine meant nine deliberate interactions. Then a pinned grid: the section ran
 * a screen tall plus the row overflow, the header stuck while a clipped track
 * was translated under it by however far you had scrolled.
 *
 * Both are gone and nothing replaced them. The section is a heading and nine
 * cards in normal flow; the page scrolls it the way it scrolls everything
 * else. The pin cost a scroll position that had to be measured, kept in sync
 * against a webfont reflow and a resize, and rebuilt whenever the browser
 * disagreed about what it had painted — all so the reader could scroll past
 * nine cards, which is what they do here for free.
 *
 * The one thing scroll still does is bring the cards in. Each card is its own
 * reveal target, so a row arrives as you reach it and the delays sweep it left
 * to right — first offer to last across the grid. That is the site's shared
 * `[data-reveal]` primitive (globals.css, driven by one IntersectionObserver in
 * Layout.astro), not anything this file owns, and it resolves to a resting
 * state rather than holding a frame. There is still no script here.
 *
 * The only other state is `:hover` on a card, which fills its pill.
 */

const ICONS = {
  Puzzle,
  Workflow,
  Rocket,
  Bot,
  Gauge,
  LifeBuoy,
  Activity,
  Database,
  Users,
} as const;

const CARD_COUNT = SERVICE_OFFERS.length;
---

<section class="relative bg-[#0f0f12] py-14 text-white sm:py-20 lg:py-24">
  <Container>
    <SectionIntro
      label={SERVICES_HEADER.label}
      title={SERVICES_HEADER.title}
      description={SERVICES_HEADER.description}
      tone="dark"
      align="center"
    />

    {/*
      Each card is its own reveal target rather than the grid being one. A
      single target would fire on the first row and run all nine delays while
      six of them were still below the fold, so by the time you scrolled to
      them they had already played. Per-card, a row arrives when you reach it,
      and the delays below only sweep it left to right — which across the whole
      grid reads as first to last, in the order the offers are written.
    */}
    <div
      class="services-grid mt-10 grid gap-4 sm:mt-14 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6"
    >
      {
        SERVICE_OFFERS.map((service) => {
          const Icon = ICONS[service.icon as keyof typeof ICONS] ?? Bot;
          return (
            <a
              data-reveal
              data-reveal-margin="-60px"
              href={service.href}
              class="service-card"
            >
              <div
                class="service-card__inner"
                style={`--card-tint:${service.color};background:${service.color}`}
              >
                <div class="service-card__media">
                  <img
                    src={service.image}
                    alt=""
                    sizes="(min-width: 1024px) 440px, (min-width: 640px) 50vw, 100vw"
                    class="service-card__img"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                  {/*
                    The mark sits in the image, on the same left axis as the
                    title and the figures below it. Straddling the seam between
                    image and copy read as a notch in the card rather than as a
                    badge, and beside a two-line title it aligned to nothing.
                  */}
                  <span class="service-card__mark">
                    <Icon class="h-[18px] w-[18px]" stroke-width={1.75} />
                  </span>
                </div>

                <div class="service-card__body">
                  <h3 class="service-card__title">{service.title}</h3>
                  <p class="service-card__desc">{service.description}</p>

                  {/*
                    `mt-auto` alone let the rule ride up against the last line of
                    a long description. The margin on the copy above sets the
                    floor; `mt-auto` only ever adds to it.
                  */}
                  <div class="service-card__stats">
                    {service.stats.map((stat) => (
                      <div class="min-w-0">
                        <b class="service-card__stat">{stat.value}</b>
                        <span class="service-card__stat-label">{stat.label}</span>
                      </div>
                    ))}
                  </div>

                  <span class="service-card__cta">
                    View service
                    <ArrowRight class="service-card__arrow h-3.5 w-3.5" />
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div
      class="mt-12 flex flex-col items-center gap-3 sm:mt-16 sm:flex-row sm:justify-center sm:gap-5"
    >
      <GradientButton
        href={NAV_ROUTES.services}
        size="lg"
        surface="dark"
        class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto"
      >
        See all services
      </GradientButton>
      <p class="text-center text-[13px] leading-[1.4] text-white/70 sm:text-left">
        {CARD_COUNT} capabilities, with what each one ships.
      </p>
    </div>
  </Container>
</section>

<style>
  /**
   * The card. The anchor is the reveal target (globals.css owns that
   * transition, driven off the variables below); `__inner` carries the tint and
   * the radius clip. Keeping them separate is what lets the reveal own the
   * anchor's `transform` outright — one element doing both is how the old
   * version had a hover and an entry overwriting each other.
   */
  .service-card {
    display: block;
    border-radius: var(--rounded-xl);
    /* Short and shallow. It is a set being laid out, not each card making an
       entrance — 22px and half a second is enough to read as arriving without
       making anyone wait to read the words. */
    --reveal-y: 22px;
    --reveal-duration: 0.55s;
    --reveal-delay: 0s;
  }

  /**
   * THE ORDER, and why it is written per breakpoint.
   *
   * The delay is a card's position in its own row, so a row sweeps left to
   * right and the grid overall runs first offer to last — which is also the
   * engagement arc the constants file orders them by (build, fix, run, staff).
   *
   * That means the cycle has to match the column count, and the column count is
   * a media query, so this is too. Keying it off `i % 3` in the template
   * instead was wrong at every width but the widest: at two columns the
   * three-step cycle drifts against the rows, so the sweep runs backwards on
   * every other one.
   *
   * One column needs nothing — each card is its own row and arrives alone.
   */
  @media (min-width: 640px) {
    .services-grid .service-card:nth-child(2n + 1) {
      --reveal-delay: 0s;
    }
    .services-grid .service-card:nth-child(2n + 2) {
      --reveal-delay: 0.08s;
    }
  }

  /* Restated rather than added to: at three columns every card's position in
     its row changes, so all three cases are set outright and the two-column
     rule above is fully overridden. */
  @media (min-width: 1024px) {
    .services-grid .service-card:nth-child(3n + 1) {
      --reveal-delay: 0s;
    }
    .services-grid .service-card:nth-child(3n + 2) {
      --reveal-delay: 0.08s;
    }
    .services-grid .service-card:nth-child(3n + 3) {
      --reveal-delay: 0.16s;
    }
  }

  .service-card__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--rounded-xl);
    color: #0b0b0f;
    text-align: left;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
  }

  /*
   * HOVER IS THE BUTTON, and nothing else on the card.
   *
   * It used to be four things at once: the card lifted and took a deep shadow,
   * its photograph zoomed, its wash cleared, and the other eight cards dropped
   * to 45% and shrank. Moving the pointer across a nine-card grid set most of
   * the section in motion, and since you cross the grid on the way to reading
   * it, that fired while scrolling. Filling the pill is the whole affordance —
   * it is the thing being clicked, so it is the thing that answers.
   */

  .service-card:focus-visible {
    outline: 2px solid var(--accent-on-dark);
    outline-offset: 4px;
  }

  /**
   * 21:9, not 16:10. At 16:10 the photograph took 277px of a 553px card —
   * dead half — and pushed the title, the copy and the figures into a strip
   * along the bottom. A letterbox gives the image enough to read as an image
   * and hands the rest of the card back to the words.
   */
  .service-card__media {
    position: relative;
    aspect-ratio: 2 / 1;
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .service-card__media {
      aspect-ratio: 21 / 9;
    }
  }

  /* The pastel wash holds the nine photographs together as one set. It used to
     clear on hover; that was one more thing changing under a pointer that is
     usually just passing through. */
  .service-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--card-tint);
    opacity: 0.2;
  }

  .service-card__img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    /* Static overscan, not a hover zoom — it only covers the subpixel gap the
       rounded corners leave at the edges. */
    transform: scale(1.01);
  }

  /**
   * The card has no entry of its own either. It used to fade up, settle a
   * scale, pull its picture into focus and lift its wash — read as a set being
   * laid out for you, but only outside the pin. Inside it, a row crosses the
   * clip edge with the track already carrying it, so that entry played on top
   * of the travel and the card appeared to move at a different rate from the
   * scroll. The scroll is the only motion in this section now.
   */

  .service-card__body {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    padding: 20px;
  }

  @media (min-width: 1024px) {
    .service-card__body {
      padding: 26px;
    }
  }

  /* Frosted chip on the image, inset to the same left axis as the copy below
     so the card has one vertical edge running through it. */
  .service-card__mark {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 20px;
    display: inline-flex;
    height: 38px;
    width: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
    color: #0b0b0f;
  }

  @media (min-width: 1024px) {
    .service-card__mark {
      top: 20px;
      left: 26px;
    }
  }

  /* Card type, from the site's scale. Sizes are set here rather than as
     utilities on the markup so the whole card reads as one block when tuning. */
  .service-card__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .service-card__desc {
    /* The floor under the rule. `mt-auto` on the figures only ever adds to it,
       so a four-line description can no longer crowd the hairline. */
    margin: 10px 0 24px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: rgb(11 11 15 / 0.72);
    text-wrap: pretty;
  }

  .service-card__stats {
    display: flex;
    margin-top: auto;
    gap: 28px;
    border-top: 1px solid rgb(0 0 0 / 0.1);
    padding-top: 16px;
  }

  /* 22px against 14px copy. At 16px the figures were one step off the body
     text and read as more sentence rather than as the evidence. */
  .service-card__stat {
    display: block;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .service-card__stat-label {
    display: block;
    margin-top: 3px;
    font-size: 11.5px;
    font-weight: 400;
    line-height: 1.35;
    color: rgb(11 11 15 / 0.6);
  }

  /**
   * An outlined pill at rest that fills with ink on card hover. As bare text it
   * read as a fourth line of copy rather than as the thing you came to click,
   * and it was the only element in the card with no edge of its own.
   *
   * `align-self` matters: the body is a flex column, so a stretched item would
   * run the pill the full width of the card.
   */
  .service-card__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    padding: 9px 15px 9px 17px;
    border: 1px solid rgb(11 11 15 / 0.2);
    border-radius: var(--rounded-pill);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgb(11 11 15 / 0.85);
    /* 0.22s, down from 0.4s. It is the only answer the card gives now, so it
       has to land while the pointer is still arriving rather than easing in
       behind it. */
    transition:
      background-color 0.22s ease-out,
      border-color 0.22s ease-out,
      color 0.22s ease-out;
  }

  .service-card:hover .service-card__cta {
    background-color: #0b0b0f;
    border-color: #0b0b0f;
    color: #fff;
  }

  /* The pill's colour change is the only transition left on the card, and a
     colour crossfade moves nothing — but a reader who asked for no motion gets
     the instant swap anyway. */
  @media (prefers-reduced-motion: reduce) {
    .service-card__cta {
      transition: none;
    }
  }
</style>
