---
import {
  Activity,
  Bot,
  Database,
  Gauge,
  LifeBuoy,
  Puzzle,
  Rocket,
  Users,
  Workflow,
  ArrowRight,
} from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import { NAV_ROUTES } from "@/constants/site";
import {
  SERVICE_OFFERS,
  SERVICES_HEADER,
} from "@/features/services-section/constants";

/**
 * Services, as a pinned card grid.
 *
 * This was a rotating 3D wheel: nine cards on a ring, drag to spin, a tab
 * strip and arrows to drive it, and around 400 lines of rAF paint code to
 * hold it together. Only the crown card was ever fully legible, so seeing all
 * nine meant nine deliberate interactions. It is a grid now.
 *
 * From `lg` the grid is pinned: the section is a screen tall plus the height
 * the rows overflow by, the stage sticks to the top for exactly that
 * distance, and the track is translated by however far you have scrolled
 * through it. The header stays put while the rows pass under it — the section
 * asks which problem sounds like yours, so the question holds while you go
 * through the answers. When the track runs out the stage unsticks and the page
 * carries on by itself.
 *
 * The travel is 1:1 with the page, and the mapping is a scroll-driven CSS
 * animation wherever the browser has one, so the rows are sampled on the same
 * frame as the scroll rather than a rAF behind it. The script keeps the old
 * transform path for browsers without scroll timelines, and otherwise only
 * measures.
 *
 * The scroll is the whole motion. The cards have no entry of their own — they
 * used to fade and scale in on an observer, which inside a clipped window
 * fired mid-travel and put a second, slower movement on a row that was already
 * moving. Nor is there a progress rail or a count under the window: both were
 * meters for a scroll the reader is already doing, and the cut edge of the next
 * row is the honest signal that there is more.
 *
 * Nothing here intercepts the wheel. The scroll is the page's own, read rather
 * than captured, so trackpad momentum, keyboard paging, scrollbar dragging and
 * scrolling back up all behave normally. The pin is off below `lg`, off under
 * `prefers-reduced-motion`, and off whenever the rows already fit — in every
 * one of those cases the grid is an ordinary block in the flow.
 */

const ICONS = {
  Puzzle,
  Workflow,
  Rocket,
  Bot,
  Gauge,
  LifeBuoy,
  Activity,
  Database,
  Users,
} as const;

const CARD_COUNT = SERVICE_OFFERS.length;
---

{/*
  `overflow-hidden` is gone from this section on purpose: overflow on ANY
  ancestor of a `position: sticky` element silently disables the sticky, and
  the stage below depends on it. Nothing needs the clip now that the wheel is.
*/}
<section class="relative bg-[#0f0f12] text-white">
  <div class="services-pin" data-pin>
    <div class="services-pin__stage">
      <Container class="relative z-10 w-full shrink-0">
        <SectionIntro
          label={SERVICES_HEADER.label}
          title={SERVICES_HEADER.title}
          description={SERVICES_HEADER.description}
          tone="dark"
          align="center"
        />
      </Container>

      {/*
        The window is what the rows are read through, and the track is what
        moves. `overflow: clip` rather than `hidden`: `hidden` makes a scroll
        container, so tabbing to a card off-window would scroll it internally
        and desync it from the transform. `clip` cannot scroll, and the focus
        handler in the script moves the page instead.
      */}
      <div class="services-pin__window" data-pin-window>
        <div class="services-pin__track" data-pin-track>
          <Container class="w-full">
            {/*
              No scroll-reveal on the cards. Inside the pinned window a row
              crosses the clip edge and the observer fires mid-travel, so a card
              faded up while it was already sliding — two motions on one element
              going different directions. The rows arrive by the scroll and
              nothing else; the only thing animating here is the track.
            */}
            <div class="services-grid grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
      {
        SERVICE_OFFERS.map((service) => {
          const Icon = ICONS[service.icon as keyof typeof ICONS] ?? Bot;
          return (
            <a href={service.href} class="service-card">
              {/*
                The hover lift lives on this inner element rather than on the
                anchor, so the card's own transform is never the one the pin
                would have to share.
              */}
              <div
                class="service-card__inner"
                style={`--card-tint:${service.color};background:${service.color}`}
              >
                <div class="service-card__media">
                  <img
                    src={service.image}
                    alt=""
                    sizes="(min-width: 1024px) 440px, (min-width: 640px) 50vw, 100vw"
                    class="service-card__img"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                  {/*
                    The mark sits in the image, on the same left axis as the
                    title and the figures below it. Straddling the seam between
                    image and copy read as a notch in the card rather than as a
                    badge, and beside a two-line title it aligned to nothing.
                  */}
                  <span class="service-card__mark">
                    <Icon class="h-[18px] w-[18px]" stroke-width={1.75} />
                  </span>
                </div>

                <div class="service-card__body">
                  <h3 class="service-card__title">{service.title}</h3>
                  <p class="service-card__desc">{service.description}</p>

                  {/*
                    `mt-auto` alone let the rule ride up against the last line of
                    a long description. The margin on the copy above sets the
                    floor; `mt-auto` only ever adds to it.
                  */}
                  <div class="service-card__stats">
                    {service.stats.map((stat) => (
                      <div class="min-w-0">
                        <b class="service-card__stat">{stat.value}</b>
                        <span class="service-card__stat-label">{stat.label}</span>
                      </div>
                    ))}
                  </div>

                  <span class="service-card__cta">
                    View service
                    <ArrowRight class="service-card__arrow h-3.5 w-3.5" />
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
            </div>
          </Container>
        </div>
      </div>
    </div>
  </div>

  <Container class="relative z-10 pb-14 sm:pb-20 lg:pb-24">
    <div
      class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-5"
    >
      <GradientButton
        href={NAV_ROUTES.services}
        size="lg"
        surface="dark"
        class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto"
      >
        See all services
      </GradientButton>
      <p class="text-center text-[13px] leading-[1.4] text-white/70 sm:text-left">
        {CARD_COUNT} capabilities, with what each one ships.
      </p>
    </div>
  </Container>
</section>

<style>
  /* ==========================================================================
     THE PIN
     Off by default — this block is the plain flowing grid, which is what a
     phone, a reduced-motion reader, and any layout where the rows already fit
     all get. `[data-pin="on"]` is set by the script only once it has measured
     a real overflow to travel through.
     ========================================================================== */
  .services-pin {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .services-pin {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  .services-pin__window {
    margin-top: 2.5rem;
  }

  @media (min-width: 640px) {
    .services-pin__window {
      margin-top: 3.5rem;
    }
  }

  /* --- pinned --- */

  /* The extra height IS the scroll distance. The stage sticks for exactly as
     long as the track has left to travel, so the release lands on the frame
     the last row finishes arriving. */
  .services-pin[data-pin="on"] {
    height: calc(100dvh + var(--pin-travel, 0px));
    padding-top: 0;
    padding-bottom: 0;
  }

  .services-pin[data-pin="on"] .services-pin__stage {
    position: sticky;
    top: 0;
    display: flex;
    height: 100dvh;
    flex-direction: column;
    overflow: clip;
    padding-top: 3.25rem;
    padding-bottom: 1.5rem;
  }

  .services-pin[data-pin="on"] .services-pin__window {
    position: relative;
    min-height: 0;
    flex: 1;
    margin-top: 1.75rem;
    /* Not `hidden`: see the note in the markup — `hidden` would let focus
       scroll this box behind the transform's back. */
    overflow: clip;
  }

  .services-pin[data-pin="on"] .services-pin__track {
    transform: translate3d(0, var(--pin-shift, 0px), 0);
    will-change: transform;
  }

  /* --- the sync ---
     `--pin-shift` is written from script, and the obvious upgrade is to hand
     the mapping to a scroll-driven CSS animation — `view-timeline` on the pin,
     `animation-range: contain 0% contain 100%`, which is exactly this travel.
     It was tried. Chromium resolves it correctly in every API you can ask:
     `getComputedStyle` returns the right matrix, `getBoundingClientRect` puts
     the ninth card flush with the window at the end, `getAnimations()` reports
     progress 1 on a ViewTimeline. It just never paints it — captured
     compositor frames show the first row at every scroll offset. Do not
     reintroduce it on the strength of the computed values; they lie here.

     So the transform stays in script, and the cost of that is a frame of lag,
     which the Lenis binding below removes. */

  /**
   * The card. Nothing on it moves any more — no reveal on the anchor, no lift
   * on `__inner` — so the two are only still separate because the anchor is
   * what gets the focus ring and `__inner` is what gets clipped to the radius.
   */
  .service-card {
    display: block;
    border-radius: var(--rounded-xl);
  }

  .service-card__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--rounded-xl);
    color: #0b0b0f;
    text-align: left;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
  }

  /*
   * HOVER IS THE BUTTON, and nothing else on the card.
   *
   * It used to be four things at once: the card lifted and took a deep shadow,
   * its photograph zoomed, its wash cleared, and the other eight cards dropped
   * to 45% and shrank. Moving the pointer across a nine-card grid set most of
   * the section in motion, and since you cross the grid on the way to reading
   * it, that fired while scrolling. Filling the pill is the whole affordance —
   * it is the thing being clicked, so it is the thing that answers.
   */

  .service-card:focus-visible {
    outline: 2px solid var(--accent-on-dark);
    outline-offset: 4px;
  }

  /**
   * 21:9, not 16:10. At 16:10 the photograph took 277px of a 553px card —
   * dead half — and pushed the title, the copy and the figures into a strip
   * along the bottom. A letterbox gives the image enough to read as an image
   * and hands the rest of the card back to the words.
   */
  .service-card__media {
    position: relative;
    aspect-ratio: 2 / 1;
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .service-card__media {
      aspect-ratio: 21 / 9;
    }
  }

  /* The pastel wash holds the nine photographs together as one set. It used to
     clear on hover; that was one more thing changing under a pointer that is
     usually just passing through. */
  .service-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--card-tint);
    opacity: 0.2;
  }

  .service-card__img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    /* Static overscan, not a hover zoom — it only covers the subpixel gap the
       rounded corners leave at the edges. */
    transform: scale(1.01);
  }

  /**
   * The card has no entry of its own either. It used to fade up, settle a
   * scale, pull its picture into focus and lift its wash — read as a set being
   * laid out for you, but only outside the pin. Inside it, a row crosses the
   * clip edge with the track already carrying it, so that entry played on top
   * of the travel and the card appeared to move at a different rate from the
   * scroll. The scroll is the only motion in this section now.
   */

  .service-card__body {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    padding: 20px;
  }

  @media (min-width: 1024px) {
    .service-card__body {
      padding: 26px;
    }
  }

  /* Frosted chip on the image, inset to the same left axis as the copy below
     so the card has one vertical edge running through it. */
  .service-card__mark {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 20px;
    display: inline-flex;
    height: 38px;
    width: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
    color: #0b0b0f;
  }

  @media (min-width: 1024px) {
    .service-card__mark {
      top: 20px;
      left: 26px;
    }
  }

  /* Card type, from the site's scale. Sizes are set here rather than as
     utilities on the markup so the whole card reads as one block when tuning. */
  .service-card__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .service-card__desc {
    /* The floor under the rule. `mt-auto` on the figures only ever adds to it,
       so a four-line description can no longer crowd the hairline. */
    margin: 10px 0 24px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: rgb(11 11 15 / 0.72);
    text-wrap: pretty;
  }

  .service-card__stats {
    display: flex;
    margin-top: auto;
    gap: 28px;
    border-top: 1px solid rgb(0 0 0 / 0.1);
    padding-top: 16px;
  }

  /* 22px against 14px copy. At 16px the figures were one step off the body
     text and read as more sentence rather than as the evidence. */
  .service-card__stat {
    display: block;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .service-card__stat-label {
    display: block;
    margin-top: 3px;
    font-size: 11.5px;
    font-weight: 400;
    line-height: 1.35;
    color: rgb(11 11 15 / 0.6);
  }

  /**
   * An outlined pill at rest that fills with ink on card hover. As bare text it
   * read as a fourth line of copy rather than as the thing you came to click,
   * and it was the only element in the card with no edge of its own.
   *
   * `align-self` matters: the body is a flex column, so a stretched item would
   * run the pill the full width of the card.
   */
  .service-card__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    padding: 9px 15px 9px 17px;
    border: 1px solid rgb(11 11 15 / 0.2);
    border-radius: var(--rounded-pill);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgb(11 11 15 / 0.85);
    /* 0.22s, down from 0.4s. It is the only answer the card gives now, so it
       has to land while the pointer is still arriving rather than easing in
       behind it. */
    transition:
      background-color 0.22s ease-out,
      border-color 0.22s ease-out,
      color 0.22s ease-out;
  }

  .service-card:hover .service-card__cta {
    background-color: #0b0b0f;
    border-color: #0b0b0f;
    color: #fff;
  }

  /* The pill's colour change is the only transition left on the card, and a
     colour crossfade moves nothing — but a reader who asked for no motion gets
     the instant swap anyway. */
  @media (prefers-reduced-motion: reduce) {
    .service-card__cta {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Drives the pinned track from the page's own scroll position.
   *
   * Deliberately not a wheel handler. Reading the scroll and translating the
   * track keeps every native scrolling affordance intact — momentum, keyboard,
   * scrollbar, browser find, and reversing direction — where capturing the
   * wheel would break all of them. The section is simply taller than a screen
   * and the stage is sticky; the transform maps one to the other.
   *
   * The lag this would normally have — a scroll event, then a rAF, so the rows
   * land two frames behind the pinned header — is what made it read as slipping
   * before. Lenis is what fixes it: it moves the page from its own rAF and
   * emits `scroll` synchronously right after setting the offset, so painting
   * from that callback puts the rows on the same frame as the movement. See the
   * note on the CSS side for why this is not a scroll-driven animation.
   */
  function initServicesPin() {
    const root = document.querySelector<HTMLElement>("[data-pin]");
    if (!root || root.dataset.pinReady === "true") return;
    root.dataset.pinReady = "true";

    const stage = root.querySelector<HTMLElement>(".services-pin__stage");
    const win = root.querySelector<HTMLElement>("[data-pin-window]");
    const track = root.querySelector<HTMLElement>("[data-pin-track]");
    if (!stage || !win || !track) return;

    const wide = window.matchMedia("(min-width: 1024px)");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    let travel = 0;
    let originTop = 0;
    let pinned = false;
    let frame = 0;

    const measure = () => {
      travel = 0;
      pinned = false;
      track.style.removeProperty("--pin-shift");

      if (wide.matches && !still.matches) {
        /**
         * Measured with the pinned layout applied, not without it. Unpinned,
         * the window is an ordinary block that grows to its content, so it
         * always reports the track's own height and the overflow always came
         * out at zero. Only once the stage is a 100dvh flex column does the
         * window take the height the rows actually have to travel through.
         */
        root.style.setProperty("--pin-travel", "0px");
        root.dataset.pin = "on";

        const overflow = track.scrollHeight - win.clientHeight;
        // Under ~48px of overflow the pin costs more than it shows: the page
        // would stall for a distance the reader reads as a stutter.
        if (overflow > 48) {
          travel = Math.round(overflow);
          pinned = true;
        }
      }

      if (pinned) {
        root.style.setProperty("--pin-travel", `${travel}px`);
        // Cached here, not read per frame. `getBoundingClientRect()` inside the
        // scroll callback forces a layout flush on every scrolled frame, which
        // is the jitter it was supposed to be smoothing out. Layout only moves
        // on resize and on late images, and both already call this.
        originTop = root.getBoundingClientRect().top + window.scrollY;
      } else {
        root.dataset.pin = "off";
        root.style.removeProperty("--pin-travel");
      }
      paint();
    };

    const paint = () => {
      if (!pinned) {
        track.style.removeProperty("--pin-shift");
        return;
      }
      const shift = Math.min(travel, Math.max(0, window.scrollY - originTop));
      track.style.setProperty("--pin-shift", `${-shift}px`);
    };

    /**
     * Coalesced to a frame: a ResizeObserver fires per observed box, and the
     * font swap trips both at once.
     */
    let pendingMeasure = 0;
    const remeasure = () => {
      if (pendingMeasure) return;
      pendingMeasure = requestAnimationFrame(() => {
        pendingMeasure = 0;
        measure();
      });
    };

    /**
     * Hands `paint` to Lenis on the first scroll rather than at init, because
     * Layout's Lenis module has no guaranteed execution order against this one
     * — by the time anything has scrolled it is up. Browsers where Lenis bailed
     * out (it skips `prefers-reduced-motion`, which also turns the pin off)
     * stay on the rAF.
     */
    let bound = false;
    const schedule = () => {
      if (!bound) {
        bound = true;
        const lenis = (window as Window & { lenis?: { on?: Function } }).lenis;
        if (typeof lenis?.on === "function") {
          lenis.on("scroll", paint);
          window.removeEventListener("scroll", schedule);
          paint();
          return;
        }
      }
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        paint();
      });
    };

    /**
     * Tabbing to a card that is off-window would otherwise focus something the
     * reader cannot see. The window cannot scroll (`overflow: clip`), so move
     * the page by the same distance instead — which advances the pin and
     * carries the card up into view.
     */
    const onFocusIn = (event: FocusEvent) => {
      if (!pinned) return;
      const target = event.target as HTMLElement | null;
      const card = target?.closest?.(".service-card");
      if (!card || !track.contains(card)) return;

      const cardBox = card.getBoundingClientRect();
      const winBox = win.getBoundingClientRect();
      const over = cardBox.bottom - winBox.bottom;
      const under = winBox.top - cardBox.top;
      const delta = over > 0 ? over : under > 0 ? -under : 0;
      if (delta !== 0) window.scrollBy({ top: delta, behavior: "auto" });
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", measure);
    document.addEventListener("focusin", onFocusIn);
    wide.addEventListener("change", measure);
    still.addEventListener("change", measure);

    /**
     * `--pin-travel` is the whole mapping — the section's height and the end of
     * the track's run are both derived from it — so a stale one is a pin that
     * releases before the last row has finished arriving, or holds after it
     * has. It only stayed right by luck: the sole re-measure was a lazy image
     * landing, and the thing that actually moved the number was the webfont
     * reflowing the heading a frame earlier. Load a page where every image is
     * cached and nothing corrected it.
     *
     * A ResizeObserver on the two boxes the travel is computed from catches all
     * of it — fonts, wrapped headings, an image without an aspect ratio, a
     * browser zoom — without naming any of the causes. Measuring is layout
     * reads and one custom property, and none of it changes either observed
     * box, so there is no loop to guard against.
     */
    if (typeof ResizeObserver === "function") {
      const observer = new ResizeObserver(remeasure);
      observer.observe(track);
      observer.observe(win);
    }
    if (document.fonts?.status !== "loaded") void document.fonts?.ready.then(measure);

    measure();
  }

  initServicesPin();
  document.addEventListener("astro:page-load", initServicesPin);
</script>
