---
import {
  Activity,
  Bot,
  Database,
  Gauge,
  LifeBuoy,
  Puzzle,
  Rocket,
  Users,
  Workflow,
  ChevronLeft,
  ChevronRight,
} from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import { NAV_ROUTES } from "@/constants/site";
import {
  SERVICE_OFFERS,
  SERVICES_HEADER,
} from "@/features/services-section/constants";

/**
 * Port of features/services-section/components/services-grid.tsx — circular
 * wheel deck with continuous rotation, horizon scrim, and rAF-driven paint.
 */
const ICONS = {
  Puzzle,
  Workflow,
  Rocket,
  Bot,
  Gauge,
  LifeBuoy,
  Activity,
  Database,
  Users,
} as const;

const CARD_COUNT = SERVICE_OFFERS.length;
const RING_SLOTS = CARD_COUNT * Math.max(1, Math.ceil(10 / CARD_COUNT));
const initialIndex = Math.min(2, CARD_COUNT - 1);
---

<section class="relative overflow-hidden bg-[#1a1a1c] py-12 text-white sm:py-16 lg:py-24">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-45"
    style="background-image: url(/images/services-section-bg.png)"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-linear-to-b from-[#1a1a1c]/70 via-[#1a1a1c]/40 to-[#1a1a1c]/85"
  >
  </div>
  <Container class="relative z-10 w-full">
    <div
      data-reveal-stagger
      data-reveal-margin="-20% 0px -20% 0px"
      data-stagger="0.1"
      data-delay-children="0"
      style="--reveal-item-y:20px;--reveal-item-duration:0.55s"
      class="mx-auto max-w-6xl text-center"
    >
      <div data-reveal-item>
        <SectionLabel
          tone="accent"
          class="mb-0"
        >
          {SERVICES_HEADER.label}
        </SectionLabel>
      </div>
      <h2
        data-reveal-item
        class="mt-3 text-[clamp(1.625rem,3.5vw+0.75rem,3.5rem)] font-bold leading-[1.08] tracking-[-0.02em] text-white sm:mt-5"
      >
        {SERVICES_HEADER.title}
      </h2>
      <p
        data-reveal-item
        class="mx-auto stack-sm lede max-w-[640px] px-1 text-white/75 sm:stack-md"
      >
        {SERVICES_HEADER.description}
      </p>
    </div>

    <div data-deck-tabs class="relative z-20 mt-8 sm:mt-12 md:mt-14">
      <div class="flex items-center gap-3 sm:hidden">
        <button
          type="button"
          data-mobile-prev
          aria-label="Previous service"
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/25 text-white transition-colors active:bg-white/10"
        >
          <ChevronLeft class="h-4 w-4" />
        </button>
        <div class="min-w-0 flex-1 text-center">
          <span
            class="inline-flex max-w-full items-center justify-center rounded-full border border-accent bg-accent px-4 py-2 text-[13px] font-semibold text-white"
          >
            <span data-mobile-title class="truncate"
              >{SERVICE_OFFERS[0].short}</span
            >
          </span>
        </div>
        <button
          type="button"
          data-mobile-next
          aria-label="Next service"
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/25 text-white transition-colors active:bg-white/10"
        >
          <ChevronRight class="h-4 w-4" />
        </button>
      </div>
      <div class="mt-3 flex items-center justify-center gap-1.5 sm:hidden">
        {
          SERVICE_OFFERS.map((service, i) => (
            <button
              type="button"
              data-mobile-dot
              data-index={i}
              data-short={service.short}
              aria-label={service.title}
              class="h-1.5 rounded-full transition-all duration-300"
              data-active={i === 0 ? "true" : "false"}
            />
          ))
        }
      </div>

      <div class="hidden items-center justify-center gap-2.5 sm:flex">
        <button
          type="button"
          data-deck-prev
          aria-label="Previous service"
          class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full border border-white/25 bg-transparent text-white transition-colors hover:border-white/50 hover:bg-white/10"
        >
          <ChevronLeft class="h-4 w-4" />
        </button>

        <div
          data-deck-tabs-viewport
          class="mx-auto w-max min-w-0 max-w-[min(1040px,calc(100%_-_5.5rem))] overflow-x-auto overflow-y-hidden [scrollbar-width:none] [mask-image:linear-gradient(to_right,transparent_0,black_28px,black_calc(100%_-_28px),transparent_100%)] [&::-webkit-scrollbar]:hidden"
        >
          <div class="flex w-max gap-2 px-1">
            {
              SERVICE_OFFERS.map((service, i) => (
                <button
                  type="button"
                  data-deck-tab
                  data-index={i}
                  data-active={i === initialIndex ? "true" : "false"}
                  class="shrink-0 whitespace-nowrap rounded-pill-category border px-4 py-2 text-button-md transition-all duration-300"
                >
                  {service.short}
                </button>
              ))
            }
          </div>
        </div>

        <button
          type="button"
          data-deck-next
          aria-label="Next service"
          class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full border border-white/25 bg-transparent text-white transition-colors hover:border-white/50 hover:bg-white/10"
        >
          <ChevronRight class="h-4 w-4" />
        </button>
      </div>
    </div>
  </Container>

  <div
    data-mobile-track
    class="relative z-10 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto overflow-y-hidden overscroll-x-contain px-5 pb-2 scrollbar-none sm:hidden [&::-webkit-scrollbar]:hidden"
  >
    {
      SERVICE_OFFERS.map((service) => {
        const Icon = ICONS[service.icon as keyof typeof ICONS] ?? Bot;
        return (
          <a
            href={service.href}
            class="flex w-[calc(100vw-5.5rem)] shrink-0 snap-center flex-col overflow-hidden rounded-md p-4 text-left text-[#0b0b0f]"
            style={`background:${service.color}`}
          >
            <div class="flex items-start gap-2.5">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-black/8 text-[#0b0b0f]">
                <Icon class="h-4 w-4" stroke-width={1.75} />
              </div>
              <h3 class="m-0 min-w-0 flex-1 text-[16.5px] font-semibold leading-tight tracking-[-0.02em] text-[#0b0b0f]">
                {service.title}
              </h3>
            </div>

            <p class="m-0 mt-3 text-[13.5px] leading-normal text-[#0b0b0f]/72">
              {service.description}
            </p>

            <div class="mt-3.5 flex gap-5 border-t border-black/10 pt-3">
              {service.stats.map((stat) => (
                <div class="min-w-0">
                  <b class="block text-[15px] font-semibold tracking-[-0.02em] text-[#0b0b0f]">
                    {stat.value}
                  </b>
                  <span class="mt-0.5 block text-[10.5px] leading-snug text-[#0b0b0f]/55">
                    {stat.label}
                  </span>
                </div>
              ))}
            </div>

            <div class="relative mt-3.5 h-26 shrink-0 overflow-hidden rounded-2xl">
              <img
                src={service.image}
                alt=""
                sizes="(max-width: 640px) 320px, 400px"
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>

            <span class="mt-3 inline-flex items-center gap-0.5 text-[12.5px] font-semibold tracking-[-0.01em] text-[#0b0b0f]/80">
              View service
              <ChevronRight class="h-3.5 w-3.5" />
            </span>
          </a>
        );
      })
    }
  </div>

  <div
    data-deck-stage
    data-card-count={CARD_COUNT}
    data-ring-slots={RING_SLOTS}
    data-initial-index={initialIndex}
    class="relative z-10 mt-6 hidden w-full touch-pan-y select-none overflow-hidden sm:mt-8 sm:block md:mt-10"
  >
    <div
      aria-hidden="true"
      data-deck-horizon
      class="pointer-events-none absolute inset-x-0 bottom-0 z-[200]"
    >
    </div>
    <div class="relative mx-auto h-full w-full">
      {
        Array.from({ length: RING_SLOTS }, (_, slot) => {
          const service = SERVICE_OFFERS[slot % CARD_COUNT];
          const Icon = ICONS[service.icon as keyof typeof ICONS] ?? Bot;

          return (
            <div
              data-deck-orbit
              data-slot={slot}
              data-href={service.href}
              data-short={service.short}
              class="absolute left-1/2 top-4 sm:top-7 md:top-10"
              style="visibility:hidden;opacity:0"
            >
              <div
                data-deck-card
                role="button"
                tabindex="-1"
                class="group flex h-full w-full flex-col overflow-hidden rounded-md p-4 text-left text-[#0b0b0f] shadow-[0_14px_28px_-12px_rgba(0,0,0,0.7)] transition-[transform,opacity] duration-[900ms] ease-[cubic-bezier(.22,1,.36,1)] sm:rounded-md sm:p-6 md:p-[30px]"
                style={`background:${service.color}`}
              >
                <div class="flex min-h-0 flex-1 flex-col overflow-hidden">
                  <div class="mb-1.5 flex items-center gap-2.5 sm:mb-2 sm:gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-black/[0.08] text-[#0b0b0f] sm:h-11 sm:w-11 sm:rounded-2xl">
                      <Icon class="h-4 w-4 sm:h-5 sm:w-5" stroke-width={1.75} />
                    </div>
                    <h3 class="m-0 line-clamp-2 min-w-0 flex-1 text-[16.5px] font-semibold tracking-[-0.02em] leading-[1.2] text-[#0b0b0f] sm:text-[20px] md:text-[22px]">
                      {service.title}
                    </h3>
                  </div>
                  <p class="m-0 mb-3 line-clamp-2 max-w-[30ch] text-[12.5px] leading-[1.5] text-[#0b0b0f]/72 sm:mb-5 sm:line-clamp-3 sm:max-w-none sm:text-[14.5px] sm:leading-[1.55] md:text-[15.5px]">
                    {service.description}
                  </p>
                  <div class="mb-2 hidden gap-5 border-t border-black/10 pt-3.5 sm:mb-0 sm:flex md:gap-7 md:pt-4">
                    {service.stats.map((stat) => (
                      <div class="min-w-0">
                        <b class="block text-[16px] font-semibold tracking-[-0.02em] text-[#0b0b0f] md:text-[18px]">
                          {stat.value}
                        </b>
                        <span class="mt-0.5 block line-clamp-1 text-[11px] leading-snug text-[#0b0b0f]/55 md:text-[12px]">
                          {stat.label}
                        </span>
                      </div>
                    ))}
                  </div>
                  <span
                    data-deck-cta
                    class="mt-auto inline-flex h-5 shrink-0 items-center gap-0.5 text-[12px] font-semibold tracking-[-0.01em] text-[#0b0b0f]/80 opacity-0 pointer-events-none sm:mt-4 sm:h-auto sm:text-[13px] [@media(hover:hover)]:hidden"
                  >
                    View service
                    <ChevronRight class="h-3.5 w-3.5" />
                  </span>
                </div>
                <div class="relative mt-3 h-[88px] shrink-0 overflow-hidden rounded-2xl sm:mt-4 sm:h-[130px] md:h-[150px]">
                  <img
                    src={service.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
                <span
                  data-deck-hover-cta
                  class="pointer-events-none absolute left-1/2 top-1/2 z-50 hidden -translate-x-1/2 -translate-y-1/2 scale-90 whitespace-nowrap rounded-full bg-black/85 px-[22px] py-3 text-[13px] font-semibold text-white opacity-0 transition-all duration-300 hover:bg-accent"
                >
                  View service →
                </span>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <Container class="relative z-10">
    <div
      class="mt-9 flex flex-col items-center gap-3 sm:mt-12 sm:flex-row sm:justify-center sm:gap-5"
    >
      <GradientButton
        href={NAV_ROUTES.services}
        size="lg"
        class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto"
      >
        See all services
      </GradientButton>
      <p
        class="text-center text-[13px] leading-snug text-white/55 sm:text-left sm:text-[13.5px]"
      >
        {CARD_COUNT} capabilities, with what each one ships.
      </p>
    </div>
  </Container>
</section>

<style>
  [data-deck-tab] {
    border-color: rgb(255 255 255 / 0.18);
    background-color: rgb(255 255 255 / 0.05);
    color: rgb(255 255 255 / 0.75);
  }

  [data-deck-tab]:hover {
    border-color: rgb(255 255 255 / 0.4);
  }

  [data-deck-tab][data-active="true"] {
    border-color: var(--accent);
    background-color: var(--accent);
    color: #fff;
  }

  [data-deck-dot],
  [data-mobile-dot] {
    width: 0.375rem;
    background-color: rgb(255 255 255 / 0.3);
  }

  [data-deck-dot][data-active="true"],
  [data-mobile-dot][data-active="true"] {
    width: 1.25rem;
    background-color: var(--accent);
  }

  [data-deck-orbit][data-center="true"] [data-deck-cta] {
    opacity: 1;
    pointer-events: auto;
  }

  @media (hover: hover) {
    [data-deck-orbit][data-center="true"] [data-deck-hover-cta] {
      display: block;
    }

    [data-deck-orbit][data-center="true"]:hover [data-deck-hover-cta] {
      pointer-events: auto;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>

<script define:vars={{ CARD_COUNT, RING_SLOTS, initialIndex }}>
  const DEG = Math.PI / 180;
  const CLICK_SLOP = 8;
  const CARD_CLEARANCE = 72;
  const ANGLE_STEP = 360 / RING_SLOTS;
  const SECTION_BG = "#1a1a1c";
  const HORIZON_SCRIM = `linear-gradient(to bottom, rgba(26,26,28,0) 0%, rgba(26,26,28,0.55) 45%, rgba(26,26,28,0.9) 78%, ${SECTION_BG} 100%)`;

  const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
  const modulo = (v, n) => ((v % n) + n) % n;
  const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

  function circularDelta(i, active, n) {
    let d = i - active;
    if (d > n / 2) d -= n;
    if (d < -n / 2) d += n;
    return d;
  }

  function slotFrame(slot, rotation, radius, tilt, drop) {
    const rad = (slot * ANGLE_STEP + rotation) * DEG;
    const sin = Math.sin(rad);
    const cos = Math.cos(rad);
    const depth = (1 - cos) / 2;

    return {
      transform:
        `translate(-50%, 0) translate3d(${radius * sin}px, ${radius * (1 - cos)}px, 0)` +
        ` rotate(${tilt * sin}deg) scale(${1 - depth * drop})`,
      opacity: clamp((0.55 - depth) / 0.17, 0, 1) * (1 - depth * 0.28),
      zIndex: Math.round((1 - depth) * 100) + 1,
    };
  }

  function initServicesWheel() {
    const stage = document.querySelector("[data-deck-stage]");
    if (!stage || stage.dataset.wheelReady === "true") return;
    stage.dataset.wheelReady = "true";

    const section = stage.closest("section");
    const horizon = stage.querySelector("[data-deck-horizon]");
    const orbits = Array.from(stage.querySelectorAll("[data-deck-orbit]"));
    const tabs = Array.from(section?.querySelectorAll("[data-deck-tab]") ?? []);
    const dots = Array.from(section?.querySelectorAll("[data-deck-dot]") ?? []);
    const tabsViewport = section?.querySelector("[data-deck-tabs-viewport]");
    const activeTitle = section?.querySelector("[data-deck-active-title]");

    const shorts = orbits.map((orbit) => orbit.dataset.short ?? "");
    const titles = orbits.map(
      (orbit) => orbit.querySelector("h3")?.textContent?.trim() ?? "",
    );

    let rotation = -initialIndex * ANGLE_STEP;
    let userRotation = rotation;
    let pendingRotation = rotation;
    let activeSlot = initialIndex;
    let revealed = false;
    let rafId = null;

    const shown = new Array(RING_SLOTS).fill(false);
    const drag = { active: false, startX: 0, startRotation: 0, moved: false };

    let isSm = false;
    let isMd = false;
    let vw = 390;
    let cardW = 210;
    let cardH = 290;
    let radius = 203;
    let tiltMax = 20;
    let scaleDrop = 0.34;
    let stagePad = 165;
    let dragSpan = 190;
    let degPerPx = ANGLE_STEP / dragSpan;

    const measure = () => {
      vw = window.innerWidth;
      isSm = window.matchMedia("(min-width: 640px)").matches;
      isMd = window.matchMedia("(min-width: 768px)").matches;

      cardW = isMd ? 400 : isSm ? 300 : Math.round(Math.min(210, vw * 0.54));
      cardH = isMd ? 480 : isSm ? 420 : Math.round(cardW * 1.38);
      tiltMax = isMd ? 34 : isSm ? 28 : 20;
      scaleDrop = isMd ? 0.3 : isSm ? 0.3 : 0.34;

      const neighbourTilt = tiltMax * Math.sin(ANGLE_STEP * DEG);
      const neighbourScale =
        1 - ((1 - Math.cos(ANGLE_STEP * DEG)) / 2) * scaleDrop;
      const minRadius =
        (cardW / 2 +
          CARD_CLEARANCE +
          ((cardW * Math.cos(neighbourTilt * DEG) +
            cardH * Math.sin(neighbourTilt * DEG)) /
            2) *
            neighbourScale) /
        Math.sin(ANGLE_STEP * DEG);

      radius = Math.max(
        minRadius,
        isMd
          ? clamp(vw * 0.5, 600, 900)
          : isSm
            ? clamp(vw * 0.6, 400, 600)
            : Math.round(vw * 0.92),
      );

      stagePad = isMd ? 300 : isSm ? 215 : 165;
      dragSpan = isMd ? 300 : isSm ? 240 : 190;
      degPerPx = ANGLE_STEP / dragSpan;

      stage.style.height = `${cardH + stagePad}px`;
      if (horizon) {
        horizon.style.height = `${Math.round((cardH + stagePad) * 0.3)}px`;
        horizon.style.background = HORIZON_SCRIM;
      }

      orbits.forEach((orbit) => {
        orbit.style.width = `${cardW}px`;
        orbit.style.height = `${cardH}px`;
        const card = orbit.querySelector("[data-deck-card]");
        if (card) card.style.width = "100%";
      });
    };

    const paint = (value) => {
      rotation = value;
      pendingRotation = value;

      for (let slot = 0; slot < RING_SLOTS; slot += 1) {
        const el = orbits[slot];
        if (!el) continue;

        const frame = slotFrame(slot, value, radius, tiltMax, scaleDrop);
        const show = frame.opacity >= 0.01;

        if (show) {
          el.style.transform = frame.transform;
          el.style.opacity = `${frame.opacity}`;
          el.style.zIndex = `${frame.zIndex}`;
          el.style.pointerEvents =
            revealed && frame.opacity > 0.3 ? "auto" : "none";
        }

        if (show !== shown[slot]) {
          shown[slot] = show;
          el.style.visibility = show ? "visible" : "hidden";
          el.style.willChange = show ? "transform, opacity" : "auto";
          el.style.setProperty("content-visibility", show ? "visible" : "hidden");
          if (!show) {
            el.style.opacity = "0";
            el.style.pointerEvents = "none";
          }
        }

        const delta = circularDelta(slot, activeSlot, RING_SLOTS);
        el.dataset.center = delta === 0 ? "true" : "false";
        const card = el.querySelector("[data-deck-card]");
        if (card) {
          card.tabIndex = revealed && frame.opacity > 0.3 ? 0 : -1;
          card.setAttribute(
            "aria-label",
            `${delta === 0 ? "View" : "Show"} ${titles[slot % CARD_COUNT]}`,
          );
          if (revealed) {
            card.classList.remove("translate-y-10", "scale-[0.92]", "opacity-0");
            card.classList.add("translate-y-0", "scale-100", "opacity-100");
          }
        }
      }

      const slot = modulo(-Math.round(value / ANGLE_STEP), RING_SLOTS);
      if (slot !== activeSlot) {
        activeSlot = slot;
        updateTabs();
      }
    };

    const render = () => paint(userRotation);

    const stopAnimation = () => {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    };

    const animateTo = (target) => {
      stopAnimation();
      const from = userRotation;
      const dist = target - from;
      if (Math.abs(dist) < 0.01) {
        userRotation = target;
        render();
        return;
      }
      const duration = clamp(560 + Math.abs(dist) * 6, 620, 1400);
      const start = performance.now();

      const tick = (now) => {
        const t = Math.min(1, (now - start) / duration);
        userRotation = from + dist * easeOutCubic(t);
        render();
        if (t < 1) rafId = requestAnimationFrame(tick);
        else rafId = null;
      };
      rafId = requestAnimationFrame(tick);
    };

    const rotationForSlot = (slot) => {
      const base = -slot * ANGLE_STEP;
      return base + Math.round((userRotation - base) / 360) * 360;
    };

    const goToSlot = (slot) => animateTo(rotationForSlot(slot));

    const setActiveIndex = (i) => {
      const index = modulo(i, CARD_COUNT);
      let best = index;
      let bestDist = Infinity;
      for (let slot = index; slot < RING_SLOTS; slot += CARD_COUNT) {
        const dist = Math.abs(rotationForSlot(slot) - userRotation);
        if (dist < bestDist) {
          bestDist = dist;
          best = slot;
        }
      }
      goToSlot(best);
    };

    const updateTabs = () => {
      const activeIndex = activeSlot % CARD_COUNT;
      tabs.forEach((tab, i) => {
        tab.dataset.active = i === activeIndex ? "true" : "false";
      });
      dots.forEach((dot, i) => {
        dot.dataset.active = i === activeIndex ? "true" : "false";
      });
      if (activeTitle) activeTitle.textContent = shorts[activeSlot] ?? "";
      if (isSm && tabsViewport) {
        const tab = tabs[activeIndex];
        if (tab) {
          const left =
            tab.offsetLeft - (tabsViewport.clientWidth - tab.offsetWidth) / 2;
          tabsViewport.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
        }
      }
    };

    let revealTimer = 0;
    const revealObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          window.clearTimeout(revealTimer);
          revealed = true;
          render();
        } else {
          revealTimer = window.setTimeout(() => {
            revealed = false;
            render();
          }, 120);
        }
      },
      { threshold: 0.18, rootMargin: "0px 0px -6% 0px" },
    );
    revealObserver.observe(stage);

    /**
     * Capture only after the pointer travels past CLICK_SLOP. Capturing on
     * pointerdown sends pointerup to the stage and swallows "View service"
     * clicks on the crown card.
     */
    let capturedId = null;

    stage.addEventListener("pointerdown", (event) => {
      stopAnimation();
      drag.active = true;
      drag.startX = event.clientX;
      drag.startRotation = userRotation;
      drag.moved = false;
      capturedId = null;
    });

    stage.addEventListener("pointermove", (event) => {
      if (!drag.active) return;
      const dx = event.clientX - drag.startX;
      if (Math.abs(dx) > CLICK_SLOP) {
        drag.moved = true;
        if (capturedId === null) {
          try {
            stage.setPointerCapture(event.pointerId);
            capturedId = event.pointerId;
          } catch {
            /* pointer already gone */
          }
        }
      }
      pendingRotation = drag.startRotation + dx * degPerPx;
      if (rafId === null) {
        rafId = requestAnimationFrame(() => {
          rafId = null;
          userRotation = pendingRotation;
          render();
        });
      }
    });

    const endDrag = (event) => {
      if (!drag.active) return;
      drag.active = false;
      stopAnimation();
      userRotation = pendingRotation;
      render();
      goToSlot(-Math.round(rotation / ANGLE_STEP));
      if (capturedId !== null) {
        try {
          stage.releasePointerCapture(event.pointerId);
        } catch {
          /* already released */
        }
        capturedId = null;
      }
    };

    stage.addEventListener("pointerup", endDrag);
    stage.addEventListener("pointercancel", endDrag);
    stage.addEventListener("pointerleave", (event) => {
      if (drag.active) endDrag(event);
    });

    const onCardActivate = (slot) => {
      if (drag.moved) return;
      if (slot === activeSlot) {
        const href = orbits[slot]?.dataset.href;
        if (href) window.location.href = href;
        return;
      }
      goToSlot(slot);
    };

    orbits.forEach((orbit, slot) => {
      const card = orbit.querySelector("[data-deck-card]");
      card?.addEventListener("click", () => onCardActivate(slot));
      card?.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          onCardActivate(slot);
        }
      });
    });

    section?.querySelectorAll("[data-deck-prev]").forEach((btn) =>
      btn.addEventListener("click", () => goToSlot(activeSlot - 1)),
    );
    section?.querySelectorAll("[data-deck-next]").forEach((btn) =>
      btn.addEventListener("click", () => goToSlot(activeSlot + 1)),
    );

    [...tabs, ...dots].forEach((el) =>
      el.addEventListener("click", () => setActiveIndex(Number(el.dataset.index ?? "0"))),
    );

    document.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goToSlot(activeSlot - 1);
      if (event.key === "ArrowRight") goToSlot(activeSlot + 1);
    });

    window.addEventListener("resize", () => {
      measure();
      render();
    });

    measure();
    userRotation = -initialIndex * ANGLE_STEP;
    pendingRotation = userRotation;
    render();
    updateTabs();
  }

  initServicesWheel();
  document.addEventListener("astro:page-load", initServicesWheel);
</script>

<script>
  function initMobileServices() {
    const track = document.querySelector<HTMLElement>("[data-mobile-track]");
    const section = track?.closest("section");
    if (!track || !section || track.dataset.mobileReady === "true") return;
    track.dataset.mobileReady = "true";

    const cards = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(
      section.querySelectorAll<HTMLButtonElement>("[data-mobile-dot]"),
    );
    const title = section.querySelector<HTMLElement>("[data-mobile-title]");
    let index = 0;

    const paint = (i: number) => {
      index = i;
      dots.forEach((dot, d) => {
        dot.dataset.active = d === i ? "true" : "false";
      });
      if (title) title.textContent = dots[i]?.dataset.short ?? "";
    };

    const scrollTo = (i: number) => {
      const n = cards.length;
      const next = ((i % n) + n) % n;
      const card = cards[next];
      if (!card) return;
      track.scrollTo({
        left: card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2,
        behavior: "smooth",
      });
      paint(next);
    };

    const onScroll = () => {
      const centre = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((el, i) => {
        const dist = Math.abs(el.offsetLeft + el.offsetWidth / 2 - centre);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      if (best !== index) paint(best);
    };

    section
      .querySelector("[data-mobile-prev]")
      ?.addEventListener("click", () => scrollTo(index - 1));
    section
      .querySelector("[data-mobile-next]")
      ?.addEventListener("click", () => scrollTo(index + 1));
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => scrollTo(i));
    });
    track.addEventListener("scroll", onScroll, { passive: true });
  }

  initMobileServices();
  document.addEventListener("astro:page-load", initMobileServices);
</script>
