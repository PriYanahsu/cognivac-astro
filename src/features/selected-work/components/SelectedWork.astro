---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import WorkPanel from "./WorkPanel.astro";
import WorkRow from "./WorkRow.astro";
import { HOME_STORIES, SELECTED_WORK_CONTENT } from "../constants";

/**
 * Wireframe slot 5 · Selected work.
 *
 * WHAT THIS USED TO BE, and why none of it is here.
 *
 * Six identical cards on an infinite marquee: a rAF clock translating a track,
 * cloned copies sized off a measured unit, edge scrims, pause-on-hover, a
 * count-up per card, and a second layout for phones and reduced motion —
 * roughly 200 lines of script to move proof past a reader at 34px a second.
 *
 * It cost the section the two things this slot exists to do. Nothing could be
 * compared, because no two figures were ever still on screen together at rest.
 * And nothing could be *said*, because a card that drifts has to be skimmable
 * in three seconds, so the problem and what we built were cut from every one
 * of them — the home page carried six headlines and six numbers with no story
 * attached to any of them.
 *
 * It is now the same two-partition shape the FAQ uses, mirrored: the list of
 * engagements on the left, and on the right the one being read, told in full —
 * picture, what was wrong, what we built, the figure it moved, and the way
 * through to the study. The first row is the one showing, from the server, so
 * the section is complete before any script runs.
 *
 * The order also answers the section above it. Services is a dark grid of
 * cards; another card grid here would have read as its second half. Cream, a
 * hairline list and one photograph is the step.
 */
const total = HOME_STORIES.length;
---

{/*
  The section is a track, and the thing that fills the screen is stuck to the
  top of it. Scrolling the track does not scroll the section past — it steps
  the story, one engagement per screen of travel, and when the last one is
  reached the track runs out and the page carries on to the next section.
  Nothing is intercepted to do that: the browser is scrolling normally the
  whole time, and `position: sticky` is doing the holding.
*/}
<section
  data-selected-work
  data-work-track
  id="selected-work"
  class="work-track bg-background"
  aria-labelledby="selected-work-title"
>
  <div data-work-pin class="work-pin py-14 sm:py-18 lg:py-20">
  <Container>
    <FadeIn>
      {/*
        The header is built on the same 7/5 split as the two columns under it,
        with the same gutter, so the heading sits over the list and the lede
        and button sit over the card — two vertical lines running the height of
        the section rather than four edges that nearly agree.

        THE HEADING IS THE COLUMN SIZE, not the full-width one. `text-section`
        is drawn for a heading that has the page to itself; in a seven-column
        slot it ran to 52px, took two long lines, and left the top right of the
        section empty for the 300px the button was hiding in. At the column
        scale it holds the same two lines at a size the column was built for,
        and the lede and the button fill the half beside it.
      */}
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-10 xl:gap-14">
        <div class="min-w-0 lg:col-span-7">
          <SectionLabel class="mb-0">
            {SELECTED_WORK_CONTENT.label}
          </SectionLabel>
          <h2
            id="selected-work-title"
            class="work-heading text-section-column stack-sm max-w-[24ch] text-balance text-foreground"
          >
            {SELECTED_WORK_CONTENT.title}
          </h2>
        </div>

        {/* Bottom-aligned with the heading, and on the card's left edge: both
            belong to the column they introduce. */}
        <div class="flex flex-col items-start gap-3.5 lg:col-span-5 lg:pb-1">
          <p class="lede max-w-[34ch]">
            {SELECTED_WORK_CONTENT.description}
          </p>
          <GhostButton href={SELECTED_WORK_CONTENT.cta.href}>
            {SELECTED_WORK_CONTENT.cta.label}
          </GhostButton>
        </div>
      </div>
    </FadeIn>

    <div
      class="work-body mt-8 grid items-start gap-8 sm:mt-10 lg:mt-12 lg:grid-cols-12 lg:items-stretch lg:gap-10 xl:gap-14"
    >
      {/* The list takes the wider half. It is the part the reader works —
          six engagements to run an eye down — and the card beside it answers
          whichever one they are on, so the card only needs to be big enough
          to hold one story, not to compete with the list for the page. */}
      <div class="work-list min-w-0 lg:col-span-7">
        {
          HOME_STORIES.map((study, i) => (
            <WorkRow study={study} index={i} total={total} active={i === 0} />
          ))
        }
      </div>

      {/* All six stories share one grid cell, so the column is as tall as the
          longest of them and nothing on the page moves when the reader crosses
          from one row to the next. Hidden entirely below the split, where the
          rows carry the summary themselves.

          The card itself — the white, the hairline, the radius, the shadow —
          is this element, not the six inside it. Six cards fading past each
          other meant the card's own background went with them, so the middle
          of every swap was a hole in the page where the cream showed through.
          The shell holds still and only the story dissolves. */}
      <div class="work-card hidden lg:col-span-5 lg:grid lg:self-start">
        {
          HOME_STORIES.map((study, i) => (
            <WorkPanel study={study} index={i} total={total} active={i === 0} />
          ))
        }
      </div>
    </div>
  </Container>
  </div>
</section>

<style>
  /**
   * THE TRACK AND THE PIN.
   *
   * Both are inert until the script has measured that the section fits on the
   * screen and turned them on, so the whole thing degrades to what it was
   * before — a normal section that scrolls past — whenever it cannot hold a
   * reader's screen honestly. Below the split, on a short window, and under
   * `prefers-reduced-motion`, that is exactly what happens.
   *
   * `--track-height` is the one number the script sets: one screen for the
   * section to stand in, plus a step of travel for every engagement after the
   * first.
   */
  .work-track.is-pinned {
    height: var(--track-height);
  }

  .work-track.is-pinned .work-pin {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    height: 100svh;
    align-items: center;
  }

  .work-track.is-pinned .work-pin > * {
    width: 100%;
  }

  /**
   * The section's standing air is what a reader scrolls through; pinned, it is
   * what decides whether the section fits the window at all — and the top of
   * it has to clear the navbar, which floats over everything and would
   * otherwise sit on the eyebrow for the whole time the section is held.
   */
  .work-track.is-pinned .work-pin {
    /* 72px clears the navbar, which floats over everything and would otherwise
       sit on the eyebrow for as long as the section is held. */
    padding-top: 4.5rem;
    padding-bottom: 0.75rem;
  }

  /**
   * WHERE THE PIN'S ROOM COMES FROM.
   *
   * A held section has the window as a hard ceiling instead of something to
   * scroll past, and something has to give. It is the section's own air and
   * its heading — never the card, which is the thing being read: squashing
   * that to buy 60px produced a letterbox over a cramped body, which is not a
   * card anyone would design on purpose.
   *
   * The heading drops from the column scale to a size that holds the same
   * words on one line, which is 30px of the 60 the pin needs. The rest comes
   * out of the gap under it and the padding around the whole thing.
   */
  .work-track.is-pinned .work-body {
    margin-top: 0.5rem;
  }

  .work-track.is-pinned .work-heading {
    font-size: clamp(1.5rem, 0.85vw + 1.1rem, 1.875rem);
    line-height: 1.18;
  }

  .work-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--rounded-lg);
    background: var(--card);
    box-shadow: 0 18px 45px rgba(34, 32, 28, 0.07);
    /* The frame the cover happens inside. `overflow` is not tidiness here —
       it is the thing that holds the arriving story off the edge of the card
       until it slides on, and cuts it to the card's corners while it does. */
  }

  /* The list carries the card's height at the split and the six rows share it
     between them, so the two columns end on the same line instead of leaving
     300px of cream under the last engagement. */
  @media (min-width: 1024px) {
    .work-list {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    /* `auto`, not `0`: each row keeps its own height and the rows share what
       is left over equally. That is also what absorbs the summary opening on
       the active row — the free space in the column shrinks by exactly what
       the row grows, so nothing below the section moves. */
    .work-list > :global(a) {
      flex: 1 1 auto;
    }
  }
</style>

<script>
  /**
   * The only script in this section: it moves one class between six rows and
   * six panels.
   *
   * The active row is held in state rather than read off `:hover` in CSS,
   * because the reader has to be able to leave the row and cross the gutter
   * into the panel to press its button — a pure `:hover` rule would swap the
   * story out from under them somewhere in between. Nothing here measures
   * anything, and there is no clock.
   */
  function initSelectedWork() {
    document
      .querySelectorAll<HTMLElement>("[data-selected-work]")
      .forEach((section) => {
        if (section.dataset.workReady === "true") return;
        section.dataset.workReady = "true";

        const rows = [
          ...section.querySelectorAll<HTMLElement>("[data-work-row]"),
        ];
        const panels = [
          ...section.querySelectorAll<HTMLElement>("[data-work-panel]"),
        ];
        if (rows.length === 0 || panels.length === 0) return;

        /* A cover, not a cross-fade: the story arriving comes in over the one
           already there from a full card-width away, and the one behind it
           holds still until it is fully hidden. */
        const OFF_CARD = 100;

        /**
         * How long the pointer has to stay on a row before the card follows
         * it.
         *
         * Without this, crossing the list to reach the sixth row fired five
         * covers on the way, each one cutting the last off partway across, and
         * the card thrashed. A tenth of a second is under what reads as a
         * pause — a reader who means a row rests on it for longer than this
         * without knowing they have — and it is enough that a sweep down the
         * whole list now costs one cover instead of five.
         */
        const SETTLE = 110;

        const currentX = (el: HTMLElement) =>
          new DOMMatrixReadOnly(getComputedStyle(el).transform).m41;

        let active = 0;
        let pending = 0;
        let timer = 0;
        let sweepTimer = 0;
        /* Raised once per cover so the stack reads newest-on-top. Reset when
           the layers underneath are cleared. */
        let stack = 10;

        /** How long a cover takes, matched to the transition in WorkPanel. */
        const COVER = 560;

        /**
         * Everything but the story showing, put away in one go.
         *
         * Rescheduled on every cover, so it only ever runs once the last one
         * has landed — which is what lets the layers underneath stay painted
         * for as long as it takes. Hiding them as each cover started is what
         * used to put white through the card on a fast scroll.
         */
        const clearBehind = () => {
          panels.forEach((panel, i) => {
            if (i === active) return;
            panel.classList.add("is-hidden");
            panel.style.removeProperty("z-index");
          });
          panels[active]?.style.removeProperty("z-index");
          stack = 10;
        };
        const show = (next: number) => {
          if (next === active || !panels[next]) return;

          /* The reader's direction, not the card's: going down the list the
             new story comes in from the right, going back up it comes in from
             the left. The one being covered is pinned where it stands — it is
             behind, and a story that slid or faded while it was being covered
             would show through the strip not yet reached. */
          const heading = next > active ? 1 : -1;
          const outgoing = panels[active];
          const incoming = panels[next];

          /* Frozen exactly where it stands rather than sent back to 0. If it
             was itself still sliding on, `0%` would snap it across the card in
             a single frame — which is the jump you saw when two covers
             overlapped. It stays painted, and stays where it is, until
             something covers it. */
          if (outgoing) {
            outgoing.style.setProperty("--enter", `${currentX(outgoing)}px`);
            outgoing.classList.remove("is-active");
          }
          rows[active]?.classList.remove("is-active");

          if (incoming) {
            incoming.style.setProperty("--enter", `${heading * OFF_CARD}%`);
            /* The shade rides the leading edge, so which edge that is follows
               the direction of travel. */
            incoming.style.setProperty(
              "--shade-dir",
              heading > 0 ? "to right" : "to left",
            );
            /* Put it down off the edge with no transition, force the browser
               to accept that as where it now is, and only then let it travel —
               otherwise it slides there from wherever it last stood. */
            incoming.classList.add("is-entering");
            incoming.classList.remove("is-hidden");
            /* Above everything it is about to cover, including any story still
               frozen part-way across from a cover before this one. */
            incoming.style.zIndex = String((stack += 1));
            void incoming.offsetWidth;
            incoming.classList.remove("is-entering");
            incoming.classList.add("is-active");
          }

          rows[next]?.classList.add("is-active");
          active = next;

          /* Put the layers underneath away, but only after this cover — and
             any that overtake it — has finished crossing. */
          window.clearTimeout(sweepTimer);
          sweepTimer = window.setTimeout(clearBehind, COVER + 60);
        };

        const settleOn = (i: number) => {
          if (i === pending) return;
          pending = i;
          window.clearTimeout(timer);
          timer = window.setTimeout(() => show(i), SETTLE);
        };

        rows.forEach((row, i) => {
          /* Mouse only, and only when the section is not driving itself off
             the scroll. On a touch screen `pointerenter` fires on the tap that
             is already following the link, so the card would swap for the
             instant before the page changes. */
          row.addEventListener("pointerenter", (event) => {
            if (pinned) return;
            if (event.pointerType === "mouse") settleOn(i);
          });
          /* Keyboard tabs through the list one row at a time and every stop is
             deliberate, so focus does not wait out the settle. Focus works
             pinned or not — a reader who tabs to a row has asked for it. */
          row.addEventListener("focus", () => {
            window.clearTimeout(timer);
            pending = i;
            show(i);
          });
        });

        /**
         * ─── THE NESTED SCROLL ──────────────────────────────────────────
         *
         * While the section holds the screen, scrolling steps through the six
         * engagements instead of moving the page; when the sixth is reached
         * the track runs out, the section lets go, and the page carries on.
         * Scrolling back up runs the whole thing in reverse, because the only
         * state is the scroll position — there is nothing here to get out of
         * sync with the page.
         *
         * IT DOES NOT TOUCH THE SCROLL. No `wheel` handler, no
         * `preventDefault`, no scrolling anything on the reader's behalf. The
         * browser scrolls the way it always does and `position: sticky` holds
         * the section still while it happens, which is why a trackpad, a
         * mouse wheel, Page Down, a keyboard, a screen reader and the scroll
         * bar itself all behave exactly as they do everywhere else on the
         * page — and why letting go at the end needs no code at all.
         */
        const track = section;
        const pin = section.querySelector<HTMLElement>("[data-work-pin]");
        const desktop = window.matchMedia("(min-width: 1024px)");
        const still = window.matchMedia("(prefers-reduced-motion: reduce)");

        /* How much scrolling one engagement is worth. Under about half a
           screen the six go by faster than they can be read; much over it and
           the section reads as a page that will not let go. */
        const STEP = 0.62;

        let pinned = false;
        let range = 0;

        /** Does a screen of this window actually hold the section? */
        const fits = () => {
          if (!pin) return false;
          const inner = pin.firstElementChild as HTMLElement | null;
          if (!inner) return false;
          const pad = getComputedStyle(pin);
          const needed =
            inner.scrollHeight +
            parseFloat(pad.paddingTop) +
            parseFloat(pad.paddingBottom);
          /* No safety margin beyond the pin's own bottom padding — the whole
             point of the measurement is that the section either stands in the
             window honestly or does not pin at all. */
          return needed <= window.innerHeight;
        };

        const unpin = () => {
          pinned = false;
          track.classList.remove("is-pinned");
          track.style.removeProperty("--track-height");
        };

        const measure = () => {
          if (!pin) return;
          if (!desktop.matches || still.matches) {
            if (pinned) unpin();
            return;
          }

          /* Measured with the pinned layout already applied — it is a little
             more compact than the standing one, and measuring the standing
             one would turn the pin off on windows that would have held it. */
          track.classList.add("is-pinned");
          if (!fits()) {
            unpin();
            return;
          }

          pinned = true;
          const step = Math.round(window.innerHeight * STEP);
          range = step * (panels.length - 1);
          track.style.setProperty(
            "--track-height",
            `${window.innerHeight + range}px`,
          );
          onScroll();
        };

        function onScroll() {
          if (!pinned || range <= 0) return;
          /* How far into the track the reader is, 0 to 1. `-top` because the
             track's top edge passes the top of the window and keeps going. */
          const progress = Math.min(1, Math.max(0, -track.getBoundingClientRect().top / range));
          /* Rounded, not floored: each engagement holds the card for half a
             step either side of its own mark, so the swap happens halfway
             between two rows rather than the instant one is left. */
          const next = Math.round(progress * (panels.length - 1));
          if (next !== active) {
            window.clearTimeout(timer);
            pending = next;
            show(next);
          }
        }

        let frame = 0;
        const onScrollFrame = () => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            onScroll();
          });
        };

        let resizeTimer = 0;
        const onResize = () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(measure, 150);
        };

        measure();
        window.addEventListener("scroll", onScrollFrame, { passive: true });
        window.addEventListener("resize", onResize);
        desktop.addEventListener("change", measure);
        still.addEventListener("change", measure);

        document.addEventListener(
          "astro:before-swap",
          () => {
            window.removeEventListener("scroll", onScrollFrame);
            window.removeEventListener("resize", onResize);
            desktop.removeEventListener("change", measure);
            still.removeEventListener("change", measure);
            window.clearTimeout(timer);
            window.clearTimeout(sweepTimer);
            window.clearTimeout(resizeTimer);
            if (frame) cancelAnimationFrame(frame);
          },
          { once: true },
        );
      });
  }

  initSelectedWork();
  document.addEventListener("astro:page-load", initSelectedWork);
</script>
