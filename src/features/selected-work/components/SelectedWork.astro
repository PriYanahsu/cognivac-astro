---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import StoryCard from "./StoryCard.astro";
import { HOME_STORIES, SELECTED_WORK_CONTENT } from "../constants";

/**
 * Port of features/selected-work/components/selected-work.tsx.
 *
 * The marquee is a transform on a track, driven by a clock, inside a
 * fixed-height overflow-hidden box. Measurement feeds the transform and
 * never the layout — same contract as the React original.
 *
 * overflow-hidden from the first paint (not overflow-x-auto) so Lenis
 * never hits a nested scroll container on the way into this section.
 */
const total = HOME_STORIES.length;
const gap = "flex w-max items-stretch gap-5 sm:gap-6 lg:gap-7";
---

<section
  data-selected-work
  id="selected-work"
  class="bg-background section-padding"
  aria-labelledby="selected-work-title"
>
  <Container>
    <FadeIn>
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
        <div class="min-w-0">
          <SectionLabel class="mb-0">
            {SELECTED_WORK_CONTENT.label}
          </SectionLabel>
          <h2
            id="selected-work-title"
            class="text-section stack-sm max-w-[20ch] text-foreground"
          >
            {SELECTED_WORK_CONTENT.title}
          </h2>
          <p class="stack-md lede max-w-[52ch]">
            {SELECTED_WORK_CONTENT.description}
          </p>
        </div>
        <GhostButton
          href={SELECTED_WORK_CONTENT.cta.href}
          class="shrink-0 self-start lg:self-auto"
        >
          {SELECTED_WORK_CONTENT.cta.label}
        </GhostButton>
      </div>
    </FadeIn>
  </Container>

  <div
    data-work-viewport
    data-reveal
    data-reveal-margin="-80px"
    style="--reveal-y:24px"
    class="relative mt-10 overflow-hidden py-3 lg:mt-14 motion-reduce:overflow-x-auto motion-reduce:overflow-y-hidden motion-reduce:overscroll-x-contain motion-reduce:scroll-px-6 motion-reduce:px-6 motion-reduce:lg:px-8"
  >
    <div
      data-work-track
      class={gap}
    >
      <div data-work-copy class={gap}>
        {
          HOME_STORIES.map((study, i) => (
            <StoryCard study={study} index={i} total={total} />
          ))
        }
      </div>
      <div data-work-clone aria-hidden="true" class={gap}>
        {
          HOME_STORIES.map((study, i) => (
            <StoryCard study={study} index={i} total={total} duplicate />
          ))
        }
      </div>
    </div>

    <div
      aria-hidden="true"
      data-work-scrim
      class="pointer-events-none absolute inset-y-0 left-0 w-10 bg-linear-to-r from-background to-transparent motion-reduce:hidden sm:w-16 lg:w-28"
    >
    </div>
    <div
      aria-hidden="true"
      data-work-scrim
      class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-linear-to-l from-background to-transparent motion-reduce:hidden sm:w-16 lg:w-28"
    >
    </div>
  </div>
</section>

<script>
  const SPEED = 34;
  const RAMP = 0.22;
  const EASE = (t: number) => 1 - Math.pow(1 - t, 3);
  const METRIC_PATTERN = /^(\D*)(\d+(?:\.\d+)?)(.*)$/;

  type ParsedMetric = {
    prefix: string;
    suffix: string;
    target: number;
    decimals: number;
    display: HTMLElement;
  };

  function parseMetric(value: string) {
    const match = METRIC_PATTERN.exec(value);
    if (!match) return null;
    const [, prefix, digits, suffix] = match;
    return {
      prefix,
      suffix,
      target: Number(digits),
      decimals: digits.includes(".") ? digits.split(".")[1].length : 0,
    };
  }

  const formatMetric = (parsed: Omit<ParsedMetric, "display">, n: number) =>
    `${parsed.prefix}${n.toFixed(parsed.decimals)}${parsed.suffix}`;

  function initSelectedWork() {
    const section = document.querySelector<HTMLElement>("[data-selected-work]");
    if (!section || section.dataset.workReady === "true") return;
    section.dataset.workReady = "true";

    const viewport = section.querySelector<HTMLElement>("[data-work-viewport]");
    const track = section.querySelector<HTMLElement>("[data-work-track]");
    const copy = section.querySelector<HTMLElement>("[data-work-copy]");
    if (!viewport || !track || !copy) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const paused = { current: false };

    const collectMetrics = (): ParsedMetric[] => {
      const items: ParsedMetric[] = [];
      section.querySelectorAll<HTMLElement>("[data-metric]").forEach((el) => {
        const parsed = parseMetric(el.dataset.metric ?? "");
        const display = el.querySelector<HTMLElement>("[data-metric-display]");
        if (!parsed || !display) return;
        items.push({ ...parsed, display });
      });
      return items;
    };

    if (reduceMotion) {
      track.querySelectorAll("[data-work-clone]").forEach((el) => el.remove());
      return;
    }

    track.style.willChange = "transform";

    let copies = 2;
    let counted = false;
    const ensureCopies = (n: number) => {
      while (track.querySelectorAll("[data-work-clone]").length < n - 1) {
        const clone = copy.cloneNode(true) as HTMLElement;
        clone.removeAttribute("data-work-copy");
        clone.setAttribute("data-work-clone", "");
        clone.setAttribute("aria-hidden", "true");
        clone.querySelectorAll("a").forEach((a) => {
          a.tabIndex = -1;
        });
        track.appendChild(clone);
      }
      const extra = track.querySelectorAll("[data-work-clone]");
      for (let i = extra.length - 1; i >= n - 1; i -= 1) {
        extra[i]?.remove();
      }
    };

    let metrics: ParsedMetric[] = [];
    const syncMetrics = () => {
      if (counted) return;
      metrics = collectMetrics();
      for (const m of metrics) m.display.textContent = formatMetric(m, 0);
    };

    let unit = 0;
    const measure = () => {
      const columnGap = parseFloat(getComputedStyle(track).columnGap) || 0;
      unit = copy.offsetWidth + columnGap;
      if (unit <= 0) return;
      const next = Math.max(2, Math.ceil(viewport.clientWidth / unit) + 1);
      if (next === copies) {
        if (metrics.length === 0) syncMetrics();
        return;
      }
      copies = next;
      ensureCopies(copies);
      syncMetrics();
    };
    measure();

    const countMetrics = () => {
      counted = true;
      const duration = 1100;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = EASE(t);
        for (const m of metrics) {
          m.display.textContent = formatMetric(m, m.target * eased);
        }
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const metricObserver = new IntersectionObserver(
      ([entry], obs) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        countMetrics();
      },
      { rootMargin: "-12% 0px", threshold: 0 },
    );
    metricObserver.observe(section);

    const resize = new ResizeObserver(measure);
    resize.observe(copy);
    resize.observe(viewport);

    let onScreen = true;
    const visibility = new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
      },
      { rootMargin: "150px 0px" },
    );
    visibility.observe(viewport);

    let offset = 0;
    let rate = 0;
    let last = 0;
    let frame = 0;

    const tick = (now: number) => {
      frame = requestAnimationFrame(tick);
      const dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
      last = now;

      const target = paused.current || !onScreen ? 0 : 1;
      rate += (target - rate) * (1 - Math.exp(-dt / RAMP));

      if (target === 0 && rate < 0.0005) {
        rate = 0;
        return;
      }

      if (unit > 0) {
        offset = (offset + SPEED * rate * dt) % unit;
        track.style.transform = `translate3d(${-offset}px, 0, 0)`;
      }
    };
    frame = requestAnimationFrame(tick);

    viewport.addEventListener("pointerenter", () => {
      paused.current = true;
    });
    viewport.addEventListener("pointerleave", () => {
      paused.current = false;
    });
    viewport.addEventListener(
      "focusin",
      () => {
        paused.current = true;
      },
      true,
    );
    viewport.addEventListener(
      "focusout",
      () => {
        paused.current = false;
      },
      true,
    );

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(frame);
        resize.disconnect();
        visibility.disconnect();
        metricObserver.disconnect();
      },
      { once: true },
    );
  }

  initSelectedWork();
  document.addEventListener("astro:page-load", initSelectedWork);
</script>
