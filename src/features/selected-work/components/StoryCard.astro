---
import { ArrowUpRight } from "@lucide/astro";
import { cn } from "@/lib/utils";
import type { CaseStudyItem } from "@/types";
import { STORY_STEPS, WORK_STORIES } from "../constants";

/**
 * The home-page work card.
 *
 * Four lines, in the order a skimmer reads them: what field this was, what the
 * engagement was, one line of what it did, the number it moved. The full three
 * beats — the problem, what we built, what changed — are the case study page's
 * job (CaseStudyDetail renders them); putting them here as well turned a card
 * that drifts past in a few seconds into a paragraph nobody finishes reading.
 */
interface Props {
  study: CaseStudyItem;
  index: number;
  total: number;
  duplicate?: boolean;
}

const { study, index, total, duplicate = false } = Astro.props;
const story = WORK_STORIES[study.id];
---

{
  story && (
    <a
      href={study.href}
      tabindex={duplicate ? -1 : undefined}
      class={cn(
        /* Layout containment keeps the count-up's text writes inside the card:
           without it every frame of the animation re-lays-out the whole
           multi-thousand-pixel track behind the marquee. */
        "group relative flex w-[calc(100vw-4.5rem)] shrink-0 snap-start flex-col overflow-hidden surface-card p-5 [contain:layout_style]",
        "sm:w-[21rem] sm:snap-align-none sm:p-6 lg:w-[24rem]",
        "transition-[transform,border-color,box-shadow] duration-300 ease-[cubic-bezier(.22,1,.36,1)]",
        "hover:border-accent/45 hover:shadow-soft [@media(hover:hover)]:hover:-translate-y-1",
      )}
    >
      <span
        aria-hidden="true"
        class="absolute inset-x-0 top-0 z-20 h-0.5 origin-left scale-x-0 bg-accent transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-x-100"
      />

      {/* The photograph stays a wash behind the metric, never an image block:
          it gives the card a floor without adding a thing to read. */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-[42%] overflow-hidden"
      >
        <img
          src={study.image}
          alt=""
          sizes="(max-width: 640px) 336px, 384px"
          class="absolute inset-0 h-full w-full object-cover object-bottom opacity-[0.13] transition-opacity duration-500 group-hover:opacity-[0.2]"
          loading={duplicate ? "lazy" : "eager"}
          decoding="async"
          draggable="false"
        />
        <div class="absolute inset-0 bg-linear-to-t from-card/50 via-card/85 to-card" />
      </div>

      <div class="relative z-10 flex min-h-0 flex-1 flex-col">
        <div class="flex items-center justify-between gap-4">
          <span class="inline-flex items-center gap-2 text-[10.5px] font-semibold uppercase tracking-[0.16em] text-accent sm:text-[11px]">
            <span
              aria-hidden="true"
              class="h-1.5 w-1.5 rounded-full bg-accent/45 transition-colors duration-500 group-hover:bg-accent"
            />
            {study.category}
          </span>
          <span
            class="shrink-0 text-[11px] font-semibold tracking-[0.18em] text-muted-light [font-variant-numeric:tabular-nums]"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, "0")}
            <span class="text-muted-light/60">
              /{String(total).padStart(2, "0")}
            </span>
          </span>
        </div>

        {/* Two lines reserved either way: the titles run one to two lines, and
            without the floor each card starts its summary at its own height. */}
        <h3 class="mt-5 line-clamp-2 min-h-[2.6em] text-[17px] font-semibold leading-[1.3] tracking-[-0.015em] text-foreground sm:text-[18px]">
          {study.title}
        </h3>

        <p class="mt-2.5 line-clamp-2 text-[13.5px] leading-[1.6] text-muted sm:text-[14px]">
          {study.description}
        </p>

        <div class="mt-auto flex items-end justify-between gap-4 border-t border-border pt-5 sm:pt-6">
          <div class="min-w-0">
            <span
              data-metric={story.metric.value}
              class="block text-[clamp(1.625rem,1.2vw+1.1rem,2.125rem)] font-bold leading-none tracking-[-0.02em] text-foreground [font-variant-numeric:tabular-nums]"
            >
              <span class="sr-only">
                {STORY_STEPS.outcome}: {story.metric.value}
              </span>
              <span aria-hidden="true" data-metric-display>
                {story.metric.value}
              </span>
            </span>
            {/* Same two-line floor as the title: the block is bottom-aligned,
                so a label that wraps would lift its number off the row. */}
            <p class="mt-2 line-clamp-2 min-h-[2.6em] max-w-[24ch] text-[12.5px] font-medium leading-snug text-muted sm:text-[13px]">
              {story.metric.label}
            </p>
          </div>

          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border text-foreground transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-white">
            <span class="sr-only">Read story</span>
            <ArrowUpRight class="h-4 w-4" />
          </span>
        </div>
      </div>
    </a>
  )
}
