---
import { ArrowUpRight } from "@lucide/astro";
import { cn } from "@/lib/utils";
import type { CaseStudyItem } from "@/types";
import { STORY_STEPS, WORK_STORIES } from "../constants";

/** Port of StoryCard in selected-work.tsx. */
interface Props {
  study: CaseStudyItem;
  index: number;
  total: number;
  duplicate?: boolean;
}

const { study, index, total, duplicate = false } = Astro.props;
const story = WORK_STORIES[study.id];
---

{
  story && (
    <a
      href={study.href}
      tabindex={duplicate ? -1 : undefined}
      class={cn(
        "group relative flex w-[calc(100vw-4.5rem)] shrink-0 snap-start flex-col overflow-hidden surface-card p-5",
        "sm:w-96 sm:snap-align-none sm:p-6.5 lg:w-108 lg:p-7",
        "transition-[transform,border-color,box-shadow] duration-300 ease-[cubic-bezier(.22,1,.36,1)]",
        "hover:border-accent/45 hover:shadow-soft [@media(hover:hover)]:hover:-translate-y-1",
      )}
    >
      <span
        aria-hidden="true"
        class="absolute inset-x-0 top-0 z-20 h-0.5 origin-left scale-x-0 bg-accent transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-x-100"
      />

      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-[48%] overflow-hidden"
      >
        <img
          src={study.image}
          alt=""
          sizes="(max-width: 640px) 336px, 432px"
          class="absolute inset-0 h-full w-full object-cover object-bottom opacity-[0.16]"
          loading={duplicate ? "lazy" : "eager"}
          decoding="async"
          draggable="false"
        />
        <div class="absolute inset-0 bg-linear-to-t from-card/45 via-card/80 to-card" />
      </div>

      <div class="relative z-10 flex min-h-0 flex-1 flex-col">
        <div class="flex items-center justify-between gap-4">
          <span class="inline-flex items-center rounded-pill-category border border-border bg-hairline-soft px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-accent transition-colors duration-300 group-hover:border-accent/40">
            {study.category}
          </span>
          <span
            class="shrink-0 text-[11px] font-semibold tracking-[0.18em] text-muted-light [font-variant-numeric:tabular-nums]"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, "0")}
            <span class="text-muted-light/60">
              /{String(total).padStart(2, "0")}
            </span>
          </span>
        </div>

        <h3 class="mt-4 line-clamp-2 min-h-[2.6em] text-[17px] font-semibold leading-[1.3] tracking-[-0.01em] text-foreground sm:text-[18px]">
          {study.title}
        </h3>

        <div class="relative mt-5">
          <span
            class="absolute left-[6.5px] top-2 bottom-2 w-px bg-border"
            aria-hidden="true"
          />
          <ol class="space-y-4">
            <li class="relative pl-7">
              <span
                class="absolute left-0.75 top-1.75 h-2 w-2 rounded-full bg-border ring-4 ring-card transition-colors duration-500 group-hover:bg-accent"
                aria-hidden="true"
              />
              <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-light sm:text-[11px]">
                {STORY_STEPS.problem}
              </span>
              <p class="mt-1.5 text-[14px] leading-[1.6] text-muted sm:text-[14.5px]">
                {story.problem}
              </p>
            </li>
            <li class="relative pl-7">
              <span
                class="absolute left-0.75 top-1.75 h-2 w-2 rounded-full bg-border ring-4 ring-card transition-colors duration-500 group-hover:bg-accent"
                aria-hidden="true"
              />
              <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-light sm:text-[11px]">
                {STORY_STEPS.built}
              </span>
              <p class="mt-1.5 text-[14px] leading-[1.6] text-muted sm:text-[14.5px]">
                {story.built}
              </p>
            </li>
          </ol>
        </div>

        <div class="mt-auto pt-6">
          <div class="flex items-end justify-between gap-5 border-t border-border pt-5">
            <div class="min-w-0">
              <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-light sm:text-[11px]">
                {STORY_STEPS.outcome}
              </span>
              <span
                data-metric={story.metric.value}
                class="mt-2 block text-[clamp(1.75rem,1.4vw+1.15rem,2.375rem)] font-bold leading-none tracking-[-0.02em] text-foreground [font-variant-numeric:tabular-nums]"
              >
                <span class="sr-only">{story.metric.value}</span>
                <span aria-hidden="true" data-metric-display>
                  {story.metric.value}
                </span>
              </span>
              <p class="mt-2 max-w-[26ch] text-[13.5px] font-medium leading-snug text-muted">
                {story.metric.label}
              </p>
            </div>

            <span class="inline-flex shrink-0 items-center gap-1.5 pb-0.5 text-[13px] font-semibold text-foreground transition-colors duration-300 group-hover:text-accent">
              Read story
              <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
            </span>
          </div>
        </div>
      </div>
    </a>
  )
}
