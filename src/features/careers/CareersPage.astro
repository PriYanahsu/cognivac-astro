---
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";
import RoleList from "./components/RoleList.astro";
import { BENEFITS, ROLES, WHAT_ITS_LIKE } from "./constants";

/** Port of features/careers/index.tsx. */
---

<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Careers", path: "/careers" },
  ])}
/>

<PageHero
  label="Careers"
  title="Engineering for clients who actually put it into production"
  description="Cognivac is a services company, which means our engineers ship into other people's businesses. It is harder than building for yourself, and you learn faster."
  breadcrumbs={[{ label: "Careers" }]}
  primaryCta={{ label: "See open roles", href: "#open-roles" }}
  secondaryCta={{ label: "Ask us anything", href: NAV_ROUTES.contact }}
  highlights={["Remote-first", `${ROLES.length} open roles`, "No take-home marathons"]}
/>

<section class="bg-background section-padding">
  <Container>
    <SectionIntro
      label="What It Is Like"
      title="Client work, without the agency compromises"
      titleClass="max-w-[24ch]"
    />

    <div class="card-grid md:grid-cols-3">
      {
        WHAT_ITS_LIKE.map((item, i) => (
          <FadeIn delay={0.08 * (i + 1)} class="h-full">
            <div class="group flex h-full flex-col overflow-hidden rounded-md border border-border bg-card transition-[border-color,box-shadow] duration-300 hover:border-accent/40 hover:shadow-soft">
              <div
                class="h-22 w-full transition-transform duration-500 ease-out group-hover:scale-105 sm:h-35"
                style={`background:${item.art}`}
              />
              <div class="flex flex-1 flex-col p-5 sm:p-7">
                <h3 class="text-card-title text-foreground">{item.title}</h3>
                <p class="mt-2.5 copy-md sm:mt-3">{item.description}</p>
              </div>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section
  id="open-roles"
  class="relative scroll-mt-28 overflow-hidden bg-[#0f0f12] section-padding text-white"
>
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      label="Open Roles"
      title={`${ROLES.length} roles open right now`}
      description="Two conversations and one paired working session. No unpaid take-home projects, and we tell you where you stand either way."
      descriptionClass="max-w-[52ch]"
    />

    <RoleList roles={ROLES} />

    <FadeIn delay={0.2}>
      <p class="mt-8 text-[14px] leading-[1.6] text-white/75 sm:mt-10 sm:text-[15px]">
        Nothing matching your skills?{" "}
        <a
          href={NAV_ROUTES.contact}
          class="font-semibold text-white underline underline-offset-4 transition-colors hover:text-teal"
        >
          Send us a note anyway
        </a>{" "}
        — we open roles as engagements land.
      </p>
    </FadeIn>
  </Container>
</section>

<section class="border-b border-border bg-card section-padding">
  <Container>
    <SectionIntro
      label="The Practical Part"
      title="What we actually provide"
      titleClass="max-w-[20ch]"
    />

    <div class="mt-7 grid gap-x-8 gap-y-3 sm:mt-10 sm:grid-cols-2 sm:gap-y-4 lg:grid-cols-3">
      {
        BENEFITS.map((benefit, i) => (
          <FadeIn delay={0.04 * (i + 1)}>
            <div class="flex gap-3 border-t border-border pt-3 sm:pt-4">
              <span class="mt-2.25 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              <p class="text-[14.5px] leading-[1.55] text-foreground/80 sm:text-[15.5px] sm:leading-[1.6]">
                {benefit}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<CtaSection />
