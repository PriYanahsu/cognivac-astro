---
import { Check } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { CTA_CONTENT } from "../constants";

/** Port of features/cta-section/components/cta-section.tsx. */
---

<section class="bg-background section-padding">
  <Container>
    <FadeIn>
      {/* Inset dark card rather than a full-bleed band — keeps this
          distinct from the gradient-dark footer directly below. */}
      <div
        class="dot-grid relative overflow-hidden rounded-lg bg-[#1a1a1c] px-6 py-12 text-center sm:px-10 sm:py-16 lg:px-16 lg:py-20"
      >
        <div class="relative z-10 mx-auto max-w-3xl">
          <SectionLabel
            tone="accent"
            class="mb-0"
          >
            {CTA_CONTENT.label}
          </SectionLabel>
          <h2
            class="mt-5 text-[clamp(1.625rem,3.2vw+0.75rem,3.25rem)] font-bold leading-[1.1] tracking-[-0.02em] text-white"
          >
            {CTA_CONTENT.title}
          </h2>
          <p
            class="mx-auto mt-5 max-w-[56ch] text-[16px] leading-[1.6] text-white/75 sm:text-[18px]"
          >
            {CTA_CONTENT.description}
          </p>

          <div
            class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center sm:gap-4"
          >
            <GradientButton
              href={CTA_CONTENT.primaryCta.href}
              size="lg"
              class="w-full justify-center sm:w-auto"
            >
              {CTA_CONTENT.primaryCta.label}
            </GradientButton>
            <GhostButton
              href={CTA_CONTENT.secondaryCta.href}
              tone="light"
              size="lg"
              class="w-full justify-center sm:w-auto"
            >
              {CTA_CONTENT.secondaryCta.label}
            </GhostButton>
          </div>

          <ul
            class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap sm:gap-x-7 sm:gap-y-3"
          >
            {
              CTA_CONTENT.reassurances.map((item) => (
                <li class="flex items-center gap-2">
                  <Check class="h-4 w-4 shrink-0 text-teal" />
                  <span class="text-[14px] text-white/70">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </FadeIn>
  </Container>
</section>
