---
import { Check } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { CTA_CONTENT } from "../constants";

/** Port of features/cta-section/components/cta-section.tsx. */
---

<section class="border-t border-border bg-card section-padding">
  <Container>
    <FadeIn>
      {/* Inset dark card rather than a full-bleed band — keeps this
          distinct from the gradient-dark footer directly below. */}
      <div
        class="dot-grid relative overflow-hidden rounded-lg bg-[#0f0f12] px-5 py-10 text-center sm:px-10 sm:py-16 lg:px-16 lg:py-20"
      >
        <div class="relative z-10 mx-auto max-w-3xl">
          <SectionLabel
            tone="accent"
            class="mb-0"
          >
            {CTA_CONTENT.label}
          </SectionLabel>
          <h2
            class="mt-3.5 text-[clamp(1.625rem,3.2vw+0.75rem,3.25rem)] font-bold leading-[1.1] tracking-[-0.02em] text-white sm:mt-5"
          >
            {CTA_CONTENT.title}
          </h2>
          <p
            class="mx-auto mt-3.5 max-w-[56ch] text-[14.5px] leading-[1.55] text-white/85 sm:mt-5 sm:text-[18px] sm:leading-[1.6]"
          >
            {CTA_CONTENT.description}
          </p>

          <div
            class="mt-7 flex flex-col items-stretch justify-center gap-3 sm:mt-8 sm:flex-row sm:items-center sm:gap-4"
          >
            <GradientButton
              href={CTA_CONTENT.primaryCta.href}
              size="lg"
              class="w-full justify-center hover:bg-white hover:text-accent sm:w-auto"
            >
              {CTA_CONTENT.primaryCta.label}
            </GradientButton>
            <GhostButton
              href={CTA_CONTENT.secondaryCta.href}
              tone="light"
              size="lg"
              class="w-full justify-center sm:w-auto"
            >
              {CTA_CONTENT.secondaryCta.label}
            </GhostButton>
          </div>

          <ul
            class="mx-auto mt-7 flex w-fit flex-col items-start justify-center gap-2.5 text-left sm:mt-9 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-7 sm:gap-y-3 sm:text-center"
          >
            {
              CTA_CONTENT.reassurances.map((item) => (
                <li class="flex items-start gap-2 sm:items-center">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-teal sm:mt-0" />
                  <span class="text-[13.5px] leading-snug text-white/80 sm:text-[14px]">
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </FadeIn>
  </Container>
</section>
