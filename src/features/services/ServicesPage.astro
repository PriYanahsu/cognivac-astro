---
import { ArrowUpRight } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import AnchorRail from "@/components/shared/AnchorRail.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { SERVICES } from "@/features/home/constants/content";
import { PROCESS_STEPS } from "@/features/process-section/constants";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import HashRedirect from "@/components/shared/HashRedirect.astro";
import { NAV_ROUTES } from "@/constants/site";
import {
  DELIVERABLES,
  ENGAGEMENT_MODELS,
  SERVICE_ANCHOR_REDIRECTS,
} from "./constants";

/** Port of features/services/index.tsx. */
---

<HashRedirect map={SERVICE_ANCHOR_REDIRECTS} />


<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
  ])}
/>

<PageHero
  label="Services"
  title="Software engineering, with AI built into the work"
  description="We are a services company, not a product vendor. Cognivac designs, builds, integrates, and supports custom systems — and applies AI where it changes a number you already track."
  breadcrumbs={[{ label: "Services" }]}
  primaryCta={{ label: "Scope your project", href: NAV_ROUTES.contact }}
  secondaryCta={{ label: "See the outcomes", href: NAV_ROUTES.caseStudies }}
  highlights={["Discovery in 2 weeks", "First milestone in 4–6", "You own the code"]}
/>

<section class="bg-background section-padding">
  <Container>
    <SectionIntro
      label="What We Build"
      title="Six capabilities, and exactly what each one ships"
      description="Most engagements combine two or three of these. We scope the combination against your constraints, not a service catalogue."
      titleClass="max-w-[24ch]"
      descriptionClass="max-w-[54ch]"
    />

    <AnchorRail
      ariaLabel="Capabilities"
      items={SERVICES.map((service) => ({
        id: service.id,
        label: service.title,
      }))}
      class="mt-6 sm:mt-8"
    />

    <div class="card-grid md:grid-cols-2">
      {
        SERVICES.map((service, i) => (
          <FadeIn delay={0.06 * (i + 1)} class="h-full">
            <article
              id={service.id}
              class="group flex h-full scroll-mt-44 flex-col rounded-md border border-border bg-card p-5 transition-[border-color,box-shadow,transform] duration-300 hover:border-accent/40 hover:shadow-soft sm:p-8 [@media(hover:hover)]:hover:-translate-y-1"
            >
              <div class="flex items-baseline gap-3">
                <span
                  aria-hidden="true"
                  class="shrink-0 text-[11px] font-bold tracking-[0.16em] text-muted-light transition-colors duration-300 group-hover:text-accent [font-variant-numeric:tabular-nums]"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="text-card-title text-foreground">{service.title}</h3>
              </div>
              <p class="mt-2.5 copy-md sm:mt-3">{service.description}</p>

              {DELIVERABLES[service.id] && (
                <ul class="mt-4 space-y-2 border-t border-border pt-4 sm:mt-5 sm:pt-5">
                  {DELIVERABLES[service.id].map((line) => (
                    <li class="flex gap-2.5 text-[13.5px] leading-[1.55] text-foreground/75 sm:text-[14.5px]">
                      <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                      {line}
                    </li>
                  ))}
                </ul>
              )}

              <a
                href={service.href}
                class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[13.5px] font-semibold text-foreground transition-colors hover:text-accent sm:pt-6"
              >
                Open this capability
                <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </a>
            </article>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="relative overflow-hidden bg-[#0f0f12] section-padding text-white">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label="How Delivery Runs"
      title="The same five stages on every engagement"
      description="No surprises about who owns what, or what ships next."
      descriptionClass="max-w-[600px]"
    />

    <div class="mt-8 grid gap-3 sm:mt-14 sm:grid-cols-2 sm:gap-5 lg:grid-cols-5 lg:gap-4">
      {
        PROCESS_STEPS.map((step, i) => (
          <FadeIn delay={0.06 * (i + 1)} class="h-full">
            <div class="group relative h-full overflow-hidden rounded-md border border-white/12 bg-white/[0.04] p-4 transition-colors duration-300 hover:border-white/25 hover:bg-white/[0.07] sm:p-6">
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-teal transition-transform duration-500 ease-out group-hover:scale-x-100"
              />
              <span class="text-[11px] font-bold tracking-[0.16em] text-teal sm:text-[12px]">
                {step.index}
              </span>
              <h3 class="mt-2.5 text-[16px] font-bold leading-tight tracking-[-0.02em] text-white sm:mt-3 sm:text-heading-md">
                {step.title}
              </h3>
              <p class="mt-2 text-[13.5px] leading-[1.55] text-white/80 sm:mt-2.5 sm:text-[14px] sm:leading-[1.6]">
                {step.description}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="border-y border-border bg-card section-padding">
  <Container>
    <SectionIntro
      label="Engagement Models"
      title="Three ways to work with us"
      description="Teams often start fixed-scope and move to a pod once the roadmap extends past the first release."
      titleClass="max-w-[22ch]"
      descriptionClass="max-w-[52ch]"
    />

    <div class="card-grid md:grid-cols-3">
      {
        ENGAGEMENT_MODELS.map((model, i) => (
          <FadeIn delay={0.08 * (i + 1)} class="h-full">
            <div class="flex h-full flex-col rounded-md border border-border bg-background p-5 transition-[border-color,box-shadow] duration-300 hover:border-accent/40 hover:shadow-soft sm:p-8">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-accent sm:text-[12px]">
                {model.fit}
              </p>
              <h3 class="text-card-title mt-3 text-foreground sm:mt-4">
                {model.title}
              </h3>
              <p class="mt-2.5 copy-md sm:mt-3">{model.description}</p>
              <p class="mt-auto pt-5 text-[14px] font-semibold text-foreground">
                {model.band}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<CtaSection />
