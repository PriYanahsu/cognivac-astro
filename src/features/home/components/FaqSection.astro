---
import { ArrowUpRight, MessageCircleQuestion } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FaqAccordion from "@/components/shared/FaqAccordion.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { FAQ_CONTENT, FAQS } from "@/features/home/constants/content";

/** Port of features/home/components/faq-section.tsx. */
---

<section
  class="relative bg-background py-12 sm:py-18 lg:py-28"
  aria-labelledby="faq-title"
>
  <Container class="relative z-10">
    <div class="grid items-start gap-7 sm:gap-10 lg:grid-cols-12 lg:gap-16">
      <FadeIn class="lg:col-span-5">
        <SectionLabel class="mb-0">{FAQ_CONTENT.label}</SectionLabel>
        <h2
          id="faq-title"
          class="text-section-column stack-sm max-w-[16ch] text-foreground"
        >
          {FAQ_CONTENT.title}
        </h2>
        <p class="stack-md lede max-w-[42ch]">
          {FAQ_CONTENT.description}
        </p>
      </FadeIn>

      <FadeIn delay={0.1} class="lg:col-span-7 lg:row-span-2">
        <FaqAccordion items={FAQS} idPrefix="home-faq" />
      </FadeIn>

      <FadeIn delay={0.16} class="lg:col-span-5 lg:self-end">
        <div class="rounded-lg border border-border bg-card p-5 shadow-[0_20px_50px_-42px_rgba(34,32,28,0.5)] sm:p-7">
          <div class="flex items-center gap-3 sm:block">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent/8 text-accent sm:h-10 sm:w-10">
              <MessageCircleQuestion
                class="h-4.5 w-4.5 sm:h-5 sm:w-5"
                aria-hidden="true"
              />
            </span>
            <p class="text-[15.5px] font-semibold leading-snug tracking-[-0.01em] text-foreground sm:mt-4 sm:text-[16.5px]">
              Still have a question?
            </p>
          </div>
          <p class="mt-2.5 max-w-[34ch] text-[14px] leading-[1.55] text-muted sm:mt-2 sm:text-[14.5px] sm:leading-[1.6]">
            Send it over. A short reply from the people who would do the work is
            faster than more reading.
          </p>
          <GhostButton href={FAQ_CONTENT.cta.href} class="mt-4 w-full sm:mt-5 sm:w-auto">
            {FAQ_CONTENT.cta.label}
            <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
          </GhostButton>
        </div>
      </FadeIn>
    </div>
  </Container>
</section>
