---
import HeroSection from "@/features/hero-section/components/HeroSection.astro";
import ProblemSection from "@/features/problem-section/components/ProblemSection.astro";
import ServicesSection from "@/features/services-section/components/ServicesSection.astro";
import SelectedWork from "@/features/selected-work/components/SelectedWork.astro";
import StatsBand from "@/features/stats-band/components/StatsBand.astro";
import PlatformSection from "@/features/platform-section/components/PlatformSection.astro";
import WhyCognivac from "@/features/why-cognivac/components/WhyCognivac.astro";
import ProcessSection from "@/features/process-section/components/ProcessSection.astro";
import SecuritySection from "@/features/security-section/components/SecuritySection.astro";
import IndustriesShowcase from "@/features/industries-showcase/components/IndustriesShowcase.astro";
import TestimonialsSection from "@/features/testimonials-section/components/TestimonialsSection.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import FaqSection from "./components/FaqSection.astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import {
  faqSchema,
  organizationSchema,
  websiteSchema,
  serviceSchema,
} from "@/lib/seo";
import { FAQS, SERVICES } from "./constants/content";

/**
 * Port of features/home/index.tsx.
 *
 * Scroll order follows the client wireframe. Its ten numbered slots map to our
 * sections as marked below; slot 7 (Founders) has no component yet, and five
 * sections we already ship have no slot in the wireframe — they sit in that gap
 * rather than being dropped.
 *
 * Background rhythm is preserved — no two adjacent sections share a surface,
 * and the three dark bands still land on every third section:
 *   hero #FAFAFA (+ dark proof strip flush to viewport floor) · problem lavender
 *   · SERVICES DARK · selected work background · process card · PLATFORM DARK
 *   · stats card · why background · SECURITY DARK · industries background
 *   · testimonials card · faq lavender · cta background · footer gradient-dark
 */
---

<JsonLd
  data={[
    organizationSchema(),
    websiteSchema(),
    faqSchema(FAQS.map((f) => ({ question: f.question, answer: f.answer }))),
    serviceSchema(
      SERVICES.map((s) => ({
        name: s.title,
        description: s.description,
        url: s.href,
      }))
    ),
  ]}
/>

{/* Slots 1–5 are one argument in order — who we are, what goes wrong,
    what we sell, and proof it worked. Reordering one breaks the others. */}

{/* 1 · Hero — the one-line promise: AI products that actually ship.
    2 · Proof strip (delivery figures) renders inside it, flush to the
    viewport floor, so the claim is never on screen without evidence. */}
<HeroSection />

{/* 3 · Problem we solve — "AI demos are easy. Production is hard."
    Six ways a pilot dies after the demo. Names the pain, sells nothing. */}
<ProblemSection />

{/* 4 · Services — the answer to slot 3, one offer per failure. Titled by
    the buyer's situation, never by the technology behind it. */}
<ServicesSection />

{/* 5 · Selected work — proof the two slots above are not theory. A
    horizontal track of cards: the problem → what we built → the number. */}
<SelectedWork />

{/* Wireframe 6 · How we work */}
<ProcessSection />

{/* Wireframe 7 · Founders — no component for this yet.
    The five sections below have no wireframe slot; they fill this gap. */}
<PlatformSection />
<StatsBand />
<WhyCognivac />
<SecuritySection />
<IndustriesShowcase />

{/* Wireframe 8 · Testimonials */}
<TestimonialsSection />

{/* Wireframe 9 · FAQ */}
<FaqSection />

{/* Wireframe 10 · Final CTA */}
<CtaSection />
