---
import { ArrowUpRight } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema, articleSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import ChipCloud from "@/components/shared/ChipCloud.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";
import PostGrid from "./components/PostGrid.astro";
import type { BlogPost } from "./types";
import { getCollection } from "astro:content";

const collection = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const POSTS: BlogPost[] = collection.map((post) => ({
  id: post.id,
  title: post.data.title,
  excerpt: post.data.excerpt,
  image: post.data.image,
  date: post.data.date.toISOString().slice(0, 10),
  category: post.data.category,
  readingTime: post.data.readingTime,
}));

const TOPICS = [
  "AI Agents",
  "Machine Learning",
  "Generative AI",
  "Cloud & DevOps",
  "Automation",
  "Engineering Practice",
];

function formatDate(date: string) {
  return new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const [featured] = POSTS;
---

<JsonLd
  data={[
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Insights", path: "/blog" },
    ]),
    ...POSTS.map((p) =>
      articleSchema({
        title: p.title,
        description: p.excerpt,
        path: `/blog/${p.id}`,
        datePublished: p.date,
        image: p.image,
      }),
    ),
  ]}
/>

<PageHero
  label="Insights"
  title="Notes from the engineering floor"
  description="Written by the people doing the delivery — on AI systems that hold up under load, and the practices that get them there."
  breadcrumbs={[{ label: "Insights" }]}
  primaryCta={{ label: "Talk to our engineers", href: NAV_ROUTES.contact }}
  highlights={TOPICS.slice(0, 3)}
/>

{
  featured && (
    <section class="bg-background section-padding">
      <Container>
        <FadeIn>
          <article class="group relative grid overflow-hidden rounded-md border border-border bg-card transition-[border-color,box-shadow] duration-300 hover:border-accent/40 hover:shadow-soft lg:grid-cols-12">
            <div class="relative aspect-video overflow-hidden lg:col-span-6 lg:aspect-auto lg:min-h-95">
              <img
                src={featured.image}
                alt={featured.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-105"
              />
            </div>

            <div class="flex flex-col justify-center p-5 sm:p-8 lg:col-span-6 lg:p-12">
              <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                <span class="rounded-full bg-accent px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-white sm:px-3.5 sm:py-1.5 sm:text-[12px]">
                  Latest
                </span>
                <span class="text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent sm:text-[12.5px]">
                  {featured.category}
                </span>
              </div>

              <h2 class="mt-3.5 text-[clamp(1.375rem,2vw+0.9rem,2.375rem)] font-bold leading-[1.15] tracking-[-0.02em] text-foreground sm:mt-5">
                <a
                  href={`/blog/${featured.id}`}
                  class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
                >
                  {featured.title}
                </a>
              </h2>
              <p class="mt-2.5 max-w-[52ch] text-[14.5px] leading-[1.55] text-muted sm:mt-4 sm:text-[17.5px] sm:leading-[1.65]">
                {featured.excerpt}
              </p>

              <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[12.5px] text-muted sm:mt-6 sm:gap-x-4 sm:text-[13.5px]">
                <time datetime={featured.date}>{formatDate(featured.date)}</time>
                <span class="h-1 w-1 rounded-full bg-muted-light" />
                <span>{featured.readingTime}</span>
              </div>

              <span class="mt-5 inline-flex w-fit items-center gap-1.5 text-[13.5px] font-semibold text-foreground transition-colors group-hover:text-accent sm:mt-7 sm:text-[14px]">
                Read the article
                <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </span>
            </div>
          </article>
        </FadeIn>
      </Container>
    </section>
  )
}

<section class="border-y border-border bg-card section-padding">
  <Container>
    <SectionIntro
      label="More Reading"
      title="Every article, by topic"
      description={`${POSTS.length} pieces so far, each written by the engineer who did the work it describes.`}
      descriptionClass="max-w-[52ch]"
    />

    <PostGrid posts={POSTS} categories={TOPICS} />
  </Container>
</section>

<section class="relative overflow-hidden bg-[#0f0f12] py-11 text-white sm:py-16">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label="What We Write About"
      title="Six beats, all of them things we ship"
      titleClass="text-[clamp(1.375rem,2.5vw+0.75rem,2.25rem)]"
      class="max-w-2xl"
    />
    <ChipCloud
      items={TOPICS}
      tone="dark"
      class="mx-auto mt-6 max-w-2xl sm:mt-8"
    />
  </Container>
</section>

<CtaSection />
