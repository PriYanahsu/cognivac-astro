---
import { ArrowUpRight } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema, articleSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";

/** Port of features/blog/index.tsx. */

const POSTS = [
  {
    id: "1",
    title: "From copilots to agents: designing reliable autonomy",
    excerpt:
      "What separates a useful agent from a brittle demo — and the evaluation work that has to exist before you let one act on its own.",
    image: "/images/blog/post-1.webp",
    date: "2026-06-12",
    category: "AI Agents",
    readingTime: "9 min read",
  },
  {
    id: "2",
    title: "MLOps patterns that survive your first ten models",
    excerpt:
      "Evaluation, monitoring, and rollback strategies for teams whose second model exposed everything the first one let them ignore.",
    image: "/images/blog/post-2.webp",
    date: "2026-05-28",
    category: "Machine Learning",
    readingTime: "11 min read",
  },
  {
    id: "3",
    title: "Grounding GenAI without killing latency",
    excerpt:
      "Practical retrieval architecture tradeoffs for enterprise knowledge systems, and where the p95 actually goes.",
    image: "/images/blog/post-3.webp",
    date: "2026-05-04",
    category: "Generative AI",
    readingTime: "8 min read",
  },
];

const TOPICS = [
  "AI Agents",
  "Machine Learning",
  "Generative AI",
  "Cloud & DevOps",
  "Automation",
  "Engineering Practice",
];

function formatDate(date: string) {
  return new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const [featured, ...rest] = POSTS;
---

<JsonLd
  data={[
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Insights", path: "/blog" },
    ]),
    ...POSTS.map((p) =>
      articleSchema({
        title: p.title,
        description: p.excerpt,
        path: `/blog#${p.id}`,
        datePublished: p.date,
        image: p.image,
      })
    ),
  ]}
/>

<PageHero
  label="Insights"
  title="Notes from the engineering floor"
  description="Written by the people doing the delivery — on AI systems that hold up under load, and the practices that get them there."
  breadcrumbs={[{ label: "Insights" }]}
  primaryCta={{ label: "Talk to our engineers", href: NAV_ROUTES.contact }}
  highlights={TOPICS.slice(0, 3)}
/>

{/* Featured post — wide split card */}
<section class="bg-background section-padding">
  <Container>
    <FadeIn>
      <article
        id={featured.id}
        class="grid scroll-mt-32 overflow-hidden rounded-md border border-border bg-card sm:rounded-md lg:grid-cols-12"
      >
        <div class="relative aspect-16/9 lg:col-span-6 lg:aspect-auto lg:min-h-[380px]">
          <img
            src={featured.image}
            alt={featured.title}
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>

        <div class="flex flex-col justify-center p-6 sm:p-8 lg:col-span-6 lg:p-12">
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="rounded-full bg-accent px-3.5 py-1.5 text-[12px] font-semibold uppercase tracking-[0.12em] text-white"
            >
              Latest
            </span>
            <span
              class="text-[12.5px] font-semibold uppercase tracking-[0.14em] text-accent"
            >
              {featured.category}
            </span>
          </div>

          <h2
            class="mt-5 text-[clamp(1.5rem,2vw+0.9rem,2.375rem)] font-bold leading-[1.15] tracking-[-0.015em] text-foreground"
          >
            {featured.title}
          </h2>
          <p
            class="mt-4 max-w-[52ch] text-[16px] leading-[1.65] text-muted sm:text-[17.5px]"
          >
            {featured.excerpt}
          </p>

          <div
            class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13.5px] text-muted"
          >
            <time datetime={featured.date}>{formatDate(featured.date)}</time>
            <span class="h-1 w-1 rounded-full bg-muted-light"></span>
            <span>{featured.readingTime}</span>
          </div>

          <a
            href={`/blog#${featured.id}`}
            class="mt-7 inline-flex w-fit items-center gap-1.5 text-[14px] font-semibold text-foreground transition-colors hover:text-accent"
          >
            Read the article
            <ArrowUpRight class="h-4 w-4" />
          </a>
        </div>
      </article>
    </FadeIn>
  </Container>
</section>

{/* Remaining posts */}
<section class="border-y border-border bg-card section-padding">
  <Container>
    <FadeIn>
      <div class="max-w-3xl">
        <SectionLabel class="mb-0">
          More Reading
        </SectionLabel>
        <h2 class="text-section stack-sm text-foreground">Recent articles</h2>
      </div>
    </FadeIn>

    <div class="card-grid md:grid-cols-2">
      {
        rest.map((post, i) => (
          <FadeIn delay={0.08 * (i + 1)}>
            <a
              href={`/blog#${post.id}`}
              id={post.id}
              class="group flex h-full scroll-mt-32 flex-col overflow-hidden rounded-md border border-border bg-background transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-soft sm:rounded-md"
            >
              <div class="relative aspect-16/9 overflow-hidden">
                <img
                  src={post.image}
                  alt={post.title}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
              </div>

              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-accent">
                  {post.category}
                </p>
                <h3 class="mt-2.5 text-[19px] font-bold leading-snug text-foreground sm:text-[21px]">
                  {post.title}
                </h3>
                <p class="mt-3 copy-md">
                  {post.excerpt}
                </p>

                <div class="mt-auto flex flex-wrap items-center gap-x-3.5 gap-y-1.5 pt-6 text-[13px] text-muted">
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                  <span class="h-1 w-1 rounded-full bg-muted-light" />
                  <span>{post.readingTime}</span>
                </div>
              </div>
            </a>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

{/* Topics */}
<section class="relative overflow-hidden bg-[#1a1a1c] py-14 text-white sm:py-16">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <FadeIn>
      <div class="mx-auto max-w-2xl text-center">
        <SectionLabel
          tone="accent"
          class="mb-0"
        >
          What We Write About
        </SectionLabel>
        <ul class="mt-6 flex flex-wrap justify-center gap-2.5">
          {
            TOPICS.map((topic) => (
              <li class="rounded-full border border-white/15 bg-white/[0.06] px-4 py-2 text-[13.5px] font-medium text-white/75">
                {topic}
              </li>
            ))
          }
        </ul>
      </div>
    </FadeIn>
  </Container>
</section>

<CtaSection />
