---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { HERO_CONTENT } from "@/features/hero-section/constants";
import HeroNetworkBg from "./HeroNetworkBg.astro";
import HeroVisual from "./HeroVisual.astro";
import ProofStrip from "./ProofStrip.astro";

/**
 * Two-column hero: copy left, circular visual right.
 *
 * The centred version had every line finding its own axis — eyebrow, three
 * headline lines, three deck lines, and a button pair each centred on the
 * page, so the reader's eye restarted seven times on the way down. Left
 * alignment gives all seven one shared edge, and the column that frees up on
 * the right is what the visual fills.
 */
---

<section
  class="relative flex flex-col overflow-hidden bg-[#FAFAFA] pt-[5.5rem] sm:min-h-dvh sm:pt-[6rem] lg:pt-[7rem]"
>
  <HeroNetworkBg />

  <div class="relative z-10 flex min-h-0 flex-1 flex-col">
    {/*
      The panel is positioned against this wrapper rather than against the
      section, so it stops at the proof strip instead of running under it —
      and it sits outside `Container`, because the whole point is to escape
      the container's gutter and reach the window edge.
    */}
    <div class="relative flex flex-1 flex-col justify-center">
      <HeroVisual variant="panel" />

      <Container class="relative z-10 pb-10 sm:pb-14 lg:pb-20">
        {/*
          One column from `lg` up: the visual is out of the flow by then, so
          the copy is holding half the width on its own rather than sharing a
          grid with anything.
        */}
        <div class="grid items-center gap-8 sm:gap-12 lg:block">
          <FadeIn class="text-left lg:w-[56%] lg:pr-6 xl:pr-14">
            <SectionLabel tone="primary" class="mb-0 block pl-0">
              <span class="sm:hidden">{HERO_CONTENT.labelShort}</span>
              <span class="hidden sm:inline">{HERO_CONTENT.label}</span>
            </SectionLabel>
            {/*
              `text-hero` clamps at the scale's 60px, sized for the full-width
              centred case; in a column it needs its own scale at each step, and
              three steps rather than two because `xl` starts at 1280 — a 13"
              laptop was taking the widest size against the narrowest desktop
              column and spilling the headline to four lines. Only the widest
              step, where the column is around 700px, gets the full 60px.

              Above `lg` the grid column is narrower than any `ch` cap worth
              setting, so the cap is dropped and the column is the measure.
              `text-balance` then evens the three lines out; their natural
              lengths differ by half a line otherwise.
            */}
            <h1
              class="text-hero stack-sm max-w-[18ch] text-balance text-foreground [@media(max-height:430px)]:text-[1.75rem] sm:max-w-[22ch] lg:max-w-none lg:text-[2.5rem] xl:text-[3rem] min-[87.5rem]:text-[3.75rem]"
            >
              {HERO_CONTENT.title.lead}{" "}
              <span class="text-accent">{HERO_CONTENT.title.accent}</span>{" "}
              {HERO_CONTENT.title.tail}
            </h1>
            <p
              class="stack-sm max-w-[44ch] text-pretty text-[15px] leading-[1.5] text-muted sm:stack-md sm:text-[17px] lg:max-w-[46ch] lg:text-[18px]"
            >
              {HERO_CONTENT.description}
            </p>
            {/*
              `gap-3` rather than `gap-4`, and a shared floor width on the two
              pills. The labels differ by four characters, and at hero scale two
              differently-sized capsules a full rem apart read as two unrelated
              controls instead of as one cluster with a primary in it.
            */}
            <div
              class="stack-md flex w-full flex-col items-stretch gap-2.5 sm:stack-lg sm:w-auto sm:flex-row sm:flex-wrap sm:items-center sm:justify-start sm:gap-3"
            >
              <GradientButton
                href={HERO_CONTENT.primaryCta.href}
                size="lg"
                class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto sm:min-w-[13.75rem]"
              >
                {HERO_CONTENT.primaryCta.label}
              </GradientButton>
              <GhostButton
                href={HERO_CONTENT.secondaryCta.href}
                size="lg"
                class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto sm:min-w-[13.75rem]"
              >
                {HERO_CONTENT.secondaryCta.label}
              </GhostButton>
            </div>
            <p class="stack-sm text-[13px] leading-[1.4] text-muted-light">
              {HERO_CONTENT.ctaNote}
            </p>
          </FadeIn>

          <FadeIn delay={0.15} class="lg:hidden">
            <HeroVisual variant="card" />
          </FadeIn>
        </div>
      </Container>
    </div>

    <ProofStrip />
  </div>
</section>
