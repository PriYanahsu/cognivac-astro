---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { HERO_CONTENT } from "@/features/hero-section/constants";
import HeroNetworkBg from "./HeroNetworkBg.astro";
import ProofStrip from "./ProofStrip.astro";

/** Port of features/hero-section/components/hero-section.tsx. */
---

<section
  class="relative flex flex-col overflow-hidden bg-[#FAFAFA] pt-[5.5rem] sm:min-h-dvh sm:pt-[6rem] lg:pt-[8rem]"
>
  <HeroNetworkBg />

  <div class="relative z-10 flex min-h-0 flex-1 flex-col">
    <Container class="flex flex-1 flex-col pb-10 sm:justify-center sm:pb-16 lg:pb-20">
      <div class="mx-auto max-w-6xl text-center">
        <FadeIn>
          <SectionLabel tone="primary" class="mb-0 block pl-0">
            <span class="sm:hidden">{HERO_CONTENT.labelShort}</span>
            <span class="hidden sm:inline">{HERO_CONTENT.label}</span>
          </SectionLabel>
          <h1
            class="text-hero stack-sm mx-auto max-w-[26ch] leading-[1.05] text-foreground sm:max-w-[36ch] sm:leading-[1.08] sm:text-balance lg:text-[3.375rem] xl:text-[3.75rem]"
          >
            {HERO_CONTENT.title}
          </h1>
          <p class="stack-sm mx-auto max-w-[36ch] text-[14px] leading-[1.5] text-balance text-muted sm:stack-md sm:max-w-[54ch] sm:text-body-lg lg:text-[17px] lg:leading-[1.6]">
            {HERO_CONTENT.description}
          </p>
          {/*
            `gap-3` rather than `gap-4`, and a shared floor width on the two
            pills. The labels differ by four characters, and at hero scale two
            differently-sized capsules a full rem apart read as two unrelated
            controls instead of as one cluster with a primary in it.
          */}
          <div
            class="stack-md flex w-full flex-col items-stretch justify-center gap-2.5 sm:stack-xl sm:w-auto sm:flex-row sm:flex-wrap sm:items-center sm:gap-3"
          >
            <GradientButton
              href={HERO_CONTENT.primaryCta.href}
              size="lg"
              class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto sm:min-w-[13.75rem] lg:h-16 lg:min-h-16 lg:min-w-[15rem] lg:px-10 lg:text-[17px]"
            >
              {HERO_CONTENT.primaryCta.label}
            </GradientButton>
            <GhostButton
              href={HERO_CONTENT.secondaryCta.href}
              size="lg"
              class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto sm:min-w-[13.75rem] lg:h-16 lg:min-h-16 lg:min-w-[15rem] lg:px-10 lg:text-[17px]"
            >
              {HERO_CONTENT.secondaryCta.label}
            </GhostButton>
          </div>
          <p class="stack-xs text-center text-[12px] leading-snug text-muted-light sm:stack-sm sm:text-[13px] lg:text-[14px]">
            {HERO_CONTENT.ctaNote}
          </p>
        </FadeIn>
      </div>
    </Container>

    <ProofStrip />
  </div>
</section>
