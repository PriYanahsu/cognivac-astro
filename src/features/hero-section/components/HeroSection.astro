---
import { Plus } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { HERO_CONTENT } from "@/features/hero-section/constants";
import HeroNetworkBg from "./HeroNetworkBg.astro";
import HeroArchitecture from "./HeroArchitecture.astro";
import ProofStrip from "./ProofStrip.astro";

/** Port of features/hero-section/components/hero-section.tsx. */
---

<section
  class="relative flex flex-col overflow-hidden bg-[#FAFAFA] pt-[5.5rem] sm:min-h-dvh sm:pt-[6rem] lg:pt-[8rem]"
>
  <HeroNetworkBg />

  <div class="relative z-10 flex min-h-0 flex-1 flex-col">
    <Container class="flex flex-1 flex-col pb-4 sm:justify-center sm:pb-8">
      <div class="mx-auto max-w-6xl text-center">
        <FadeIn>
          <SectionLabel tone="primary" class="mb-0 block pl-0">
            <span class="sm:hidden">{HERO_CONTENT.labelShort}</span>
            <span class="hidden sm:inline">{HERO_CONTENT.label}</span>
          </SectionLabel>
          <h1
            class="text-hero stack-sm mx-auto max-w-[26ch] leading-[1.05] text-foreground sm:max-w-[36ch] sm:leading-[1.08] sm:text-balance"
          >
            {HERO_CONTENT.title}
          </h1>
          <p class="stack-sm mx-auto max-w-[36ch] text-[14px] leading-[1.5] text-muted sm:stack-md sm:max-w-2xl sm:text-body-lg">
            {HERO_CONTENT.description}
          </p>
          <div
            class="stack-sm flex w-full flex-col items-stretch justify-center gap-2 sm:stack-lg sm:w-auto sm:flex-row sm:flex-wrap sm:items-center sm:gap-4"
          >
            <GradientButton
              href={HERO_CONTENT.primaryCta.href}
              size="lg"
              class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto"
            >
              {HERO_CONTENT.primaryCta.label}
            </GradientButton>
            <GhostButton
              href={HERO_CONTENT.secondaryCta.href}
              size="lg"
              class="h-12 min-h-12 w-full justify-center sm:h-14 sm:min-h-14 sm:w-auto"
            >
              {HERO_CONTENT.secondaryCta.label}
            </GhostButton>
          </div>
          <p class="stack-xs text-center text-[12px] leading-snug text-muted-light sm:text-[13px]">
            {HERO_CONTENT.ctaNote}
          </p>
          <div class="stack-sm flex justify-center sm:stack-lg">
            <a
              href={HERO_CONTENT.trustedHref}
              data-hero-hash
              class="group inline-flex max-w-full flex-nowrap items-center justify-center gap-x-2 rounded-full border border-border/80 bg-white/70 px-2 py-1.5 text-foreground/80 shadow-sm backdrop-blur-sm transition-colors duration-300 hover:border-accent/35 hover:text-foreground sm:gap-3.5 sm:px-4 sm:py-2"
            >
              {/* Decorative. The names behind these faces are not public, so
                  `title` was announcing nothing on desktop and nothing at all
                  on touch — the sentence beside it carries the whole claim. */}
              <div class="flex -space-x-2" aria-hidden="true">
                {
                  HERO_CONTENT.trustedAvatars.map((avatar) => (
                    <span
                      class="relative flex h-7 w-7 overflow-hidden rounded-full border-2 border-white shadow-sm transition-transform duration-300 group-hover:-translate-y-0.5 sm:h-9 sm:w-9"
                    >
                      <img
                        src={avatar.image}
                        alt=""
                        class="absolute inset-0 h-full w-full object-cover"
                        width="36"
                        height="36"
                        loading="eager"
                        decoding="async"
                      />
                    </span>
                  ))
                }
                <span
                  class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-white text-foreground shadow-sm transition-transform duration-300 group-hover:-translate-y-0.5 sm:h-9 sm:w-9"
                >
                  <Plus class="h-3.5 w-3.5 sm:h-4 sm:w-4" />
                </span>
              </div>
              <p class="whitespace-nowrap text-[11.5px] sm:text-body-md">
                {HERO_CONTENT.trustedText}
              </p>
            </a>
          </div>
        </FadeIn>
      </div>

      <FadeIn delay={0.15}>
        <HeroArchitecture />
      </FadeIn>
    </Container>

    <ProofStrip />
  </div>
</section>

<script>
  function initHeroHashes() {
    document.querySelectorAll<HTMLAnchorElement>("[data-hero-hash]").forEach((link) => {
      if (link.dataset.ready === "true") return;
      link.dataset.ready = "true";

      link.addEventListener("click", (event) => {
        const id = link.hash.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;

        event.preventDefault();
        const lenis = (window as Window & { lenis?: { scrollTo: (el: HTMLElement) => void } }).lenis;
        if (lenis) lenis.scrollTo(target);
        else target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  }

  initHeroHashes();
  document.addEventListener("astro:page-load", initHeroHashes);
</script>
