---
import { HERO_CONTENT } from "@/features/hero-section/constants";

/**
 * The hero's right column: the render dissolved into the page, inside a thin
 * orbital ring.
 *
 * The two framed versions of this — a white ring, then a ring wrapped in
 * cobalt arcs — both fought the render instead of carrying it. It is a pale,
 * airy drawing on a white ground, and a hard edge around it does two things:
 * it puts the heaviest element of the whole hero on the far side of the page
 * from the headline, and it fences off the network canvas so the two
 * drawings, which are the same drawing, stop meeting.
 *
 * So: no edge. The render is masked out to nothing before it reaches its own
 * boundary, and the only drawn lines are two hairline rings with three nodes
 * riding the outer one — the same nodes-on-edges vocabulary as the canvas
 * behind it, at a scale you read as structure rather than as decoration.
 */

/** Feathered well inside the crop: the render's own corners are white, and a
 *  mask that ends at the edge would leave them as a visible square. */
const FEATHER =
  "radial-gradient(circle at 50% 50%, #000 54%, rgba(0,0,0,0.88) 66%, transparent 80%)";
---

<div
  class="relative mx-auto aspect-square w-full max-w-[20rem] sm:max-w-[24rem] lg:max-w-[26rem] xl:max-w-[30rem]"
>
  {/* The light the render sits in. Warm-side cobalt top-left, sky bottom-right
      — two sources rather than one flat halo, so the column has a direction. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-[6%] left-[2%] h-[62%] w-[62%] rounded-full bg-accent/12 blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-[2%] bottom-[4%] h-[52%] w-[52%] rounded-full bg-teal/10 blur-3xl"
  >
  </div>

  <img
    src={HERO_CONTENT.visual.image}
    alt={HERO_CONTENT.visual.alt}
    class="absolute inset-[6%] h-[88%] w-[88%] object-cover object-center"
    style={`mask-image:${FEATHER};-webkit-mask-image:${FEATHER}`}
    width="960"
    height="640"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 400 400"
    fill="none"
  >
    {/* Inner ring, dashed and barely there — it reads as the edge the render
        no longer has, without drawing one. */}
    <circle
      cx="200"
      cy="200"
      r="152"
      stroke="var(--accent)"
      stroke-opacity="0.13"
      stroke-width="1"
      stroke-dasharray="2 7"
    ></circle>

    {/* Outer ring and its three nodes, turning as one group. A minute and a
        half a revolution: the nodes have plainly moved if you look back at
        them, and never catch your eye while you are reading. */}
    <g class="hero-orbit">
      <circle
        cx="200"
        cy="200"
        r="188"
        stroke="var(--accent)"
        stroke-opacity="0.2"
        stroke-width="1"
      ></circle>
      <circle cx="388" cy="200" r="5.5" fill="var(--accent)"></circle>
      <circle cx="106" cy="362.8" r="4" fill="var(--indigo)" fill-opacity="0.7"></circle>
      <circle cx="106" cy="37.2" r="3" fill="var(--teal)" fill-opacity="0.8"></circle>
    </g>
  </svg>
</div>
