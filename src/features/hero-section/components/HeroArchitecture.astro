---
import { Cpu, Layers, Rocket, ScanSearch } from "@lucide/astro";
import {
  HERO_PIPELINE,
  HERO_STAGES,
} from "@/features/hero-section/constants";

/**
 * Glanceable delivery path under the hero. Distinct icons, a cobalt rail,
 * and a live last stage — not four identical bullseyes on a dashed line.
 * The five-step engagement story still lives in ProcessSection.
 */
const ICONS = {
  ScanSearch,
  Layers,
  Cpu,
  Rocket,
} as const;

const lastIndex = HERO_STAGES.length - 1;
---

{/*
  `data-hero-pipeline` is the hook globals.css uses to drop this card on short
  laptop viewports. On phones the hero is content-height (not min-h-dvh), so
  this card sits in the first screen with the copy. From `sm` up the section
  is a full viewport column, and under ~800px of height the card and the
  proof strip fight for the fold — this is the one that gives way.
  ProcessSection tells the same story further down, at length.
*/}
<div data-hero-pipeline class="relative mx-auto mt-4 w-full max-w-5xl sm:mt-8 lg:mt-10">
  <div
    class="overflow-hidden rounded-2xl border border-border/90 bg-white/80 shadow-soft backdrop-blur-md"
  >
    <div
      class="flex items-center justify-between gap-2 border-b border-border/70 px-3.5 py-2.5 sm:gap-3 sm:px-6 sm:py-3"
    >
      <p class="min-w-0 truncate text-[10px] font-semibold uppercase tracking-[0.12em] text-muted-light sm:text-eyebrow">
        {HERO_PIPELINE.label}
      </p>
      <a
        href={HERO_PIPELINE.cta.href}
        data-hero-hash
        class="shrink-0 text-[11.5px] font-semibold text-accent transition-colors duration-300 hover:text-indigo sm:text-[13px]"
      >
        {HERO_PIPELINE.cta.label}
        <span aria-hidden="true"> →</span>
      </a>
    </div>

    <div class="px-3 py-4 sm:px-4 sm:py-7 lg:px-8">
      <div class="relative">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute top-5 right-[12.5%] left-[12.5%] h-0.5 -translate-y-1/2 overflow-hidden rounded-full sm:top-6"
        >
          <span class="absolute inset-0 bg-foreground/12"></span>
          <span class="hero-rail-fill absolute inset-y-0 left-0 rounded-full"></span>
          <span class="hero-rail-sheen absolute inset-y-0 rounded-full"></span>
          <span
            class="hero-rail-packet absolute top-1/2 h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-accent"
          ></span>
          <span
            class="hero-rail-packet hero-rail-packet-2 absolute top-1/2 h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-ink"
          ></span>
        </div>

        <ol class="relative grid grid-cols-4 gap-0">
          {
            HERO_STAGES.map((stage, i) => {
              const Icon = ICONS[stage.icon];
              const isLast = i === lastIndex;

              return (
                <li class="relative z-10 flex flex-col items-center text-center">
                  <span
                    class:list={[
                      "relative flex h-10 w-10 items-center justify-center rounded-full ring-4 ring-white sm:h-12 sm:w-12",
                      isLast
                        ? "bg-accent text-white shadow-glow"
                        : "border border-foreground/12 bg-white text-foreground",
                    ]}
                  >
                    {isLast && (
                      <span
                        aria-hidden="true"
                        class="hero-node-halo absolute -inset-1 rounded-full bg-accent/20"
                      />
                    )}
                    <Icon class="relative h-4 w-4 sm:h-5 sm:w-5" />
                  </span>
                  <span class="mt-2 flex flex-col items-center sm:mt-3">
                    <span class="text-[10px] font-semibold tracking-[0.1em] text-muted-light uppercase sm:tracking-[0.12em]">
                      {stage.index}
                    </span>
                    <span class="mt-0.5 text-[12px] font-semibold tracking-[-0.02em] text-foreground sm:mt-1 sm:text-[15px]">
                      {stage.label}
                    </span>
                  </span>
                  <span class="mt-0.5 hidden max-w-[18ch] text-[12.5px] leading-snug text-muted-light sm:block">
                    {stage.detail}
                  </span>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </div>
</div>
