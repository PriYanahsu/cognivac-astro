---
import { PROOF_STRIP } from "@/features/hero-section/constants";

/**
 * Port of features/hero-section/components/proof-strip.tsx.
 *
 * The hero's closing line of figures. Not a band — it has no ground and no
 * rule of its own; it sits on the hero's. Stats scroll RTL in an infinite
 * loop; the track is duplicated so a -50% translate loops cleanly.
 *
 * The motion is deliberate and deliberately slow — see `.proof-strip-track`
 * in globals.css, which also parks the loop on hover. These numbers are the
 * page's only evidence for the claim above them, so they have to stay
 * readable; the drift is there for life, not to move content past an edge.
 */

const { stats } = PROOF_STRIP;
const loop = [...stats, ...stats];
---

<div
  class="relative w-full overflow-hidden py-3.5 pb-[max(0.875rem,env(safe-area-inset-bottom))] sm:py-7 sm:pb-7 lg:py-9 lg:pb-9"
  aria-label={PROOF_STRIP.label}
>
  {/* No ground of its own, and no rule above it. This sits inside the hero
      section, so leaving it transparent means the hero's #FAFAFA and the
      network canvas both run straight through — the figures read as the last
      line of the hero rather than as a band bolted under it. Every version
      that gave this its own surface (a near-black photograph, then white with
      hairlines, then a cobalt wash) drew a seam across the page at exactly
      the point where the eye is still travelling downward. */}
  <div class="proof-strip-marquee relative z-10">
    <dl class="proof-strip-track flex w-max items-stretch">
      {
        loop.map((stat, index) => {
          const isClone = index >= stats.length;
          return (
            <div
              class="flex w-43 shrink-0 flex-col justify-center border-r border-border/70 px-3 text-center sm:w-104 sm:px-14"
              aria-hidden={isClone ? "true" : undefined}
            >
              <dt class="text-[12.5px] font-bold tracking-tight text-foreground sm:text-xl lg:text-2xl">
                {stat.value}
              </dt>
              <dd class="mt-0.5 text-[10.5px] leading-snug text-muted sm:mt-1.5 sm:text-sm">
                {stat.detail}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</div>
