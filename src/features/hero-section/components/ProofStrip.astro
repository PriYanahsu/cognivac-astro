---
import { PROOF_STRIP } from "@/features/hero-section/constants";

/**
 * Port of features/hero-section/components/proof-strip.tsx.
 *
 * Full-bleed dark proof band. Stats scroll RTL in an infinite loop; the track
 * is duplicated so a -50% translate loops cleanly.
 *
 * The motion is deliberate and deliberately slow — see `.proof-strip-track`
 * in globals.css, which also parks the loop on hover. These numbers are the
 * page's only evidence for the claim above them, so they have to stay
 * readable; the drift is there for life, not to move content past an edge.
 */

const { stats } = PROOF_STRIP;
const loop = [...stats, ...stats];
---

<div
  class="relative w-full overflow-hidden bg-[#08080a] py-3.5 pb-[max(0.875rem,env(safe-area-inset-bottom))] sm:py-7 sm:pb-7 lg:py-9 lg:pb-9"
  aria-label={PROOF_STRIP.label}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-cover bg-center"
    style="background-image: url(/images/proof-strip-bg.webp)"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[#08080a]/35"
  >
  </div>

  <div class="proof-strip-marquee relative z-10">
    <dl class="proof-strip-track flex w-max items-stretch">
      {
        loop.map((stat, index) => {
          const isClone = index >= stats.length;
          return (
            <div
              class="flex w-43 shrink-0 flex-col justify-center border-r border-white/15 px-3 text-center sm:w-104 sm:px-14"
              aria-hidden={isClone ? "true" : undefined}
            >
              <dt class="text-[12.5px] font-bold tracking-tight text-white drop-shadow-[0_1px_8px_rgba(0,0,0,0.65)] sm:text-xl lg:text-2xl">
                {stat.value}
              </dt>
              <dd class="mt-0.5 text-[10.5px] leading-snug text-white/80 sm:mt-1.5 sm:text-sm">
                {stat.detail}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</div>
