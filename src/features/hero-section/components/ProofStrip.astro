---
import { PROOF_STRIP } from "@/features/hero-section/constants";

/**
 * Port of features/hero-section/components/proof-strip.tsx.
 *
 * Full-bleed dark proof band.
 *
 * Below `lg` the stats scroll RTL in an infinite loop and the track is
 * duplicated so a -50% translate loops cleanly. From `lg` up the loop stops
 * and the real stats sit still as an evenly divided row: a stat caught
 * half-past the edge of a moving band reads as decoration, and these numbers
 * are the page's only evidence for the claim directly above them. Five of
 * them fit a desktop row without scrolling, so nothing is gained by moving.
 *
 * The clones stay in the DOM and are hidden by CSS at `lg` — one server
 * render has to serve every viewport.
 */

const { stats } = PROOF_STRIP;
const loop = [...stats, ...stats];
const lastRealIndex = stats.length - 1;
---

<div
  class="relative w-full overflow-hidden bg-[#08080a] py-3.5 pb-[max(0.875rem,env(safe-area-inset-bottom))] sm:py-7 sm:pb-7 lg:py-9 lg:pb-9"
  aria-label={PROOF_STRIP.label}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-cover bg-center"
    style="background-image: url(/images/proof-strip-bg.png)"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[#08080a]/35"
  >
  </div>

  <div class="proof-strip-marquee relative z-10">
    <dl class="proof-strip-track flex w-max items-stretch lg:w-full">
      {
        loop.map((stat, index) => {
          const isClone = index >= stats.length;
          return (
            <div
              class="flex w-43 shrink-0 flex-col justify-center border-r border-white/15 px-3 text-center sm:w-104 sm:px-14 lg:w-auto lg:flex-1 lg:shrink lg:px-6"
              data-proof-clone={isClone ? "" : undefined}
              data-proof-last={index === lastRealIndex ? "" : undefined}
              aria-hidden={isClone ? "true" : undefined}
            >
              <dt class="text-[12.5px] font-bold tracking-tight text-white drop-shadow-[0_1px_8px_rgba(0,0,0,0.65)] sm:text-xl lg:text-2xl">
                {stat.value}
              </dt>
              <dd class="mt-0.5 text-[10.5px] leading-snug text-white/80 sm:mt-1.5 sm:text-sm">
                {stat.detail}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</div>
