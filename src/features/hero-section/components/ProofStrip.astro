---
import { PROOF_STRIP } from "@/features/hero-section/constants";

/**
 * Port of features/hero-section/components/proof-strip.tsx.
 *
 * Full-bleed dark proof band. Stats scroll RTL in an infinite loop;
 * the track is duplicated so -50% translate loops cleanly.
 */

const loop = [...PROOF_STRIP.stats, ...PROOF_STRIP.stats];
---

<div
  class="relative w-full overflow-hidden bg-[#0e0e10] py-5 sm:py-8 lg:py-10"
  aria-label={PROOF_STRIP.label}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-cover bg-center"
    style="background-image: url(/images/proof-strip-bg.png)"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[#0e0e10]/35"
  >
  </div>

  <div class="proof-strip-marquee relative z-10">
    <dl class="proof-strip-track flex w-max items-stretch">
      {
        loop.map((stat, index) => {
          const isClone = index >= PROOF_STRIP.stats.length;
          return (
            <div
              class="flex w-[min(85vw,22rem)] shrink-0 flex-col justify-center border-r border-white/15 px-8 text-center sm:w-[26rem] sm:px-14"
              aria-hidden={isClone ? "true" : undefined}
            >
              <dt class="text-base font-bold tracking-tight text-white drop-shadow-[0_1px_8px_rgba(0,0,0,0.65)] sm:text-xl lg:text-2xl">
                {stat.value}
              </dt>
              <dd class="mt-0.5 text-xs leading-snug text-white/70 sm:mt-1.5 sm:text-sm">
                {stat.detail}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</div>
