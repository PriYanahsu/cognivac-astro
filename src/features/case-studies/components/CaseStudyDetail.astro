---
import { ArrowLeft, ArrowUpRight, ChevronRight } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import {
  CASE_METRICS,
  STORY_STEPS,
  WORK_STORIES,
} from "@/features/selected-work/constants";
import { NAV_ROUTES } from "@/constants/site";
import type { CaseStudyItem } from "@/types";
import { STUDY_ART, STUDY_DETAIL, getNextStudy } from "../constants";

/**
 * Port of features/case-studies/components/case-study-detail.tsx.
 * One engagement, at length — same order as the home-track card.
 */
interface Props {
  study: CaseStudyItem;
}

const { study } = Astro.props;
const story = WORK_STORIES[study.id];
const metric = CASE_METRICS[study.id];
const detail = STUDY_DETAIL[study.id];
const next = getNextStudy(study.slug);

const beats = [
  story && { label: STORY_STEPS.problem, body: story.problem },
  story && { label: STORY_STEPS.built, body: story.built },
].filter(Boolean) as { label: string; body: string }[];
---

<section
  class="relative overflow-hidden text-white"
  style={`background:${STUDY_ART[study.id]}`}
>
  <img
    src={study.image}
    alt=""
    fetchpriority="high"
    decoding="async"
    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25"
  />
  {/* Keeps the gradient reading through the photo so white type never
      sits on a busy patch of the illustration. */}
  <div
    class="pointer-events-none absolute inset-0"
    style={`background:${STUDY_ART[study.id]};opacity:0.45`}
    aria-hidden="true"
  >
  </div>
  <div
    class="dot-grid pointer-events-none absolute inset-0 opacity-40"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-linear-to-t from-black/25 to-transparent"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10 pb-16 pt-28 sm:pb-20 sm:pt-32 lg:pb-24 lg:pt-40">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-[13px] text-white/78">
        <li>
          <a href={NAV_ROUTES.home} class="transition-colors hover:text-white">
            Home
          </a>
        </li>
        <ChevronRight class="h-3.5 w-3.5" aria-hidden="true" />
        <li>
          <a
            href={NAV_ROUTES.caseStudies}
            class="transition-colors hover:text-white"
          >
            Case Studies
          </a>
        </li>
        <ChevronRight class="h-3.5 w-3.5" aria-hidden="true" />
        <li class="text-white" aria-current="page">
          {study.category}
        </li>
      </ol>
    </nav>

    <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionLabel tone="white" class="mb-0">
          {study.category}
        </SectionLabel>
        <h1 class="stack-sm max-w-[20ch] text-[clamp(2rem,3.6vw+1rem,3.75rem)] font-bold leading-[1.05] tracking-[-0.02em]">
          {study.title}
        </h1>
        <p class="stack-md max-w-[54ch] text-[17px] leading-[1.65] text-white/88 sm:text-[19px]">
          {study.description}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <GradientButton href={NAV_ROUTES.contact}>
            Discuss a project like this
          </GradientButton>
          <GhostButton href={NAV_ROUTES.caseStudies} tone="light">
            All case studies
          </GhostButton>
        </div>
      </div>

      {
        metric && (
          <div class="lg:col-span-5 lg:pt-2">
            <div class="rounded-md border border-white/20 bg-white/10 p-7 backdrop-blur-sm sm:p-8">
              <span class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-white/78">
                {STORY_STEPS.outcome}
              </span>
              <p class="mt-3 text-[clamp(2.75rem,5vw,4rem)] font-bold leading-none tracking-[-0.02em] [font-variant-numeric:tabular-nums]">
                {metric.value}
              </p>
              <p class="mt-3 max-w-[26ch] text-[15px] font-medium leading-snug text-white/88">
                {metric.label}
              </p>
            </div>
          </div>
        )
      }
    </div>
  </Container>
</section>

{
  beats.length > 0 && (
    <section class="border-b border-border bg-card py-14 sm:py-16 lg:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
          {beats.map((beat, i) => (
            <FadeIn delay={0.06 * (i + 1)}>
              <div class="border-t-2 border-accent pt-7">
                <div class="flex items-baseline gap-3">
                  <span class="text-[12px] font-semibold tracking-[0.18em] text-muted-light [font-variant-numeric:tabular-nums]">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <h2 class="text-[12px] font-semibold uppercase tracking-[0.18em] text-muted">
                    {beat.label}
                  </h2>
                </div>
                <p class="mt-4 max-w-[46ch] text-[18px] leading-[1.55] text-foreground sm:text-[20px]">
                  {beat.body}
                </p>
              </div>
            </FadeIn>
          ))}
        </div>
      </Container>
    </section>
  )
}

<section class="bg-background section-padding">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        {
          detail && (
            <FadeIn>
              <div class="grid gap-9">
                <div>
                  <SectionLabel class="mb-0">The challenge</SectionLabel>
                  <p class="stack-sm max-w-[58ch] text-[16.5px] leading-[1.7] text-muted sm:text-[17.5px]">
                    {detail.challenge}
                  </p>
                </div>
                <div>
                  <SectionLabel class="mb-0">Our approach</SectionLabel>
                  <p class="stack-sm max-w-[58ch] text-[16.5px] leading-[1.7] text-muted sm:text-[17.5px]">
                    {detail.approach}
                  </p>
                </div>
              </div>
            </FadeIn>
          )
        }

        <FadeIn delay={0.08}>
          <div class="mt-10 overflow-hidden rounded-md border border-border">
            <div class="relative aspect-video">
              <img
                src={study.image}
                alt={study.title}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </FadeIn>
      </div>

      <aside class="lg:col-span-5">
        <FadeIn delay={0.05}>
          <div class="surface-card lg:sticky lg:top-28">
            <SectionLabel class="mb-0">What it runs on</SectionLabel>
            {
              detail && (
                <div class="stack-sm flex flex-wrap gap-2">
                  {detail.stack.map((tech) => (
                    <span class="rounded-full border border-border bg-background px-3 py-1.5 text-[12.5px] font-medium text-foreground/70">
                      {tech}
                    </span>
                  ))}
                </div>
              )
            }

            <dl class="mt-8 grid gap-5 border-t border-border pt-7">
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-light">
                  Service line
                </dt>
                <dd class="mt-1.5 text-[15px] font-medium text-foreground">
                  {study.category}
                </dd>
              </div>
              {
                metric && (
                  <div>
                    <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-light">
                      {STORY_STEPS.outcome}
                    </dt>
                    <dd class="mt-1.5 text-[15px] font-medium text-foreground">
                      {metric.value} — {metric.label}
                    </dd>
                  </div>
                )
              }
            </dl>

            <a
              href={NAV_ROUTES.contact}
              class="group mt-8 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-foreground transition-colors hover:text-accent"
            >
              Talk about a project like this
              <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
            </a>
          </div>
        </FadeIn>
      </aside>
    </div>
  </Container>
</section>

{
  next && (
    <section class="border-t border-border bg-card py-14 sm:py-16">
      <Container>
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <a
            href={NAV_ROUTES.caseStudies}
            class="group inline-flex items-center gap-2 text-[13.5px] font-semibold text-muted transition-colors hover:text-accent"
          >
            <ArrowLeft class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-0.5" />
            All case studies
          </a>

          <a href={next.href} class="group max-w-[46ch] text-right lg:ml-auto">
            <span class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-light">
              Next study
            </span>
            <span class="mt-2 inline-flex items-start gap-2 text-[clamp(1.125rem,1.2vw+0.75rem,1.625rem)] font-bold leading-[1.2] tracking-[-0.01em] text-foreground transition-colors group-hover:text-accent">
              {next.title}
              <ArrowUpRight class="mt-1 h-5 w-5 shrink-0 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
            </span>
          </a>
        </div>
      </Container>
    </section>
  )
}

<CtaSection />
