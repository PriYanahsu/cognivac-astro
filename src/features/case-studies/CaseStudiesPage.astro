---
import { ArrowUpRight } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import StatCounter from "@/components/shared/StatCounter.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { CASE_STUDIES, STATS } from "@/features/home/constants/content";
import { CASE_METRICS } from "@/features/selected-work/constants";
import { STUDY_ART, STUDY_DETAIL } from "./constants";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";
import { cn } from "@/lib/utils";

/** Port of features/case-studies/index.tsx. */

const OUTCOME_STATS = STATS.filter((s) => ["1", "2", "3"].includes(s.id));
---

<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Case Studies", path: "/case-studies" },
  ])}
/>

<PageHero
  label="Case Studies"
  title="Proof that reached production"
  description="Every engagement below is running under real load with real users. Each one lists the challenge, the approach, and the number that moved."
  breadcrumbs={[{ label: "Case Studies" }]}
  primaryCta={{ label: "Discuss a similar project", href: NAV_ROUTES.contact }}
  secondaryCta={{ label: "See our services", href: NAV_ROUTES.services }}
  highlights={["Running under real load", "You own the code"]}
/>

<section class="border-b border-border bg-card py-10 sm:py-16">
  <Container>
    <div class="grid grid-cols-3 gap-x-3 gap-y-8 sm:gap-8">
      {
        OUTCOME_STATS.map((stat, i) => (
          <FadeIn delay={0.07 * (i + 1)}>
            <StatCounter
              value={stat.value}
              suffix={stat.suffix}
              prefix={stat.prefix}
              decimals={stat.decimals}
              label={stat.label}
            />
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="bg-background section-padding">
  <Container>
    <div class="grid gap-4 sm:gap-8 lg:gap-14">
      {
        CASE_STUDIES.map((study, i) => {
          const metric = CASE_METRICS[study.id];
          const detail = STUDY_DETAIL[study.id];
          const artRight = i % 2 === 1;

          return (
            <FadeIn delay={0.05 * (i + 1)}>
              <article
                id={study.id}
                class={cn(
                  "group relative grid scroll-mt-32 overflow-hidden rounded-md border border-border bg-card lg:grid-cols-12",
                  "transition-[border-color,box-shadow,transform] duration-300 ease-[cubic-bezier(.22,1,.36,1)]",
                  "hover:border-accent/40 hover:shadow-soft [@media(hover:hover)]:hover:-translate-y-1",
                )}
              >
                <div
                  class={cn(
                    "relative flex min-h-60 flex-col justify-between overflow-hidden p-5 text-white sm:p-8 lg:col-span-5 lg:p-10",
                    artRight && "lg:order-2",
                  )}
                  style={`background:${STUDY_ART[study.id]}`}
                >
                  <div class="dot-grid pointer-events-none absolute inset-0 opacity-50" />
                  <div class="relative z-10 flex items-start justify-between gap-4">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80 sm:text-[12px]">
                      {study.category}
                    </p>
                    <span
                      class="shrink-0 text-[11px] font-semibold tracking-[0.18em] text-white/65 [font-variant-numeric:tabular-nums] sm:text-[12px]"
                      aria-hidden="true"
                    >
                      {String(i + 1).padStart(2, "0")}
                      <span class="text-white/25">
                        /{String(CASE_STUDIES.length).padStart(2, "0")}
                      </span>
                    </span>
                  </div>

                  {metric && (
                    <div class="relative z-10 mt-7 sm:mt-10">
                      <p class="text-[clamp(2.5rem,10vw,4rem)] font-bold leading-none tracking-[-0.02em] [font-variant-numeric:tabular-nums]">
                        {metric.value}
                      </p>
                      <p class="mt-2 max-w-[26ch] text-[13.5px] font-medium leading-snug text-white/88 sm:mt-2.5 sm:text-[14.5px]">
                        {metric.label}
                      </p>
                    </div>
                  )}

                  <div class="relative z-10 mt-6 overflow-hidden rounded-2xl sm:mt-8">
                    <div class="relative aspect-video">
                      <img
                        src={study.image}
                        alt={study.title}
                        class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                </div>

                <div
                  class={cn(
                    "flex flex-col justify-center p-5 sm:p-8 lg:col-span-7 lg:p-10",
                    artRight && "lg:order-1",
                  )}
                >
                  <h2 class="text-[clamp(1.375rem,1.6vw+0.9rem,2rem)] font-bold leading-[1.15] tracking-[-0.01em] text-foreground">
                    <a
                      href={study.href}
                      class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
                    >
                      {study.title}
                    </a>
                  </h2>
                  <p class="mt-2.5 max-w-[58ch] text-[14.5px] leading-[1.55] text-muted sm:mt-3.5 sm:text-[17px] sm:leading-[1.65]">
                    {study.description}
                  </p>

                  {detail && (
                    <div class="mt-5 grid gap-4 border-t border-border pt-5 sm:mt-7 sm:grid-cols-2 sm:gap-6 sm:pt-7">
                      <div>
                        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted sm:text-[12px]">
                          The challenge
                        </p>
                        <p class="mt-2 text-[13.5px] leading-[1.55] text-foreground/80 sm:mt-2.5 sm:text-[14.5px] sm:leading-[1.6]">
                          {detail.challenge}
                        </p>
                      </div>
                      <div>
                        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted sm:text-[12px]">
                          Our approach
                        </p>
                        <p class="mt-2 text-[13.5px] leading-[1.55] text-foreground/80 sm:mt-2.5 sm:text-[14.5px] sm:leading-[1.6]">
                          {detail.approach}
                        </p>
                      </div>
                    </div>
                  )}

                  {detail && (
                    <div class="mt-5 flex flex-wrap items-center gap-1.5 sm:mt-7 sm:gap-2">
                      {detail.stack.map((tech) => (
                        <span class="rounded-full border border-border bg-background px-2.5 py-1 text-[11.5px] font-medium text-foreground/70 sm:px-3 sm:py-1.5 sm:text-[12.5px]">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}

                  <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 pt-6 sm:gap-x-7 sm:gap-y-3 sm:pt-8">
                    <span class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-foreground transition-colors group-hover:text-accent">
                      Read the full story
                      <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                    </span>
                    <a
                      href={NAV_ROUTES.contact}
                      class="relative z-10 text-[13.5px] font-medium text-muted transition-colors hover:text-accent"
                    >
                      Talk about a project like this
                    </a>
                  </div>
                </div>
              </article>
            </FadeIn>
          );
        })
      }
    </div>
  </Container>
</section>

<section class="relative overflow-hidden bg-[#0f0f12] py-14 text-white sm:py-16">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label="A Note On Names"
      title="Most of our work sits under NDA"
      titleClass="text-[clamp(1.375rem,2.5vw+0.75rem,2.25rem)]"
      description="Clients are described rather than named here. On a call we can walk through the architecture in detail, and arrange reference conversations where the client has agreed to them."
      class="max-w-2xl"
    />
  </Container>
</section>

<CtaSection />
