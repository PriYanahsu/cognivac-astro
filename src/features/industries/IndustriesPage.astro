---
import { ArrowUpRight } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import AnchorRail from "@/components/shared/AnchorRail.astro";
import ChipCloud from "@/components/shared/ChipCloud.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { INDUSTRIES } from "@/features/home/constants/content";
import { INDUSTRY_DETAILS } from "@/features/industries-showcase/constants";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import HashRedirect from "@/components/shared/HashRedirect.astro";
import { NAV_ROUTES } from "@/constants/site";
import { cn } from "@/lib/utils";
import {
  ALSO_SERVED,
  INDUSTRY_ANCHOR_REDIRECTS,
  SECTOR_WORK,
} from "./constants";

/** Port of features/industries/index.tsx. */
---

<HashRedirect map={INDUSTRY_ANCHOR_REDIRECTS} />


<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Industries", path: "/industries" },
  ])}
/>

<PageHero
  label="Industries"
  title="Domain context, not just engineering capacity"
  description="Every sector has its own regulation, data reality, and definition of done. We bring engineers who already know the systems you run — so discovery starts at the real problem."
  breadcrumbs={[{ label: "Industries" }]}
  primaryCta={{ label: "Talk to a domain lead", href: NAV_ROUTES.contact }}
  secondaryCta={{ label: "Browse our work", href: NAV_ROUTES.caseStudies }}
  highlights={["Regulated-sector experience", "Systems of record, not slides"]}
/>

<section class="bg-background section-padding">
  <Container>
    <SectionIntro
      label="Sectors"
      title="Where we have already been in the systems"
      description="Four sectors we work in constantly, with the kind of engagement each one actually asks for. The list below is not the whole of it."
      titleClass="max-w-[22ch]"
      descriptionClass="max-w-[54ch]"
    />

    <AnchorRail
      ariaLabel="Sectors"
      items={INDUSTRIES.map((industry) => ({
        id: industry.id,
        label: industry.title,
      }))}
      class="mt-6 sm:mt-8"
    />

    <div class="mt-6 grid gap-4 sm:mt-8 sm:gap-8 lg:gap-10">
      {
        INDUSTRIES.map((industry, i) => (
          <FadeIn delay={0.06 * (i + 1)}>
            <article
              id={industry.id}
              class="group grid scroll-mt-44 overflow-hidden rounded-md border border-border bg-card transition-[border-color,box-shadow] duration-300 hover:border-accent/40 hover:shadow-soft lg:grid-cols-12"
            >
              <div
                class={cn(
                  "relative aspect-video overflow-hidden lg:col-span-5 lg:aspect-auto lg:min-h-80",
                  i % 2 === 1 && "lg:order-2",
                )}
              >
                <img
                  src={industry.image}
                  alt={industry.title}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <span
                  aria-hidden="true"
                  class="absolute left-4 top-4 rounded-full bg-black/45 px-2.5 py-1 text-[11px] font-bold tracking-[0.16em] text-white backdrop-blur-sm [font-variant-numeric:tabular-nums]"
                >
                  {String(i + 1).padStart(2, "0")}
                  <span class="text-white/70">
                    /{String(INDUSTRIES.length).padStart(2, "0")}
                  </span>
                </span>
              </div>

              <div
                class={cn(
                  "flex flex-col p-5 sm:p-8 lg:col-span-7 lg:p-10",
                  i % 2 === 1 && "lg:order-1",
                )}
              >
                <h3 class="text-section-column text-foreground">
                  {industry.title}
                </h3>
                <p class="mt-2.5 max-w-[54ch] text-[14.5px] leading-[1.55] text-muted sm:mt-4 sm:text-[17.5px] sm:leading-[1.65]">
                  {industry.description}
                </p>

                {INDUSTRY_DETAILS[industry.id] && (
                  <p class="mt-3 border-l-2 border-accent pl-3 text-[13.5px] font-medium leading-[1.55] text-accent sm:mt-4 sm:pl-4 sm:text-[14.5px] sm:leading-[1.6]">
                    {INDUSTRY_DETAILS[industry.id]}
                  </p>
                )}

                {SECTOR_WORK[industry.id] && (
                  <div class="mt-5 border-t border-border pt-5 sm:mt-6 sm:pt-6">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted sm:text-[12px]">
                      Typical work
                    </p>
                    <ul class="mt-3 grid gap-2.5 sm:mt-3.5 sm:grid-cols-2">
                      {SECTOR_WORK[industry.id].map((line) => (
                        <li class="flex gap-2.5 text-[13.5px] leading-[1.55] text-foreground/75 sm:text-[14.5px]">
                          <span class="mt-1.75 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                          {line}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <a
                  href={industry.href}
                  class="mt-auto inline-flex items-center gap-1.5 pt-6 text-[13.5px] font-semibold text-foreground transition-colors hover:text-accent sm:pt-7"
                >
                  {industry.title} in detail
                  <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                </a>
              </div>
            </article>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="relative overflow-hidden bg-[#0f0f12] section-padding text-white">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label="Also Delivered In"
      title="Your sector is probably on this list"
      description="If it is not, the engineering is usually transferable — the discovery phase is where we prove that."
      descriptionClass="max-w-140"
    />

    <ChipCloud
      items={ALSO_SERVED}
      tone="dark"
      class="mx-auto mt-8 max-w-4xl sm:mt-10"
    />
  </Container>
</section>

<CtaSection />
