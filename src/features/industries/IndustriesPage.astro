---
import { ArrowUpRight } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { INDUSTRIES } from "@/features/home/constants/content";
import { INDUSTRY_DETAILS } from "@/features/industries-showcase/constants";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";

/** Port of features/industries/index.tsx. */

/** Typical work per sector — proves we have been in the systems, not just the market. */
const SECTOR_WORK: Record<string, readonly string[]> = {
  fintech: [
    "Real-time fraud and risk decisioning",
    "KYC/AML document intelligence",
    "Core banking and payment rail integration",
  ],
  retail: [
    "Demand forecasting at SKU and store level",
    "Customer intelligence and personalization",
    "Inventory and supply chain optimization",
  ],
  manufacturing: [
    "Predictive maintenance on sensor streams",
    "Computer-vision quality inspection",
    "MES and plant-floor system integration",
  ],
  saas: [
    "In-product AI features and copilots",
    "Usage intelligence and churn modelling",
    "Multi-tenant platform modernization",
  ],
};

const ALSO_SERVED = [
  "Healthcare",
  "Logistics",
  "Insurance",
  "Real Estate",
  "EdTech",
  "Energy",
  "Media & Entertainment",
  "Travel & Hospitality",
  "Telecommunications",
  "Professional Services",
];
---

<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Industries", path: "/industries" },
  ])}
/>

<PageHero
  label="Industries"
  title="Domain context, not just engineering capacity"
  description="Every sector has its own regulation, data reality, and definition of done. We bring engineers who already know the systems you run — so discovery starts at the real problem."
  breadcrumbs={[{ label: "Industries" }]}
  primaryCta={{ label: "Talk to a domain lead", href: NAV_ROUTES.contact }}
  secondaryCta={{ label: "Browse our work", href: NAV_ROUTES.caseStudies }}
  highlights={["25+ industries served", "Regulated-sector experience"]}
/>

<section class="bg-background section-padding">
  <Container>
    <div class="grid gap-6 sm:gap-8 lg:gap-10">
      {
        INDUSTRIES.map((industry, i) => (
          <FadeIn delay={0.06 * (i + 1)}>
            <article
              id={industry.id}
              class="grid scroll-mt-32 overflow-hidden rounded-md border border-border bg-card sm:rounded-md lg:grid-cols-12"
            >
              <div class="relative aspect-16/9 lg:col-span-5 lg:aspect-auto lg:min-h-[320px]">
                <img
                  src={industry.image}
                  alt={industry.title}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              </div>

              <div class="flex flex-col p-6 sm:p-8 lg:col-span-7 lg:p-10">
                <h2 class="text-section text-foreground">{industry.title}</h2>
                <p class="mt-4 max-w-[54ch] text-[16px] leading-[1.65] text-muted sm:text-[17.5px]">
                  {industry.description}
                </p>

                {INDUSTRY_DETAILS[industry.id] && (
                  <p class="mt-4 text-[14.5px] font-medium leading-[1.6] text-accent">
                    {INDUSTRY_DETAILS[industry.id]}
                  </p>
                )}

                {SECTOR_WORK[industry.id] && (
                  <div class="mt-6 border-t border-border pt-6">
                    <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">
                      Typical work
                    </p>
                    <ul class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
                      {SECTOR_WORK[industry.id].map((line) => (
                        <li class="flex gap-2.5 text-[14.5px] leading-[1.55] text-foreground/75">
                          <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                          {line}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <a
                  href={NAV_ROUTES.contact}
                  class="mt-auto inline-flex items-center gap-1.5 pt-7 text-[13.5px] font-semibold text-foreground transition-colors hover:text-accent"
                >
                  Discuss {industry.title.toLowerCase()} work
                  <ArrowUpRight class="h-4 w-4" />
                </a>
              </div>
            </article>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section
  class="relative overflow-hidden bg-[#1a1a1c] section-padding text-white"
>
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <FadeIn>
      <div class="mx-auto max-w-3xl text-center">
        <SectionLabel
          tone="accent"
          class="mb-0"
        >
          Also Delivered In
        </SectionLabel>
        <h2
          class="mt-5 text-[clamp(1.625rem,3.5vw+0.75rem,3rem)] font-bold leading-[1.1] tracking-[-0.02em] text-white"
        >
          Your sector is probably on this list
        </h2>
        <p
          class="mx-auto mt-4 max-w-[560px] text-[16px] leading-[1.55] text-white/75 sm:text-[18px]"
        >
          If it is not, the engineering is usually transferable — the discovery
          phase is where we prove that.
        </p>
      </div>
    </FadeIn>

    <FadeIn delay={0.12}>
      <ul class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-2.5">
        {
          ALSO_SERVED.map((sector) => (
            <li class="rounded-full border border-white/15 bg-white/[0.06] px-4 py-2 text-[13.5px] font-medium text-white/75">
              {sector}
            </li>
          ))
        }
      </ul>
    </FadeIn>
  </Container>
</section>

<CtaSection />
