---
import { ArrowUpRight } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import PersonPortrait from "@/components/shared/PersonPortrait.astro";
import SocialIcon from "@/components/shared/SocialIcon.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { FOUNDERS, TEAM_GROUPS } from "@/constants/people";
import { NAV_ROUTES } from "@/constants/site";
import { STAFFING_RULES, TEAM_PAGE } from "./constants";
import MemberCard from "./components/MemberCard.astro";

/** Port of features/team/index.tsx. */
---

<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Team", path: "/team" },
  ])}
/>

<PageHero
  label="The Team"
  title={TEAM_PAGE.hero.title}
  description={TEAM_PAGE.hero.description}
  breadcrumbs={[{ label: "Team" }]}
  primaryCta={{ label: "Talk to a founder", href: NAV_ROUTES.contact }}
  secondaryCta={{ label: "See open roles", href: NAV_ROUTES.careers }}
  highlights={[
    "Two founders on every account",
    "Pods of two to six",
    "No juniors on billable work",
  ]}
/>

<section class="bg-background section-padding">
  <Container>
    <SectionIntro
      label={TEAM_PAGE.founders.label}
      title={TEAM_PAGE.founders.title}
      description={TEAM_PAGE.founders.description}
      titleClass="max-w-[20ch]"
      descriptionClass="max-w-[56ch]"
    />

    <div class="card-grid lg:grid-cols-2">
      {
        FOUNDERS.map((founder, i) => (
          <FadeIn delay={0.08 * (i + 1)}>
            <div class="flex h-full flex-col rounded-md border border-border bg-card p-5 transition-[border-color,box-shadow] duration-300 hover:border-accent/40 hover:shadow-soft sm:p-7">
              <div class="flex gap-4 sm:gap-5">
                <PersonPortrait
                  name={founder.name}
                  image={founder.image}
                  class="aspect-4/5 w-22 shrink-0 self-start sm:w-31"
                />

                <div class="flex min-w-0 flex-1 flex-col">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h3 class="text-[20px] font-bold leading-tight tracking-[-0.02em] text-foreground sm:text-[23px]">
                        {founder.name}
                      </h3>
                      <p class="mt-1.5 text-[13.5px] font-semibold text-accent sm:text-[14px]">
                        {founder.role}
                      </p>
                    </div>

                    {founder.linkedin && (
                      <a
                        href={founder.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${founder.name} on LinkedIn`}
                        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border text-muted transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"
                      >
                        <SocialIcon name="linkedin" class="h-[15px] w-[15px]" />
                      </a>
                    )}
                  </div>

                  <p class="mt-4 text-[15px] font-medium leading-[1.45] tracking-[-0.015em] text-foreground sm:text-[16.5px]">
                    {founder.focus}
                  </p>
                </div>
              </div>

              <p class="mt-4 text-[13.5px] leading-[1.6] text-muted sm:mt-5 sm:text-[15px] sm:leading-[1.7]">
                {founder.bio}
              </p>

              <dl class="mt-auto grid grid-cols-3 border-t border-border pt-5">
                {founder.credentials.map((credential, ci) => (
                  <div class={ci > 0 ? "border-l border-border pl-4" : "pr-4"}>
                    <dt class="text-[15px] font-bold leading-none tracking-[-0.02em] text-foreground sm:text-[17px]">
                      {credential.value}
                    </dt>
                    <dd class="mt-2 text-[10px] font-semibold uppercase leading-tight tracking-[0.12em] text-muted-light sm:text-[10.5px]">
                      {credential.label}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="border-y border-border bg-card section-padding">
  <Container>
    <SectionIntro
      label={TEAM_PAGE.bench.label}
      title={TEAM_PAGE.bench.title}
      description={TEAM_PAGE.bench.description}
      titleClass="max-w-[22ch]"
      descriptionClass="max-w-[56ch]"
    />

    <div class="mt-8 space-y-9 sm:mt-14 sm:space-y-14">
      {
        TEAM_GROUPS.map((group, groupIndex) => (
          <div>
            <FadeIn>
              <div class="max-w-[68ch]">
                <div class="flex items-baseline gap-3">
                  <h3 class="text-[17.5px] font-bold tracking-[-0.02em] text-foreground sm:text-[22px]">
                    {group.title}
                  </h3>
                  <span class="rounded-pill-category bg-hairline-soft px-2.5 py-1 text-[11px] font-semibold text-muted [font-variant-numeric:tabular-nums]">
                    {group.members.length > 0
                      ? String(group.members.length).padStart(2, "0")
                      : "Pod"}
                  </span>
                </div>
                <p class="mt-2 text-[13.5px] leading-[1.55] text-muted sm:mt-2.5 sm:text-[15px] sm:leading-[1.6]">
                  {group.summary}
                </p>
              </div>
            </FadeIn>

            <div class="mt-4 grid gap-3 sm:mt-6 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3 lg:gap-5">
              {
                group.members.length > 0 ? (
                  group.members.map((person, i) => (
                    <FadeIn delay={0.05 * i + 0.04 * groupIndex} class="h-full">
                      <MemberCard person={person} />
                    </FadeIn>
                  ))
                ) : (
                  <FadeIn class="lg:col-span-3">
                    <p class="rounded-md border border-border bg-background px-4 py-3 text-[13.5px] leading-[1.55] text-muted sm:text-[14.5px]">
                      Named on the engagement, not on this page — you meet them in discovery.
                    </p>
                  </FadeIn>
                )
              }
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<section class="relative overflow-hidden bg-[#0f0f12] section-padding text-white">
  <div
    aria-hidden="true"
    class="dot-grid pointer-events-none absolute inset-0 opacity-60"
  >
  </div>

  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label={TEAM_PAGE.staffing.label}
      title={TEAM_PAGE.staffing.title}
      description={TEAM_PAGE.staffing.description}
      descriptionClass="max-w-160"
    />

    <div class="card-grid sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        STAFFING_RULES.map((rule, i) => (
          <FadeIn delay={0.07 * (i + 1)}>
            <div class="flex h-full flex-col rounded-md border border-white/12 bg-white/[0.04] p-5 transition-colors duration-300 hover:border-white/25 hover:bg-white/[0.07] sm:p-6">
              <span class="text-[11px] font-bold tracking-[0.16em] text-teal [font-variant-numeric:tabular-nums]">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-3 text-[16px] font-bold leading-tight tracking-[-0.02em] text-white sm:mt-4 sm:text-[19px]">
                {rule.title}
              </h3>
              <p class="mt-2 text-[13.5px] leading-[1.55] text-white/80 sm:mt-3 sm:text-[14px] sm:leading-[1.6]">
                {rule.description}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>

    <FadeIn delay={0.2}>
      <p class="mt-8 text-center text-[13.5px] leading-[1.6] text-white/80 sm:mt-12 sm:text-[14.5px]">
        {TEAM_PAGE.staffing.note}{" "}
        <a
          href={NAV_ROUTES.careers}
          class="inline-flex items-center gap-1 font-semibold text-white underline-offset-4 transition-colors hover:text-accent hover:underline"
        >
          See open roles
          <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </p>
    </FadeIn>
  </Container>
</section>

<CtaSection />
