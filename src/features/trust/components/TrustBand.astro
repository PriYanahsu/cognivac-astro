---
import Container from "@/components/shared/Container.astro";
import { CLIENT_MARKS, TECH_STRIP, LIVE_PARTNERSHIPS } from "../constants";

/** Client marks + stack names. Partnership badges render only when verified. */
---

<section class="border-y border-border bg-card py-10 sm:py-14">
  <Container>
    <p class="text-center text-[11px] font-semibold uppercase tracking-[0.16em] text-muted">
      {TECH_STRIP.label}
    </p>
    <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      {
        TECH_STRIP.names.map((name) => (
          <li class="text-[14px] font-medium text-foreground/70 sm:text-[15px]">{name}</li>
        ))
      }
    </ul>

    <ul class="mt-8 flex flex-wrap items-center justify-center gap-8 opacity-80">
      {
        CLIENT_MARKS.map((mark) => (
          <li>
            <img
              src={mark.src}
              alt={mark.alt}
              class="h-8 w-auto grayscale sm:h-10"
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-center text-[12.5px] text-muted">
      Marks from delivery work. Named references available on request.
    </p>

    {
      LIVE_PARTNERSHIPS.length > 0 && (
        <ul class="mt-8 flex flex-wrap items-center justify-center gap-4">
          {LIVE_PARTNERSHIPS.map((item) => (
            <li class="rounded-full border border-border px-3 py-1 text-[12px] font-semibold text-muted">
              {item.name}
            </li>
          ))}
        </ul>
      )
    }
  </Container>
</section>
