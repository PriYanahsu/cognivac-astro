---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { cn } from "@/lib/utils";
import { PROBLEM_CONTENT, PROBLEM_POINTS } from "../constants";

/**
 * Port of features/problem-section/components/problem-section.tsx.
 *
 * Two framer-motion behaviours are reproduced by hand in the script below:
 * - `useScroll({ offset: ["start 65%", "end 80%"] })` + `useSpring` drives the
 *   rail fill and the counter bar.
 * - `useInView(ref, { margin: "-48% 0px -48% 0px" })` per row drives which row
 *   reads as active, so the rail tracks whatever is in the middle band.
 */
const total = String(PROBLEM_POINTS.length).padStart(2, "0");
---

<section
  data-problem
  class="relative bg-lavender/30 py-12 sm:py-20 lg:py-28"
>
  {/*
    Next has no overflow-hidden here on purpose: it would turn this section
    into a scroll container and kill `lg:sticky` on the left column — which
    is the whole scroll-linked composition. The bg sits in a non-clipping
    absolute layer instead.
  */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.22]"
    style="background-image: url(/images/problem-section-bg.png)"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-linear-to-b from-lavender/80 via-lavender/55 to-lavender/80"
  >
  </div>

  <Container class="relative z-10">
    <div class="grid items-start gap-6 sm:gap-10 lg:grid-cols-12 lg:gap-16">
      {/*
        Sticky lives on THIS wrapper, not on FadeIn. `[data-reveal]` keeps a
        transform (and will-change: transform) which makes the element a
        containing block — sticky then sticks to itself and never pins.
        Next's FadeIn clears transform to `none` at rest, so sticky works.
      */}
      <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
        <FadeIn>
        <SectionLabel class="mb-0">
          {PROBLEM_CONTENT.label}
        </SectionLabel>
        {/* Sized against the 5-column sidebar, not the viewport: `text-section`
            tops out at 3.25rem, which overflows a ~540px column. On a phone
            it is a section heading again — 17.6px put the page's sharpest
            line at barely above body size. */}
        <h2
          class="mt-2 max-w-[22ch] text-[26px] font-bold leading-[1.15] tracking-[-0.02em] text-foreground sm:mt-5 sm:text-[clamp(1.5rem,1.4vw+1rem,2.75rem)]"
        >
          {PROBLEM_CONTENT.title}
        </h2>
        <p
          class="mt-2.5 max-w-[46ch] text-[14.5px] leading-normal text-muted sm:mt-5 sm:text-[17px] sm:leading-[1.65] lg:text-[18.5px]"
        >
          {PROBLEM_CONTENT.description}
        </p>
        <p
          class="mt-4 max-w-[40ch] border-l-2 border-accent pl-3 text-[14.5px] font-semibold leading-snug text-foreground sm:mt-6 sm:pl-4 sm:text-[17px] lg:text-[18.5px]"
        >
          {PROBLEM_CONTENT.pivot}
        </p>

        {/* Reading position — mirrors the rail on the right */}
        <div class="mt-8 hidden items-center gap-4 lg:flex">
          <span
            data-problem-counter
            class="text-[13px] font-bold tabular-nums tracking-[0.08em] text-accent"
          >
            {PROBLEM_POINTS[0].index}
          </span>
          <div class="relative h-px w-32 bg-border">
            <div
              data-problem-bar
              class="absolute inset-0 origin-left bg-accent will-change-transform"
              style="transform: scaleX(0)"
            >
            </div>
          </div>
          <span
            class="text-[13px] font-bold tabular-nums tracking-[0.08em] text-muted-light"
          >
            {total}
          </span>
        </div>
        </FadeIn>
      </div>

      <div data-problem-list class="relative lg:col-span-7">
        {/* Rail: static track with a scroll-driven accent fill */}
        <div
          class="absolute left-3.25 top-8 bottom-8 w-0.5 bg-border/80 sm:left-3.75"
          aria-hidden="true"
        >
          <div
            data-problem-rail
            class="absolute inset-0 origin-top bg-accent will-change-transform"
            style="transform: scaleY(0)"
          >
          </div>
        </div>

        {
          PROBLEM_POINTS.map((point, i) => (
            <div
              data-problem-point
              data-index={i}
              data-active={i === 0 ? "true" : "false"}
              data-reveal
              data-reveal-margin="-10% 0px -10% 0px"
              style="--reveal-x:0px;--reveal-y:32px;--reveal-duration:0.65s"
              class={cn(
                "group relative pl-10 sm:pl-16",
                i > 0 && "border-t border-border"
              )}
            >
              {/* Numbered marker sitting on the rail */}
              <span
                data-problem-marker
                class="absolute left-0 top-4 z-10 flex h-7 w-7 items-center justify-center rounded-full border text-[10px] font-bold tabular-nums tracking-[0.06em] transition-all duration-500 ease-out sm:top-9 sm:h-8 sm:w-8 sm:text-[11px]"
                aria-hidden="true"
              >
                {point.index}
              </span>

              <div
                data-problem-body
                class="py-4 transition-transform duration-500 ease-out sm:py-9"
              >
                <span
                  data-problem-tag
                  class="block text-[10px] font-semibold uppercase tracking-[0.16em] transition-colors duration-500 sm:text-[11px] sm:tracking-[0.18em] lg:text-[12px]"
                >
                  {point.tag}
                </span>
                <h3
                  data-problem-title
                  class="mt-1 text-[16px] font-bold leading-tight tracking-[-0.01em] transition-colors duration-500 sm:mt-2.5 sm:text-card-title"
                >
                  {point.title}
                </h3>
                <p
                  data-problem-desc
                  class="mt-1.5 max-w-[54ch] text-[13.5px] leading-[1.5] transition-colors duration-500 sm:mt-3 sm:text-[16.5px] sm:leading-[1.65] lg:text-[17.5px]"
                >
                  {point.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  /* Active / inactive treatment — was `cn(...)` on each element in React. */
  [data-problem-marker] {
    border-color: var(--border);
    background-color: var(--background);
    color: var(--muted-light);
  }

  [data-problem-point][data-active="true"] [data-problem-marker] {
    border-color: var(--accent);
    background-color: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 5px rgba(30, 79, 216, 0.12);
  }

  [data-problem-tag] {
    color: var(--muted-light);
  }

  [data-problem-point][data-active="true"] [data-problem-tag] {
    color: var(--accent);
  }

  /*
    No dim-on-inactive at any width. The rail, the marker and the tag carry
    the reading position; fading the copy made every row but one hard to read
    on desktop while mobile stayed full-strength — this keeps both the same.
  */
  [data-problem-title] {
    color: var(--foreground);
  }

  [data-problem-desc] {
    color: var(--muted);
  }

  @media (min-width: 1024px) {
    [data-problem-point][data-active="true"] [data-problem-body] {
      transform: translateX(0.25rem);
    }
  }
</style>

<script>
  /**
   * Framer `useSpring({ stiffness: 90, damping: 28, restDelta: 0.001 })`.
   * Mass is 1 — the default on that hook.
   */
  const STIFFNESS = 90;
  const DAMPING = 28;
  const REST_DELTA = 0.001;

  function initProblemSection() {
    const section = document.querySelector<HTMLElement>("[data-problem]");
    const list = document.querySelector<HTMLElement>("[data-problem-list]");
    if (!section || !list || list.dataset.problemReady === "true") return;
    list.dataset.problemReady = "true";

    const rail = list.querySelector<HTMLElement>("[data-problem-rail]");
    const bar = document.querySelector<HTMLElement>("[data-problem-bar]");
    const counter = document.querySelector<HTMLElement>(
      "[data-problem-counter]",
    );
    const points = Array.from(
      list.querySelectorAll<HTMLElement>("[data-problem-point]"),
    );

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    /* ---- active row: framer's useInView with a -48% band ---- */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;

          const el = entry.target as HTMLElement;
          points.forEach((point) => {
            point.dataset.active = point === el ? "true" : "false";
          });

          if (counter) {
            const index = Number(el.dataset.index ?? "0");
            counter.textContent = String(index + 1).padStart(2, "0");
          }
        }
      },
      { rootMargin: "-48% 0px -48% 0px" },
    );

    points.forEach((point) => observer.observe(point));

    if (!rail && !bar) return;

    if (reduced) {
      if (rail) rail.style.transform = "scaleY(1)";
      if (bar) bar.style.transform = "scaleX(1)";
      return;
    }

    /*
     * Same loop Framer runs: read scroll progress every frame (so Lenis's
     * interpolated scroll is visible), then spring it. Listening to `scroll`
     * only sampled native ticks and missed the 1.1s Lenis lerp — that's why
     * the rail stepped instead of filling.
     */
    let target = 0;
    let value = 0;
    let velocity = 0;
    let last = performance.now();
    let running = false;
    let alive = true;

    const paint = (v: number) => {
      if (rail) rail.style.transform = `scaleY(${v})`;
      if (bar) bar.style.transform = `scaleX(${v})`;
    };

    const readProgress = () => {
      const rect = list.getBoundingClientRect();
      const vh = window.innerHeight;
      // useScroll offset ["start 65%", "end 80%"]
      const span = rect.height - 0.15 * vh;
      if (span <= 0) {
        target = 1;
        return;
      }
      target = Math.min(Math.max((0.65 * vh - rect.top) / span, 0), 1);
    };

    const step = (now: number) => {
      if (!running) return;

      const dt = Math.min((now - last) / 1000, 1 / 30);
      last = now;

      readProgress();

      velocity += (-STIFFNESS * (value - target) - DAMPING * velocity) * dt;
      value += velocity * dt;

      if (
        Math.abs(value - target) < REST_DELTA &&
        Math.abs(velocity) < REST_DELTA
      ) {
        value = target;
        velocity = 0;
      }

      paint(value);
      requestAnimationFrame(step);
    };

    readProgress();
    value = target;
    paint(value);

    /**
     * The loop only runs while the rail is on screen. `readProgress` calls
     * getBoundingClientRect every frame — a forced layout — and left running
     * for the life of the page it charged that reflow against whatever
     * section the visitor was actually looking at.
     */
    const gate = new IntersectionObserver(
      ([entry]) => {
        if (!alive) return;
        if (entry.isIntersecting) {
          if (running) return;
          running = true;
          last = performance.now();
          requestAnimationFrame(step);
        } else {
          running = false;
        }
      },
      { rootMargin: "200px 0px" },
    );
    gate.observe(list);

    document.addEventListener("astro:before-swap", () => {
      alive = false;
      running = false;
      gate.disconnect();
    }, { once: true });
  }

  initProblemSection();
  document.addEventListener("astro:page-load", initProblemSection);
</script>
