---
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import type { LegalDoc } from "@/features/legal/constants";
import { LEGAL_UPDATED } from "@/features/legal/constants";

interface Props {
  doc: LegalDoc;
}

const { doc } = Astro.props;
---

<PageHero
  label="Legal"
  title={doc.title}
  description={doc.description}
  breadcrumbs={[{ label: doc.title }]}
/>

<section class="bg-background section-padding">
  <Container>
    <FadeIn class="mx-auto max-w-3xl">
      <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-accent">
        Last updated {LEGAL_UPDATED}
      </p>
      <div class="mt-8 space-y-10">
        {
          doc.sections.map((section) => (
            <section>
              <h2 class="text-[20px] font-bold tracking-[-0.02em] text-foreground sm:text-[23px]">
                {section.heading}
              </h2>
              {section.body.map((p) => (
                <p class="mt-3 text-[15.5px] leading-[1.7] text-muted sm:text-[16.5px]">
                  {p}
                </p>
              ))}
            </section>
          ))
        }
      </div>
    </FadeIn>
  </Container>
</section>

<CtaSection />
