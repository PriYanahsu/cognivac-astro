---
import { ArrowUpRight } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { CASE_STUDIES } from "@/features/home/constants/content";
import { CASE_HIGHLIGHTS_CONTENT, CASE_METRICS } from "../constants";

/** Port of features/case-highlights/components/case-highlights.tsx. */
---

<section class="bg-background py-16 sm:py-20 lg:py-28">
  <Container>
    <FadeIn>
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <SectionLabel class="mb-0 text-[13px] tracking-[0.08em] sm:text-sm">
            {CASE_HIGHLIGHTS_CONTENT.label}
          </SectionLabel>
          <h2 class="text-section mt-5 max-w-[24ch] text-primary">
            {CASE_HIGHLIGHTS_CONTENT.title}
          </h2>
          <p
            class="mt-4 max-w-[52ch] text-[16px] leading-[1.6] text-muted sm:text-[18px]"
          >
            {CASE_HIGHLIGHTS_CONTENT.description}
          </p>
        </div>
        <GhostButton
          href={CASE_HIGHLIGHTS_CONTENT.cta.href}
          class="shrink-0 self-start lg:self-end"
        >
          {CASE_HIGHLIGHTS_CONTENT.cta.label}
        </GhostButton>
      </div>
    </FadeIn>

    <div class="mt-10 grid gap-5 sm:mt-12 md:grid-cols-3 md:gap-6 lg:mt-14">
      {
        CASE_STUDIES.map((study, i) => {
          const metric = CASE_METRICS[study.id];

          return (
            <FadeIn delay={0.08 * (i + 1)}>
              <a
                href={study.href}
                class="group flex h-full flex-col rounded-[18px] border border-border bg-card p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-soft sm:rounded-[22px] sm:p-8"
              >
                <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-accent">
                  {study.category}
                </p>

                {metric && (
                  <div class="mt-5 sm:mt-6">
                    <p class="text-[clamp(2.25rem,4vw,3.25rem)] font-bold leading-[1] tracking-[-0.02em] text-primary [font-variant-numeric:tabular-nums]">
                      {metric.value}
                    </p>
                    <p class="mt-2 max-w-[24ch] text-[14px] font-medium leading-snug text-muted">
                      {metric.label}
                    </p>
                  </div>
                )}

                <div class="mt-6 border-t border-border pt-5 sm:mt-8">
                  <h3 class="text-[17px] font-bold leading-snug text-primary sm:text-[19px]">
                    {study.title}
                  </h3>
                  <p class="mt-2.5 text-[14.5px] leading-[1.6] text-muted sm:text-[15.5px]">
                    {study.description}
                  </p>
                </div>

                <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-[13.5px] font-semibold text-primary transition-colors group-hover:text-accent">
                  Read the case study
                  <ArrowUpRight class="h-4 w-4" />
                </span>
              </a>
            </FadeIn>
          );
        })
      }
    </div>
  </Container>
</section>
