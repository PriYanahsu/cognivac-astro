---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { cn } from "@/lib/utils";
import {
  PLATFORM_CONTENT,
  PLATFORM_LAYERS,
  PLATFORM_STACK,
} from "../constants";

/** Port of features/platform-section/components/platform-section.tsx. */
---

<section
  class="relative overflow-hidden bg-[#0f0f12] section-padding text-white"
>
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>

  <Container class="relative z-10">
    <FadeIn>
      <div class="mx-auto max-w-3xl text-center">
        <SectionLabel
          tone="accent"
          class="mb-0"
        >
          {PLATFORM_CONTENT.label}
        </SectionLabel>
        <h2
          class="mt-5 text-[clamp(1.625rem,3.5vw+0.75rem,3.5rem)] font-bold leading-[1.08] tracking-[-0.02em] text-white"
        >
          {PLATFORM_CONTENT.title}
        </h2>
        <p
          class="mx-auto stack-md lede max-w-[640px] text-white/85"
        >
          {PLATFORM_CONTENT.description}
        </p>
      </div>
    </FadeIn>

    <div class="card-grid sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        PLATFORM_LAYERS.map((layer, i) => (
          <FadeIn delay={0.07 * (i + 1)}>
            <div class="flex h-full flex-col rounded-md border border-white/12 bg-white/[0.04] p-6 sm:rounded-md">
              <div
                class={cn(
                  "h-[84px] w-full rounded-2xl bg-linear-to-br sm:h-[104px]",
                  layer.gradient
                )}
              />
              <p class="mt-6 text-[12px] font-bold tracking-[0.16em] text-white/65">
                {layer.index}
              </p>
              <h3 class="mt-2 text-[20px] font-bold leading-tight text-white sm:text-[22px]">
                {layer.title}
              </h3>
              <p class="mt-1 text-[13px] font-semibold uppercase tracking-[0.12em] text-teal">
                {layer.subtitle}
              </p>
              <p class="mt-4 text-[14.5px] leading-[1.6] text-white/80 sm:text-[15px]">
                {layer.description}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>

    <FadeIn delay={0.2}>
      <div class="mt-12 border-t border-white/12 pt-8 sm:mt-14">
        <p
          class="text-center text-[12px] font-semibold uppercase tracking-[0.16em] text-white/65"
        >
          Built with
        </p>
        <div
          class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-3"
        >
          {
            PLATFORM_STACK.map((tech) => (
              <span class="text-[14px] font-medium text-white/75 sm:text-[15px]">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </FadeIn>
  </Container>
</section>
