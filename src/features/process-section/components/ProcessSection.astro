---
import { ArrowLeft, ArrowRight, Check } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { cn } from "@/lib/utils";
import {
  ENGAGEMENT_FACTS,
  ENGAGEMENT_PANEL,
  PROCESS_CONTENT,
  PROCESS_CTA,
  PROCESS_DELIVERABLE_LABEL,
  PROCESS_STEPS,
} from "../constants";

/**
 * Port of features/process-section/components/process-section.tsx.
 *
 * A five-step rail that walks itself once, holding one step in focus with
 * the deliverable it ends on. All panels occupy the same grid cell so the
 * page never jumps when the copy length changes.
 */
const TOTAL = PROCESS_STEPS.length;
const TRACK_INSET = `${50 / TOTAL}%`;
const paddedTotal = String(TOTAL).padStart(2, "0");
---

<section
  data-process
  id="process"
  class="relative overflow-hidden border-y border-border bg-card py-14 sm:py-16 lg:py-18"
  aria-labelledby="process-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 right-[-12%] h-130 w-130 rounded-full bg-[radial-gradient(circle,rgba(30,79,216,0.06),transparent_66%)]"
  >
  </div>

  <Container class="relative z-10">
    <FadeIn>
      <div class="grid gap-4 lg:grid-cols-12 lg:items-end lg:gap-12">
        <div class="lg:col-span-7">
          <SectionLabel class="mb-0">
            {PROCESS_CONTENT.label}
          </SectionLabel>
          <h2
            id="process-title"
            class="text-section stack-sm max-w-[18ch] text-foreground"
          >
            {PROCESS_CONTENT.title}
          </h2>
        </div>
        <p class="max-w-[52ch] text-[15px] leading-[1.6] text-muted lg:col-span-5 lg:text-[16px]">
          {PROCESS_CONTENT.description}
        </p>
      </div>
    </FadeIn>

    <FadeIn delay={0.08}>
      <div
        data-process-tabs
        role="tablist"
        aria-label="Our five delivery steps"
        class="relative mt-9 sm:mt-11"
      >
        <div
          aria-hidden="true"
          class="absolute top-4.5 h-0.5 bg-border sm:top-5.5"
          style={`left:${TRACK_INSET};right:${TRACK_INSET}`}
        >
          <div
            data-process-fill
            class="h-full origin-left bg-accent"
            style="transform:scaleX(0)"
          >
          </div>
        </div>

        <ol class="grid grid-cols-5">
          {
            PROCESS_STEPS.map((item, i) => {
              const isActive = i === 0;
              return (
                <li class="min-w-0">
                  <button
                    type="button"
                    role="tab"
                    data-process-tab
                    data-index={i}
                    id={`process-tab-${item.id}`}
                    aria-selected={isActive ? "true" : "false"}
                    aria-controls={`process-panel-${item.id}`}
                    tabindex={isActive ? 0 : -1}
                    class="group flex w-full flex-col items-center gap-2.5 px-1 text-center sm:gap-3.5"
                  >
                    <span
                      data-process-node
                      class={cn(
                        "relative z-10 flex h-9 w-9 items-center justify-center rounded-full border text-[11px] font-bold tabular-nums tracking-[0.06em] transition-all duration-500 ease-out sm:h-11 sm:w-11 sm:text-[12px]",
                        isActive
                          ? "border-accent bg-accent text-white shadow-[0_0_0_6px_rgba(30,79,216,0.10)]"
                          : "border-border bg-card text-muted-light group-hover:border-accent/45 group-hover:text-accent",
                      )}
                    >
                      <Check
                        data-process-check
                        class="hidden h-4 w-4"
                        aria-hidden="true"
                      />
                      <span data-process-index>{item.index}</span>
                    </span>
                    <span
                      data-process-label
                      class={cn(
                        "text-[12px] font-semibold leading-tight tracking-[-0.01em] transition-colors duration-500 sm:text-[14px]",
                        isActive
                          ? "text-foreground"
                          : "text-muted-light group-hover:text-muted",
                      )}
                    >
                      {item.title}
                    </span>
                  </button>
                </li>
              );
            })
          }
        </ol>
      </div>
    </FadeIn>

    <FadeIn delay={0.14}>
      <div class="mt-7 rounded-md border border-border bg-background p-6 sm:mt-9 sm:p-7">
        <div class="flex items-center justify-between gap-4">
          <p data-process-counter class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">
            Step {PROCESS_STEPS[0].index} of {paddedTotal}
          </p>

          <div class="flex shrink-0 items-center gap-2">
            <button
              type="button"
              data-process-prev
              aria-label="Previous step"
              disabled
              class={cn(
                "flex h-9 w-9 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors duration-300",
                "cursor-default text-muted-light opacity-45",
              )}
            >
              <ArrowLeft class="h-4 w-4" aria-hidden="true" />
            </button>
            <button
              type="button"
              data-process-next
              aria-label="Next step"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"
            >
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="relative mt-5 grid">
          {
            PROCESS_STEPS.map((item, i) => (
              <div
                data-process-panel
                data-index={i}
                id={`process-panel-${item.id}`}
                role="tabpanel"
                aria-labelledby={`process-tab-${item.id}`}
                aria-hidden={i === 0 ? "false" : "true"}
                class="col-start-1 row-start-1"
                style={
                  i === 0
                    ? "opacity:1;transform:translateX(0);pointer-events:auto"
                    : "opacity:0;transform:translateX(20px);pointer-events:none"
                }
              >
                <div class="grid gap-6 lg:grid-cols-12 lg:gap-12">
                  <div class="lg:col-span-7">
                    <h3 class="text-[22px] font-bold leading-tight tracking-[-0.02em] text-foreground sm:text-[26px]">
                      {item.title}
                    </h3>
                    <p class="mt-3 max-w-[56ch] text-[15px] leading-[1.65] text-muted sm:text-[16.5px]">
                      {item.description}
                    </p>
                  </div>

                  <div class="lg:col-span-5">
                    <div class="h-full rounded-md border border-accent/20 bg-accent/4 p-5">
                      <span class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-accent sm:text-[11px]">
                        <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
                        {PROCESS_DELIVERABLE_LABEL}
                      </span>
                      <p class="mt-2.5 text-[15px] font-semibold leading-normal text-foreground sm:text-[16px]">
                        {item.deliverable}
                      </p>
                    </div>
                  </div>
                </div>

                <ul class="mt-6 grid gap-3 border-t border-border pt-5 sm:grid-cols-3 sm:gap-6">
                  {item.details.map((detail) => (
                    <li class="flex items-start gap-2.5 text-[13.5px] leading-normal text-body">
                      <Check
                        class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent"
                        aria-hidden="true"
                      />
                      {detail}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </FadeIn>

    <FadeIn delay={0.2}>
      <div class="mt-5 flex flex-col gap-6 rounded-md border border-border bg-background p-6 sm:mt-6 sm:p-7 xl:flex-row xl:items-center xl:gap-10">
        <div class="min-w-0 xl:flex-1">
          <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-light sm:text-[11px]">
            {ENGAGEMENT_PANEL.label}
          </p>

          <dl class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-border">
            {
              ENGAGEMENT_FACTS.map((fact) => (
                <div class="lg:px-5 lg:first:pl-0 lg:last:pr-0">
                  <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-light">
                    {fact.label}
                  </dt>
                  <dd class="mt-1.5 text-[14.5px] font-bold leading-snug tracking-[-0.01em] text-foreground sm:text-[15.5px]">
                    {fact.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="shrink-0 border-t border-border pt-5 xl:w-76 xl:border-l xl:border-t-0 xl:pl-8 xl:pt-0">
          <GradientButton href={PROCESS_CTA.href} class="w-full whitespace-nowrap">
            {PROCESS_CTA.label}
          </GradientButton>
          <p class="mt-2.5 text-center text-[12.5px] leading-[1.45] text-muted-light">
            {ENGAGEMENT_PANEL.note}
          </p>
        </div>
      </div>
    </FadeIn>
  </Container>
</section>

<script>
  const DWELL = 5.2;
  const EASE = "cubic-bezier(0.22, 1, 0.36, 1)";
  const TOTAL = 5;
  const LAST = TOTAL - 1;

  const NODE_ACTIVE =
    "relative z-10 flex h-9 w-9 items-center justify-center rounded-full border text-[11px] font-bold tabular-nums tracking-[0.06em] transition-all duration-500 ease-out sm:h-11 sm:w-11 sm:text-[12px] border-accent bg-accent text-white shadow-[0_0_0_6px_rgba(30,79,216,0.10)]";
  const NODE_DONE =
    "relative z-10 flex h-9 w-9 items-center justify-center rounded-full border text-[11px] font-bold tabular-nums tracking-[0.06em] transition-all duration-500 ease-out sm:h-11 sm:w-11 sm:text-[12px] border-accent/45 bg-card text-accent";
  const NODE_IDLE =
    "relative z-10 flex h-9 w-9 items-center justify-center rounded-full border text-[11px] font-bold tabular-nums tracking-[0.06em] transition-all duration-500 ease-out sm:h-11 sm:w-11 sm:text-[12px] border-border bg-card text-muted-light group-hover:border-accent/45 group-hover:text-accent";
  const LABEL_ACTIVE =
    "text-[12px] font-semibold leading-tight tracking-[-0.01em] transition-colors duration-500 sm:text-[14px] text-foreground";
  const LABEL_IDLE =
    "text-[12px] font-semibold leading-tight tracking-[-0.01em] transition-colors duration-500 sm:text-[14px] text-muted-light group-hover:text-muted";
  const ARROW_ON =
    "flex h-9 w-9 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white";
  const ARROW_OFF =
    "flex h-9 w-9 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors duration-300 cursor-default text-muted-light opacity-45";

  function initProcess() {
    const section = document.querySelector<HTMLElement>("[data-process]");
    if (!section || section.dataset.ready === "true") return;
    section.dataset.ready = "true";

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const fill = section.querySelector<HTMLElement>("[data-process-fill]");
    const tabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>("[data-process-tab]"),
    );
    const panels = Array.from(
      section.querySelectorAll<HTMLElement>("[data-process-panel]"),
    );
    const counter = section.querySelector<HTMLElement>("[data-process-counter]");
    const prev = section.querySelector<HTMLButtonElement>("[data-process-prev]");
    const next = section.querySelector<HTMLButtonElement>("[data-process-next]");
    const tablist = section.querySelector<HTMLElement>("[data-process-tabs]");

    let active = 0;
    let locked = false;
    let hovered = false;
    let inView = false;
    let timer = 0;

    const playing = () =>
      inView && !locked && !hovered && !reduceMotion && active < LAST;

    const paintFill = () => {
      if (!fill) return;
      const value = playing() ? (active + 1) / LAST : active / LAST;
      fill.style.transition = playing()
        ? `transform ${DWELL}s linear`
        : reduceMotion
          ? "none"
          : `transform 0.45s ${EASE}`;
      fill.style.transform = `scaleX(${value})`;
    };

    const paint = () => {
      tabs.forEach((tab, i) => {
        const isActive = i === active;
        const isDone = i < active;
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        tab.tabIndex = isActive ? 0 : -1;
        const node = tab.querySelector<HTMLElement>("[data-process-node]");
        const check = tab.querySelector<HTMLElement>("[data-process-check]");
        const index = tab.querySelector<HTMLElement>("[data-process-index]");
        const label = tab.querySelector<HTMLElement>("[data-process-label]");
        if (node) {
          node.className = isActive ? NODE_ACTIVE : isDone ? NODE_DONE : NODE_IDLE;
        }
        if (check) check.classList.toggle("hidden", !isDone);
        if (index) index.classList.toggle("hidden", isDone);
        if (label) label.className = isActive ? LABEL_ACTIVE : LABEL_IDLE;
      });

      panels.forEach((panel, i) => {
        const isActive = i === active;
        panel.setAttribute("aria-hidden", isActive ? "false" : "true");
        panel.style.transition = reduceMotion
          ? "none"
          : `opacity 0.4s ${EASE}, transform 0.4s ${EASE}`;
        panel.style.opacity = isActive ? "1" : "0";
        panel.style.transform =
          reduceMotion || isActive
            ? "translateX(0)"
            : i < active
              ? "translateX(-20px)"
              : "translateX(20px)";
        panel.style.pointerEvents = isActive ? "auto" : "none";
      });

      if (counter) {
        const step = String(active + 1).padStart(2, "0");
        counter.textContent = `Step ${step} of ${String(TOTAL).padStart(2, "0")}`;
      }

      if (prev) {
        prev.disabled = active === 0;
        prev.className = active === 0 ? ARROW_OFF : ARROW_ON;
      }
      if (next) {
        next.disabled = active === LAST;
        next.className = active === LAST ? ARROW_OFF : ARROW_ON;
      }

      paintFill();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (!playing()) return;
      timer = window.setTimeout(() => {
        active += 1;
        paint();
        schedule();
      }, DWELL * 1000);
    };

    const select = (index: number) => {
      active = Math.max(0, Math.min(LAST, index));
      locked = true;
      window.clearTimeout(timer);
      paint();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
    });
    prev?.addEventListener("click", () => select(active - 1));
    next?.addEventListener("click", () => select(active + 1));

    tablist?.addEventListener("keydown", (event) => {
      const delta =
        event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
      if (!delta) return;
      event.preventDefault();
      const nextIndex = (active + delta + TOTAL) % TOTAL;
      select(nextIndex);
      tabs[nextIndex]?.focus();
    });

    section.addEventListener("pointerenter", () => {
      hovered = true;
      window.clearTimeout(timer);
      paintFill();
    });
    section.addEventListener("pointerleave", () => {
      hovered = false;
      paintFill();
      schedule();
    });
    section.addEventListener(
      "focusin",
      () => {
        locked = true;
        window.clearTimeout(timer);
        paintFill();
      },
    );

    const visibility = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting && entry.intersectionRatio >= 0.3;
        if (inView) {
          paintFill();
          schedule();
        } else {
          window.clearTimeout(timer);
          paintFill();
        }
      },
      { threshold: [0, 0.3, 1] },
    );
    visibility.observe(section);

    paint();
  }

  initProcess();
  document.addEventListener("astro:page-load", initProcess);
</script>
