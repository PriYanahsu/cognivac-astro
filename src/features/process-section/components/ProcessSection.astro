---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import {
  ENGAGEMENT_FACTS,
  PROCESS_CONTENT,
  PROCESS_CTA,
  PROCESS_STEPS,
} from "../constants";

/** Port of features/process-section/components/process-section.tsx. */
---

<section class="border-y border-border bg-card section-padding">
  <Container>
    <FadeIn>
      <div class="max-w-3xl">
        <SectionLabel class="mb-0">
          {PROCESS_CONTENT.label}
        </SectionLabel>
        <h2 class="text-section stack-sm max-w-[24ch] text-foreground">
          {PROCESS_CONTENT.title}
        </h2>
        <p class="stack-md lede max-w-[54ch]">
          {PROCESS_CONTENT.description}
        </p>
      </div>
    </FadeIn>

    {/* Five steps: connected rail on desktop, stacked rail on mobile */}
    <div class="stack-2xl relative">
      <div
        class="pointer-events-none absolute left-[15px] top-2 bottom-2 w-px bg-border lg:left-0 lg:right-0 lg:top-[15px] lg:bottom-auto lg:h-px lg:w-auto"
      >
      </div>

      <div class="grid gap-6 lg:grid-cols-5 lg:gap-8">
        {
          PROCESS_STEPS.map((step, i) => (
            <FadeIn delay={0.06 * (i + 1)}>
              <div class="relative flex gap-5 lg:block">
                <span class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border bg-card text-[11px] font-bold tracking-[0.06em] text-accent">
                  {step.index}
                </span>
                <div class="min-w-0 lg:mt-6 lg:pr-4">
                  <h3 class="text-heading-md text-foreground">
                    {step.title}
                  </h3>
                  <p class="stack-xs copy-md">
                    {step.description}
                  </p>
                </div>
              </div>
            </FadeIn>
          ))
        }
      </div>
    </div>

    <FadeIn delay={0.15}>
      <div class="surface-card stack-2xl">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {
            ENGAGEMENT_FACTS.map((fact) => (
              <div>
                <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">
                  {fact.label}
                </p>
                <p class="mt-2 text-[16px] font-bold leading-snug text-foreground sm:text-[17px]">
                  {fact.value}
                </p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 border-t border-border pt-6">
          <GradientButton href={PROCESS_CTA.href}>
            {PROCESS_CTA.label}
          </GradientButton>
        </div>
      </div>
    </FadeIn>
  </Container>
</section>
