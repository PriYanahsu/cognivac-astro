---
import { ArrowUpRight } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import GhostButton from "@/components/shared/GhostButton.astro";
import PersonAvatar from "@/components/shared/PersonAvatar.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { FOUNDERS, TEAM_HEADCOUNT, TEAM_MEMBERS } from "@/constants/people";
import { FOUNDERS_CONTENT, TEAM_STRIP } from "../constants";
import FounderCard from "./FounderCard.astro";

/** Port of features/founders-section/components/founders-section.tsx. */

const STACK = 5;
const stack = TEAM_MEMBERS.slice(0, STACK);
const remaining = TEAM_HEADCOUNT - stack.length;
---

<section
  id="founders"
  class="relative overflow-hidden bg-[#1a1a1c] py-12 text-white sm:py-24 lg:py-28"
  aria-labelledby="founders-title"
>
  <Container class="relative z-10">
    <FadeIn>
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-pill border border-white/12 bg-white/[0.05] px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/70">
          <span
            aria-hidden="true"
            class="h-1.5 w-1.5 rounded-full bg-accent shadow-[0_0_10px_2px_rgba(30,79,216,0.9)]"
          ></span>
          {FOUNDERS_CONTENT.label}
        </span>
        <h2
          id="founders-title"
          class="mt-4 text-[clamp(1.625rem,3.5vw+0.75rem,3.5rem)] font-bold leading-[1.08] tracking-[-0.02em] text-white sm:mt-6"
        >
          {FOUNDERS_CONTENT.title}
        </h2>
        <p class="mx-auto stack-sm lede max-w-[640px] text-white/75 sm:stack-md">
          {FOUNDERS_CONTENT.description}
        </p>
      </div>
    </FadeIn>

    <div class="mt-8 grid gap-4 sm:mt-16 sm:gap-5 lg:grid-cols-2 lg:gap-6">
      {
        FOUNDERS.map((founder, i) => (
          <FadeIn delay={0.08 * (i + 1)}>
            <FounderCard founder={founder} index={i} />
          </FadeIn>
        ))
      }
    </div>

    <FadeIn delay={0.24}>
      <div
        class="relative mt-4 rounded-lg bg-linear-to-b from-white/[0.16] via-white/[0.06] to-white/[0.03] p-px sm:mt-5 lg:mt-6"
      >
        <div
          class="relative flex h-full flex-col overflow-hidden rounded-[15px] bg-[#212124] gap-5 p-5 sm:gap-7 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-10 top-0 h-px bg-linear-to-r from-transparent via-white/28 to-transparent"
          ></span>

          <div class="relative min-w-0">
            <p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-white/55 sm:text-[11px]">
              {TEAM_STRIP.label}
            </p>
            <h3 class="mt-2.5 text-[19px] font-bold leading-tight tracking-[-0.02em] text-white sm:text-[22px]">
              {TEAM_STRIP.title}
            </h3>
            <p class="mt-2.5 max-w-[58ch] text-[14px] leading-[1.6] text-white/72 sm:text-[15px]">
              {TEAM_STRIP.description}
            </p>
          </div>

          <div class="relative flex shrink-0 flex-col gap-5 sm:flex-row sm:items-center sm:gap-6 lg:flex-col lg:items-end lg:gap-4">
            <ul class="flex items-center -space-x-1.5 sm:-space-x-3">
              {
                stack.map((member) => (
                  <li title={`${member.name} — ${member.role}`}>
                    <PersonAvatar
                      name={member.name}
                      image={member.image}
                      size={44}
                      class="ring-2 ring-[#202023]"
                    />
                  </li>
                ))
              }
              <li
                aria-hidden="true"
                class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/[0.08] text-[12px] font-bold text-white/75 ring-2 ring-[#202023]"
              >
                +{remaining}
              </li>
            </ul>

            <GhostButton
              tone="light"
              href={TEAM_STRIP.cta.href}
              class="w-full shrink-0 sm:w-auto"
            >
              {TEAM_STRIP.cta.label}
              <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
            </GhostButton>
          </div>
        </div>
      </div>
    </FadeIn>
  </Container>
</section>
