---
import { ArrowUpRight } from "@lucide/astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import PersonAvatar from "@/components/shared/PersonAvatar.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { FOUNDERS, TEAM_HEADCOUNT, TEAM_MEMBERS } from "@/constants/people";
import { FOUNDERS_CONTENT, TEAM_STRIP } from "../constants";
import FounderCard from "./FounderCard.astro";

/**
 * Slot 7. Stays a dark band: the section above it is the white process card
 * and the one below is lavender, so this is the step that keeps that stretch
 * of the page from drifting through three near-identical light surfaces.
 *
 * It is not the same dark as the services band, though. Services is flat
 * #0f0f12 carrying colour-saturated cards; this one lights the band from the
 * top with the brand cobalt so the two read as different rooms rather than
 * one long tunnel, and the cards on it are raised surfaces with a shadow
 * instead of near-black boxes on near-black.
 */

const STACK = 5;
const stack = TEAM_MEMBERS.slice(0, STACK);
const remaining = TEAM_HEADCOUNT - stack.length;
---

<section
  id="founders"
  class="relative overflow-hidden bg-[#0e0e11] py-14 text-white sm:py-24 lg:py-28"
  aria-labelledby="founders-title"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[-22rem] h-[38rem] w-[min(84rem,150%)] -translate-x-1/2 rounded-full bg-accent/16 blur-[150px]"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(115%_75%_at_50%_0%,transparent_45%,rgba(0,0,0,0.5)_100%)]"
  ></span>

  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label={FOUNDERS_CONTENT.label}
      title={FOUNDERS_CONTENT.title}
      description={FOUNDERS_CONTENT.description}
      titleId="founders-title"
      descriptionClass="max-w-160"
    />

    {/* Two-up at `xl`, not at `lg`. A 1024px viewport splits into two 470px
        cards, and 470px minus the portrait plate leaves the copy a 230px
        gutter that wraps the name onto two lines. Between `lg` and `xl` the
        cards stay full width and read as wide banners instead. */}
    <div class="mt-8 grid gap-4 sm:mt-14 sm:gap-5 xl:grid-cols-2 xl:gap-6">
      {
        FOUNDERS.map((founder, i) => (
          <FadeIn class="h-full" delay={0.08 * (i + 1)}>
            <FounderCard founder={founder} index={i} />
          </FadeIn>
        ))
      }
    </div>

    {/* Recessed, not raised. The two cards above are surfaces sitting on the
        band; this is a well cut into it — which is the whole distinction
        between "the two people accountable" and "the bench behind them", and
        it stops the section reading as three grey boxes in a column. */}
    <FadeIn delay={0.24}>
      <div
        class="relative mt-4 overflow-hidden rounded-lg border border-white/10 bg-white/[0.03] p-5 sm:mt-5 sm:p-7 lg:mt-6 lg:flex lg:items-center lg:justify-between lg:gap-10"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-linear-to-b from-black/25 to-transparent"
        ></span>
        {/* One soft cobalt corner, so the closing element of the band picks up
            the light the top of the band is lit with. */}
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -right-24 -top-32 h-72 w-72 rounded-full bg-accent/20 blur-[90px]"
        ></span>

        <div class="relative min-w-0">
          <p class="text-eyebrow text-accent-on-dark">
            {TEAM_STRIP.label}
          </p>
          <h3
            class="mt-2.5 text-[19px] font-bold leading-tight tracking-[-0.02em] text-white sm:text-[23px]"
          >
            {TEAM_STRIP.title}
          </h3>
          <p
            class="mt-2.5 max-w-[58ch] text-[14px] leading-[1.6] text-white/75 sm:text-[15.5px]"
          >
            {TEAM_STRIP.description}
          </p>
        </div>

        {/* A hairline rather than a gap. On a wide viewport the copy ends
            around two thirds across and the avatars sit at the far edge, and
            without a rule between them that distance reads as the bar being
            half empty instead of as two parts of one bar. */}
        <span
          aria-hidden="true"
          class="relative mt-6 block h-px w-full bg-linear-to-r from-white/12 to-transparent lg:mt-0 lg:h-24 lg:w-px lg:shrink-0 lg:bg-linear-to-b lg:from-transparent lg:via-white/15 lg:to-transparent"
        ></span>

        <div
          class="relative mt-6 flex shrink-0 flex-col gap-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 lg:mt-0 lg:flex-col lg:items-end lg:gap-5"
        >
          <ul class="flex items-center -space-x-2">
            {
              stack.map((member) => (
                <li title={`${member.name} — ${member.role}`}>
                  <PersonAvatar
                    name={member.name}
                    image={member.image}
                    size={48}
                    tone="muted"
                    class="ring-2 ring-[#141417]"
                  />
                </li>
              ))
            }
            <li
              aria-hidden="true"
              class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-[12.5px] font-bold text-white/88 ring-2 ring-[#141417]"
            >
              +{remaining}
            </li>
          </ul>

          {/*
            This was a GhostButton overridden into an accent fill — a primary
            in disguise, and the reason it carried none of the depth the other
            primaries have. It is the same component as the rest of them now,
            keeping its own arrow because this one leaves the page.
          */}
          <GradientButton
            href={TEAM_STRIP.cta.href}
            surface="dark"
            showArrow={false}
            class="cta-arrow-diagonal w-full shrink-0 sm:w-auto"
          >
            {TEAM_STRIP.cta.label}
            <ArrowUpRight class="cta-arrow" aria-hidden="true" />
          </GradientButton>
        </div>
      </div>
    </FadeIn>
  </Container>
</section>
