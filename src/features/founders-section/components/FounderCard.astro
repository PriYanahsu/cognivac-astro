---
import SocialIcon from "@/components/shared/SocialIcon.astro";
import PersonPortrait from "@/components/shared/PersonPortrait.astro";
import { FOUNDERS, type Founder } from "@/constants/people";
import { cn } from "@/lib/utils";

/**
 * One founder.
 *
 * The portrait is a full-height plate down the left edge of the card from
 * `sm` up, not a 176px stamp floating inside the padding. The photo is the
 * reason this section exists — "who is actually going to do this" — so it
 * gets an edge of the card rather than a slot in the middle of it.
 *
 * Below `sm` that plate would squeeze the copy into a ~200px gutter, so the
 * portrait drops back to a small square beside the name and the copy takes
 * the full width. Both renderings point at one `src`; the hidden one is the
 * same URL and costs no second request.
 *
 * The credentials sit on a plinth that spans the whole card — under the
 * portrait as well as the copy — so each of the three stats gets a third of
 * the card instead of a third of the text column, which is what made
 * "Platform status" wrap under "Top Rated" and forced the `min-h-7` prop.
 */
interface Props {
  founder: Founder;
  index: number;
}

const { founder, index } = Astro.props;
const total = String(FOUNDERS.length).padStart(2, "0");
const ordinal = String(index + 1).padStart(2, "0");
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-lg bg-[#17171b] shadow-[0_24px_60px_-32px_rgba(0,0,0,0.9)] ring-1 ring-white/10 transition-shadow duration-500 hover:shadow-[0_30px_70px_-30px_rgba(30,79,216,0.45)] hover:ring-accent/45"
>
  {/* Top-lit: a card on a near-black band needs its own light source or it
      reads as a hole cut in the section rather than a surface on top of it. */}
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 bg-linear-to-b from-white/[0.055] via-transparent to-transparent"></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-px bg-linear-to-r from-transparent via-white/30 to-transparent"
  ></span>

  <div class="relative z-10 flex flex-1 flex-col sm:flex-row">
    {/* The plate. Hidden below `sm` — see the note at the top of the file. */}
    {/* Hover is a slow push in on the photograph, nothing tinted over it — the
        `img` lives inside `PersonPortrait`, so the variant reaches it as a
        descendant rather than through a second overlay element. */}
    <div
      class="relative hidden shrink-0 self-stretch overflow-hidden sm:block sm:w-52 xl:w-60 [&_img]:transition-transform [&_img]:duration-700 [&_img]:ease-out group-hover:[&_img]:scale-[1.04]"
    >
      <PersonPortrait
        name={founder.name}
        image={founder.image}
        class="absolute inset-0 h-full w-full rounded-none ring-0"
      />
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 right-0 w-px bg-white/12"
      ></span>
      <span
        aria-hidden="true"
        class="absolute bottom-4 left-5 text-code font-medium tabular-nums text-white/75"
      >
        {ordinal}<span class="text-white/40">/{total}</span>
      </span>
    </div>

    <div class="flex min-w-0 flex-1 flex-col p-5 sm:p-7">
      <div class="flex items-start justify-between gap-4">
        <div class="flex min-w-0 items-start gap-4">
          <PersonPortrait
            name={founder.name}
            image={founder.image}
            class="aspect-[4/5] w-[84px] sm:hidden"
          />
          <div class="min-w-0 pt-0.5">
            <h3
              class="text-[20px] font-bold leading-[1.1] tracking-[-0.025em] text-white sm:text-[27px]"
            >
              {founder.name}
            </h3>
            <p
              class="mt-2 text-balance text-[13px] font-semibold leading-snug text-accent-on-dark sm:text-[15px]"
            >
              {founder.role}
            </p>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-3">
          {
            founder.linkedin && (
              <a
                href={founder.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${founder.name} on LinkedIn`}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-white/14 bg-white/[0.05] text-white/75 transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"
              >
                <SocialIcon name="linkedin" class="h-[15px] w-[15px]" />
              </a>
            )
          }
        </div>
      </div>

      {/* What they own, set as the card's one loud line and given the accent
          rule so a skimmer reading only the rules still gets the split. */}
      <p
        class="mt-5 border-l-2 border-accent/70 pl-3.5 text-[15.5px] font-semibold leading-[1.4] tracking-[-0.015em] text-white sm:mt-7 sm:pl-4 sm:text-[17.5px] sm:leading-[1.45]"
      >
        {founder.focus}
      </p>

      <p
        class="mt-3 text-[14px] leading-[1.65] text-white/72 sm:mt-3.5 sm:text-[15px]"
      >
        {founder.bio}
      </p>
    </div>
  </div>

  {/* `dt` is the label and `dd` the figure, ordered value-first by
      `flex-col-reverse` — the previous markup read the figure out as the term
      and the label as its definition. */}
  <dl
    class="relative z-10 mt-auto grid grid-cols-3 border-t border-white/10 bg-white/[0.035] px-5 py-4 sm:px-7 sm:py-5"
  >
    {
      founder.credentials.map((credential, i) => (
        <div
          class={cn(
            /* `justify-end` is the top of a reversed column: without it a
               stat whose label wraps to two lines pushes its figure up and
               the row of figures stops sharing a baseline. */
            "flex min-w-0 flex-col-reverse justify-end",
            i > 0 && "border-l border-white/10 pl-3 sm:pl-5",
            i < founder.credentials.length - 1 && "pr-3 sm:pr-5",
          )}
        >
          <dt class="mt-1.5 text-[10px] font-semibold uppercase leading-tight tracking-[0.08em] text-white/60 sm:text-[10.5px] sm:tracking-[0.1em]">
            {credential.label}
          </dt>
          <dd class="text-[16px] font-bold leading-none tracking-[-0.02em] text-white sm:text-[19px]">
            {credential.value}
          </dd>
        </div>
      ))
    }
  </dl>
</article>
