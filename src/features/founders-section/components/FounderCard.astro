---
import SocialIcon from "@/components/shared/SocialIcon.astro";
import PersonPortrait from "@/components/shared/PersonPortrait.astro";
import { FOUNDERS, type Founder } from "@/constants/people";
import { cn } from "@/lib/utils";

/**
 * Port of FounderCard in founders-section.tsx.
 * Grid: portrait spans rows beside name/focus/bio from `sm` up.
 */
interface Props {
  founder: Founder;
  index: number;
}

const { founder, index } = Astro.props;
const total = String(FOUNDERS.length).padStart(2, "0");
---

<div
  class="group relative h-full rounded-lg bg-linear-to-b from-white/[0.16] via-white/[0.06] to-white/[0.03] p-px transition-[background-image] duration-700 hover:from-accent/55 hover:via-accent/12"
>
  <div
    class="relative flex h-full flex-col overflow-hidden rounded-[15px] bg-[#212124] p-5 sm:p-7"
  >
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-10 top-0 h-px bg-linear-to-r from-transparent via-white/35 to-transparent"
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -right-28 -top-24 h-64 w-64 rounded-full bg-white/8 opacity-60 blur-[80px] transition-opacity duration-700 group-hover:opacity-100"
    ></span>

    <div
      class="relative grid grid-cols-[auto_1fr] items-start gap-x-4 gap-y-4 sm:gap-x-6 sm:gap-y-5"
    >
      <PersonPortrait
        name={founder.name}
        image={founder.image}
        class="aspect-[4/5] w-24 shrink-0 self-start sm:row-span-3 sm:w-44"
      />

      <div class="flex min-w-0 flex-col">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3
              class="text-[20px] font-bold leading-[1.1] tracking-[-0.025em] text-white sm:text-[27px]"
            >
              {founder.name}
            </h3>
            <p
              class="mt-1.5 text-balance text-[13px] font-semibold leading-snug text-accent-on-dark sm:text-[15px]"
            >
              {founder.role}
            </p>
          </div>

          <div class="flex shrink-0 items-center gap-3">
            <span
              aria-hidden="true"
              class="hidden text-code font-medium tabular-nums text-white/20 sm:inline"
            >
              {String(index + 1).padStart(2, "0")}/{total}
            </span>

            {
              founder.linkedin && (
                <a
                  href={founder.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${founder.name} on LinkedIn`}
                  class="flex h-8 w-8 items-center justify-center rounded-full border border-white/12 bg-white/[0.04] text-white/60 transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"
                >
                  <SocialIcon name="linkedin" class="h-[15px] w-[15px]" />
                </a>
              )
            }
          </div>
        </div>
      </div>

      <p
        class="col-span-2 text-[15.5px] font-medium leading-[1.4] tracking-[-0.015em] text-white sm:col-span-1 sm:col-start-2 sm:text-[17.5px] sm:leading-[1.45]"
      >
        {founder.focus}
      </p>

      <p
        class="col-span-2 text-[14px] leading-[1.6] text-white/72 sm:col-span-1 sm:col-start-2 sm:text-[15.5px] sm:leading-[1.65]"
      >
        {founder.bio}
      </p>
    </div>

    <div class="relative mt-auto pt-5 sm:pt-6">
      <span
        aria-hidden="true"
        class="block h-px w-full bg-linear-to-r from-white/18 via-white/8 to-transparent"
      ></span>
      <dl class="mt-3.5 grid grid-cols-3 sm:mt-4">
        {
          founder.credentials.map((credential, i) => (
            <div
              class={cn(
                i > 0
                  ? "border-l border-white/10 pl-3 sm:pl-4"
                  : "pr-3 sm:pr-4",
              )}
            >
              <dt class="text-[15px] font-bold leading-none tracking-[-0.02em] text-white sm:text-[18.5px]">
                {credential.value}
              </dt>
              <dd class="mt-1.5 min-h-7 text-[10px] font-semibold uppercase leading-tight tracking-[0.06em] text-white/55 sm:min-h-0 sm:text-[11px] sm:tracking-[0.1em]">
                {credential.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>
