---
import Container from "@/components/shared/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { WHY_CONTENT, WHY_ITEMS } from "../constants";

/** Port of features/why-cognivac/components/why-cognivac.tsx. */
---

<section class="bg-background py-16 sm:py-20 lg:py-28">
  <Container>
    <FadeIn>
      <div class="max-w-3xl">
        <SectionLabel class="mb-0 text-[13px] tracking-[0.08em] sm:text-sm">
          {WHY_CONTENT.label}
        </SectionLabel>
        <h2 class="text-section mt-5 max-w-[26ch] text-primary">
          {WHY_CONTENT.title}
        </h2>
        <p
          class="mt-4 max-w-[52ch] text-[16px] leading-[1.6] text-muted sm:text-[18px]"
        >
          {WHY_CONTENT.description}
        </p>
      </div>
    </FadeIn>

    <div class="mt-10 grid gap-5 sm:mt-12 md:grid-cols-3 md:gap-6 lg:mt-14">
      {
        WHY_ITEMS.map((item, i) => (
          <FadeIn delay={0.08 * (i + 1)}>
            <div class="flex h-full flex-col rounded-[18px] border border-border bg-card p-6 sm:rounded-[22px] sm:p-8">
              <span
                class="h-1 w-12 rounded-full"
                style={`background:${item.accentColor}`}
              />
              <h3 class="text-card-title mt-6 text-primary">{item.title}</h3>
              <p class="mt-3 text-[15px] leading-[1.65] text-muted sm:text-[16px]">
                {item.description}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>
