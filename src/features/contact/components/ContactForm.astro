---
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import GradientButton from "@/components/shared/GradientButton.astro";
import { NAV_ROUTES } from "@/constants/site";
import { ROLES } from "@/features/careers/constants";

interface Props {
  /** Hidden field so a gated resource request lands in the same inbox. */
  resource?: string;
  submitLabel?: string;
}

const { resource, submitLabel = "Send message" } = Astro.props;
const roleIds = ROLES.map((role) => role.id).join(",");
---

<div data-contact-wrap data-thank-you={NAV_ROUTES.thankYou} data-role-ids={roleIds}>
  <form
    data-contact-form
    class="relative space-y-4 rounded-md border border-border bg-card p-5 shadow-soft sm:space-y-5 sm:p-8"
    novalidate
    enctype="multipart/form-data"
  >
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute -left-[9999px] h-0 w-0 opacity-0"
    />
    <input type="hidden" name="role" id="contact-role" value="" />
    {resource && <input type="hidden" name="resource" value={resource} />}

    <div data-role-banner hidden class="rounded-md border border-accent/25 bg-lavender/50 px-4 py-3">
      <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-accent">
        Applying
      </p>
      <p data-role-label class="mt-1 text-[14.5px] font-semibold text-foreground"></p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 sm:gap-5">
      <div class="space-y-2">
        <Label for="name">Full name</Label>
        <Input id="name" name="name" autocomplete="name" />
        <p
          data-error-for="name"
          class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
          role="alert"
        >
        </p>
      </div>

      <div class="space-y-2">
        <Label for="company">Company</Label>
        <Input id="company" name="company" autocomplete="organization" />
        <p
          data-error-for="company"
          class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
          role="alert"
        >
        </p>
      </div>
    </div>

    <div class="space-y-2">
      <Label for="email">Work email</Label>
      <Input
        id="email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
      />
      <p
        data-error-for="email"
        class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
        role="alert"
      >
      </p>
    </div>

    <div class="space-y-2">
      <Label for="message">How can we help?</Label>
      <textarea
        id="message"
        name="message"
        rows="5"
        placeholder="What is not working yet, and what would good look like?"
        class="text-input flex w-full resize-y py-2.5 leading-[1.55] transition-colors placeholder:text-muted-light focus-visible:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/30"
      ></textarea>
      <p
        data-error-for="message"
        class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
        role="alert"
      >
      </p>
    </div>

    <div data-resume-field hidden class="space-y-2">
      <Label for="resume">Resume (PDF or Word, 5 MB max)</Label>
      <Input
        id="resume"
        name="resume"
        type="file"
        accept=".pdf,.doc,.docx,application/pdf"
      />
      <p
        data-error-for="resume"
        class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
        role="alert"
      >
      </p>
    </div>

    <GradientButton
      type="submit"
      class="h-12 min-h-12 w-full justify-center"
    >
      <span data-submit-label>{submitLabel}</span>
    </GradientButton>

    <p
      data-contact-error
      class="hidden flex items-start gap-2 text-[13.5px] leading-snug text-error"
      role="alert"
    >
      Something went wrong. Please try again, or email hello@cognivac.com.
    </p>

    <p class="text-[12.5px] leading-snug text-muted-light">
      We reply within one business day. No newsletter signup, no sales sequence.
    </p>
  </form>
</div>

<script>
  import { ROLES } from "@/features/careers/constants";

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const MAX_RESUME = 5 * 1024 * 1024;

  const RULES: Record<string, (value: string) => string | null> = {
    name: (v) => (v.trim().length >= 2 ? null : "Name is required"),
    email: (v) => (EMAIL_RE.test(v.trim()) ? null : "Enter a valid email"),
    company: (v) => (v.trim().length >= 1 ? null : "Company is required"),
    message: (v) =>
      v.trim().length >= 10 ? null : "Please share a bit more detail",
  };

  function initContactForm() {
    document
      .querySelectorAll<HTMLElement>("[data-contact-wrap]")
      .forEach((wrap) => {
        if (wrap.dataset.contactReady === "true") return;
        wrap.dataset.contactReady = "true";

        const form = wrap.querySelector<HTMLFormElement>("[data-contact-form]");
        if (!form) return;

        const thankYou = wrap.dataset.thankYou ?? "/thank-you";
        const label = form.querySelector<HTMLElement>("[data-submit-label]");
        const submitBtn = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        const failure = form.querySelector<HTMLElement>("[data-contact-error]");
        const roleInput = form.querySelector<HTMLInputElement>("#contact-role");
        const resumeField = form.querySelector<HTMLElement>("[data-resume-field]");
        const roleBanner = wrap.querySelector<HTMLElement>("[data-role-banner]");
        const roleLabel = wrap.querySelector<HTMLElement>("[data-role-label]");
        const touched = new Set<string>();

        const params = new URLSearchParams(window.location.search);
        const roleId = params.get("role") ?? "";
        const known = ROLES.find((role) => role.id === roleId);
        if (known && roleInput) {
          roleInput.value = known.id;
          if (roleBanner && roleLabel) {
            roleBanner.hidden = false;
            roleLabel.textContent = known.title;
          }
          resumeField?.removeAttribute("hidden");
          const message = form.querySelector<HTMLTextAreaElement>("#message");
          if (message && !message.value) {
            message.value = `I would like to apply for ${known.title}.`;
          }
        }

        const showError = (field: string, message: string | null) => {
          const node = form.querySelector<HTMLElement>(
            `[data-error-for="${field}"]`,
          );
          const input = form.querySelector<HTMLElement>(`#${field}`);
          if (!node) return;
          if (message) {
            node.innerHTML = "";
            node.textContent = message;
            node.classList.remove("hidden");
            input?.setAttribute("aria-invalid", "true");
            input?.classList.add("border-error");
          } else {
            node.textContent = "";
            node.classList.add("hidden");
            input?.removeAttribute("aria-invalid");
            input?.classList.remove("border-error");
          }
        };

        const validateField = (field: string) => {
          const rule = RULES[field];
          if (!rule) return true;
          const value = String(new FormData(form).get(field) ?? "");
          const message = rule(value);
          showError(field, message);
          return !message;
        };

        form.addEventListener("focusout", (event) => {
          const target = event.target as HTMLElement;
          const name = (target as HTMLInputElement).name;
          if (!name || !(name in RULES)) return;
          touched.add(name);
          validateField(name);
        });

        form.addEventListener("input", (event) => {
          const name = (event.target as HTMLInputElement).name;
          if (!name || !touched.has(name)) return;
          validateField(name);
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          failure?.classList.add("hidden");

          const data = new FormData(form);
          let valid = true;

          for (const field of Object.keys(RULES)) {
            touched.add(field);
            if (!validateField(field)) valid = false;
          }

          const resume = data.get("resume");
          if (resume instanceof File && resume.size > 0) {
            if (resume.size > MAX_RESUME) {
              showError("resume", "Resume must be 5 MB or smaller");
              valid = false;
            } else {
              showError("resume", null);
            }
          }

          if (!valid) return;

          if (label) label.textContent = "Sending…";
          if (submitBtn) submitBtn.disabled = true;

          try {
            const res = await fetch("/api/contact", {
              method: "POST",
              body: data,
            });
            if (!res.ok) throw new Error("Failed");

            const next = new URL(thankYou, window.location.origin);
            const role = String(data.get("role") ?? "");
            const resource = String(data.get("resource") ?? "");
            if (role) next.searchParams.set("role", role);
            if (resource) next.searchParams.set("resource", resource);
            window.location.assign(next.pathname + next.search);
          } catch {
            failure?.classList.remove("hidden");
            if (label) label.textContent = "Send message";
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
