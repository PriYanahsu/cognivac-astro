---
import { Check } from "@lucide/astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import GradientButton from "@/components/shared/GradientButton.astro";

/**
 * Port of features/contact/components/contact-form.tsx.
 * Success replaces the form. Validation re-checks as the field is corrected.
 */
---

<div data-contact-wrap>
  <div
    data-contact-success-panel
    hidden
    role="status"
    class="flex h-full min-h-80 flex-col items-center justify-center rounded-md border border-border bg-card p-8 text-center shadow-soft"
  >
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent text-white">
      <Check class="h-6 w-6" />
    </span>
    <h3 class="mt-5 text-[20px] font-bold tracking-[-0.02em] text-foreground sm:text-[23px]">
      Message sent
    </h3>
    <p class="mt-2.5 max-w-[38ch] text-[14.5px] leading-[1.55] text-muted sm:text-[15.5px]">
      An engineer reads it, not a routing form. You will hear back within one
      business day.
    </p>
    <button
      type="button"
      data-contact-again
      class="mt-6 text-[13.5px] font-semibold text-accent underline-offset-4 hover:underline"
    >
      Send another
    </button>
  </div>

  <form
    data-contact-form
    class="space-y-4 rounded-md border border-border bg-card p-5 shadow-soft sm:space-y-5 sm:p-8"
    novalidate
  >
    <div class="grid gap-4 sm:grid-cols-2 sm:gap-5">
      <div class="space-y-2">
        <Label for="name">Full name</Label>
        <Input id="name" name="name" autocomplete="name" />
        <p
          data-error-for="name"
          class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
          role="alert"
        >
        </p>
      </div>

      <div class="space-y-2">
        <Label for="company">Company</Label>
        <Input id="company" name="company" autocomplete="organization" />
        <p
          data-error-for="company"
          class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
          role="alert"
        >
        </p>
      </div>
    </div>

    <div class="space-y-2">
      <Label for="email">Work email</Label>
      <Input
        id="email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
      />
      <p
        data-error-for="email"
        class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
        role="alert"
      >
      </p>
    </div>

    <div class="space-y-2">
      <Label for="message">How can we help?</Label>
      <textarea
        id="message"
        name="message"
        rows="5"
        placeholder="What is not working yet, and what would good look like?"
        class="text-input flex w-full resize-y py-2.5 leading-[1.55] transition-colors placeholder:text-muted-light focus-visible:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/30"
      ></textarea>
      <p
        data-error-for="message"
        class="hidden flex items-center gap-1.5 overflow-hidden text-[12.5px] font-medium text-error"
        role="alert"
      >
      </p>
    </div>

    <GradientButton
      type="submit"
      class="h-12 min-h-12 w-full justify-center"
    >
      <span data-submit-label>Send message</span>
    </GradientButton>

    <p
      data-contact-error
      class="hidden flex items-start gap-2 text-[13.5px] leading-snug text-error"
      role="alert"
    >
      Something went wrong. Please try again, or email hello@cognivac.com.
    </p>

    <p class="text-[12.5px] leading-snug text-muted-light">
      We reply within one business day. No newsletter signup, no sales sequence.
    </p>
  </form>
</div>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const RULES: Record<string, (value: string) => string | null> = {
    name: (v) => (v.trim().length >= 2 ? null : "Name is required"),
    email: (v) => (EMAIL_RE.test(v.trim()) ? null : "Enter a valid email"),
    company: (v) => (v.trim().length >= 1 ? null : "Company is required"),
    message: (v) =>
      v.trim().length >= 10 ? null : "Please share a bit more detail",
  };

  function initContactForm() {
    document
      .querySelectorAll<HTMLElement>("[data-contact-wrap]")
      .forEach((wrap) => {
        if (wrap.dataset.contactReady === "true") return;
        wrap.dataset.contactReady = "true";

        const form = wrap.querySelector<HTMLFormElement>("[data-contact-form]");
        const success = wrap.querySelector<HTMLElement>(
          "[data-contact-success-panel]",
        );
        const again = wrap.querySelector<HTMLButtonElement>(
          "[data-contact-again]",
        );
        if (!form || !success) return;

        const label = form.querySelector<HTMLElement>("[data-submit-label]");
        const submitBtn = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        const failure = form.querySelector<HTMLElement>("[data-contact-error]");
        const touched = new Set<string>();

        const showError = (field: string, message: string | null) => {
          const node = form.querySelector<HTMLElement>(
            `[data-error-for="${field}"]`,
          );
          const input = form.querySelector<HTMLElement>(`#${field}`);
          if (!node) return;
          if (message) {
            node.innerHTML = "";
            node.textContent = message;
            node.classList.remove("hidden");
            input?.setAttribute("aria-invalid", "true");
            input?.classList.add("border-error");
          } else {
            node.textContent = "";
            node.classList.add("hidden");
            input?.removeAttribute("aria-invalid");
            input?.classList.remove("border-error");
          }
        };

        const validateField = (field: string) => {
          const rule = RULES[field];
          if (!rule) return true;
          const value = String(
            new FormData(form).get(field) ?? "",
          );
          const message = rule(value);
          showError(field, message);
          return !message;
        };

        form.addEventListener("focusout", (event) => {
          const target = event.target as HTMLElement;
          const name = (target as HTMLInputElement).name;
          if (!name || !(name in RULES)) return;
          touched.add(name);
          validateField(name);
        });

        form.addEventListener("input", (event) => {
          const name = (event.target as HTMLInputElement).name;
          if (!name || !touched.has(name)) return;
          validateField(name);
        });

        again?.addEventListener("click", () => {
          success.hidden = true;
          form.hidden = false;
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          failure?.classList.add("hidden");

          const data = new FormData(form);
          const payload: Record<string, string> = {};
          let valid = true;

          for (const [field, rule] of Object.entries(RULES)) {
            const value = String(data.get(field) ?? "");
            payload[field] = value;
            touched.add(field);
            const message = rule(value);
            showError(field, message);
            if (message) valid = false;
          }

          if (!valid) return;

          if (label) label.textContent = "Sending…";
          if (submitBtn) submitBtn.disabled = true;

          try {
            const res = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            if (!res.ok) throw new Error("Failed");

            form.reset();
            Object.keys(RULES).forEach((field) => showError(field, null));
            touched.clear();
            form.hidden = true;
            success.hidden = false;
          } catch {
            failure?.classList.remove("hidden");
          } finally {
            if (label) label.textContent = "Send message";
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
