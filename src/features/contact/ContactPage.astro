---
import { Mail, MapPin, Clock, Check } from "@lucide/astro";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { SITE_CONFIG, NAV_ROUTES } from "@/constants/site";
import { FAQS } from "@/features/home/constants/content";
import FaqAccordion from "@/components/shared/FaqAccordion.astro";
import ContactForm from "./components/ContactForm.astro";
import CalEmbed from "./components/CalEmbed.astro";

/** Port of features/contact/index.tsx. */

const WHAT_HAPPENS = [
  {
    id: "reply",
    index: "01",
    title: "We reply within one business day",
    description:
      "A real engineer reads your message — not a routing form. If it is not a fit, we will say so and point you somewhere better.",
  },
  {
    id: "call",
    index: "02",
    title: "A 30-minute technical discussion",
    description:
      "No pitch deck. We ask about your systems, constraints, and what success would actually look like.",
  },
  {
    id: "proposal",
    index: "03",
    title: "A scoped approach, in writing",
    description:
      "Within a week you get a written view of approach, milestones, team shape, and commercial envelope.",
  },
];

const REASSURANCES = [
  "NDA signed before discovery if you need one",
  "You keep full ownership of everything we produce",
  "No obligation after the first conversation",
];
---

<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact" },
  ])}
/>

<PageHero
  label="Contact"
  title="Tell us what is not working yet"
  description="Whether it is a stalled AI initiative, a legacy platform holding growth back, or a build you need a partner for — start with the problem and we will work backwards to the approach."
  breadcrumbs={[{ label: "Contact" }]}
  highlights={["Reply within 1 business day", "Talk to an engineer, not a rep"]}
  primaryCta={{ label: "Book a time", href: `${NAV_ROUTES.contact}#book` }}
/>

<section class="bg-background section-padding">
  <Container>
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-14">
      <FadeIn delay={0.12} class="order-1 lg:order-2 lg:col-span-7">
        <ContactForm />
      </FadeIn>

      <div class="order-2 lg:order-1 lg:col-span-5">
        <SectionIntro
          label="Get In Touch"
          title="Reach us directly"
          titleClass="max-w-[18ch]"
        />

        <ul class="mt-6 space-y-4 sm:mt-8 sm:space-y-5">
          <li class="flex gap-3.5 sm:gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-card text-accent ring-1 ring-border sm:h-11 sm:w-11">
              <Mail class="h-4.5 w-4.5 sm:h-5 sm:w-5" />
            </span>
            <div class="min-w-0">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted sm:text-[12px]">
                Email
              </p>
              <a
                href={`mailto:${SITE_CONFIG.email}`}
                class="mt-0.5 block text-[15px] font-semibold text-foreground transition-colors hover:text-accent sm:mt-1 sm:text-[16px]"
              >
                {SITE_CONFIG.email}
              </a>
            </div>
          </li>

          <li class="flex gap-3.5 sm:gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-card text-accent ring-1 ring-border sm:h-11 sm:w-11">
              <MapPin class="h-4.5 w-4.5 sm:h-5 sm:w-5" />
            </span>
            <div class="min-w-0">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted sm:text-[12px]">
                Location
              </p>
              <p class="mt-0.5 text-[15px] font-semibold text-foreground sm:mt-1 sm:text-[16px]">
                {SITE_CONFIG.address}
              </p>
            </div>
          </li>

          <li class="flex gap-3.5 sm:gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-card text-accent ring-1 ring-border sm:h-11 sm:w-11">
              <Clock class="h-4.5 w-4.5 sm:h-5 sm:w-5" />
            </span>
            <div class="min-w-0">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted sm:text-[12px]">
                Response time
              </p>
              <p class="mt-0.5 text-[15px] font-semibold text-foreground sm:mt-1 sm:text-[16px]">
                Within one business day
              </p>
            </div>
          </li>
        </ul>

        <ul class="mt-7 space-y-2.5 border-t border-border pt-6 sm:mt-9 sm:space-y-3 sm:pt-7">
          {
            REASSURANCES.map((item) => (
              <li class="flex gap-2.5">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
                <span class="text-[13.5px] leading-normal text-foreground/75 sm:text-[14.5px] sm:leading-[1.55]">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>

<section class="border-y border-border bg-card section-padding">
  <Container>
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-14">
      <SectionIntro
        label="Schedule"
        title="Book the 30-minute call instead"
        description="Same conversation as the form — a working session on the problem, not a qualification call. Pick a time or send the note above."
        class="max-w-none lg:col-span-4"
        titleClass="max-w-[16ch]"
        descriptionClass="max-w-[36ch]"
      />
      <FadeIn delay={0.1} class="lg:col-span-8">
        <CalEmbed />
      </FadeIn>
    </div>
  </Container>
</section>

<section class="relative overflow-hidden bg-[#0f0f12] section-padding text-white">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label="What Happens Next"
      title="Three steps, no black box"
      class="max-w-2xl"
    />

    <div class="mt-8 grid gap-3 sm:mt-14 sm:gap-5 md:grid-cols-3">
      {
        WHAT_HAPPENS.map((step, i) => (
          <FadeIn delay={0.08 * (i + 1)} class="h-full">
            <div class="group relative h-full overflow-hidden rounded-md border border-white/12 bg-white/[0.04] p-5 transition-colors duration-300 hover:border-white/25 hover:bg-white/[0.07] sm:p-7">
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-teal transition-transform duration-500 ease-out group-hover:scale-x-100"
              />
              <span class="text-[11px] font-bold tracking-[0.16em] text-teal sm:text-[12px]">
                {step.index}
              </span>
              <h3 class="mt-2.5 text-[16.5px] font-bold leading-tight tracking-[-0.02em] text-white sm:mt-3.5 sm:text-[20px]">
                {step.title}
              </h3>
              <p class="mt-2 text-[13.5px] leading-[1.55] text-white/80 sm:mt-3 sm:text-[14.5px] sm:leading-[1.6]">
                {step.description}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="bg-lavender/30 section-padding">
  <Container>
    <div class="grid gap-6 sm:gap-8 lg:grid-cols-12 lg:gap-12">
      <SectionIntro
        label="Before You Write"
        title="Questions teams ask first"
        description="Still unsure? Send the message anyway — a short reply is faster than more reading."
        class="max-w-none lg:sticky lg:top-28 lg:col-span-4 lg:self-start"
        titleClass="text-section-column"
        descriptionClass="max-w-[38ch]"
      />

      <FadeIn delay={0.1} class="lg:col-span-8">
        <FaqAccordion items={FAQS} idPrefix="contact-faq" />
      </FadeIn>
    </div>
  </Container>
</section>
