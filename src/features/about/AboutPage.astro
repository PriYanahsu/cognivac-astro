---
import JsonLd from "@/lib/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo";
import PageHero from "@/components/shared/PageHero.astro";
import Container from "@/components/shared/Container.astro";
import SectionIntro from "@/components/shared/SectionIntro.astro";
import CountUp from "@/components/shared/CountUp.astro";
import FadeIn from "@/components/animations/FadeIn.astro";
import { STATS } from "@/features/home/constants/content";
import { PROCESS_STEPS } from "@/features/process-section/constants";
import { WHY_ITEMS } from "@/features/why-cognivac/constants";
import CtaSection from "@/features/cta-section/components/CtaSection.astro";
import { NAV_ROUTES } from "@/constants/site";

/** Port of features/about/index.tsx. */

const POSITIONING = [
  {
    id: "not-a-product",
    title: "We are not a product company",
    description:
      "There is no Cognivac platform you have to adopt. We build what your business needs, integrate it with the systems you already run, and hand it over documented.",
  },
  {
    id: "ai-where-it-pays",
    title: "AI where it changes a number",
    description:
      "We apply intelligence to cycle time, error rates, forecast accuracy, or customer experience — never because a technology is fashionable.",
  },
  {
    id: "long-term",
    title: "Built for the long engagement",
    description:
      "Most clients stay across multiple releases. That only works if what we ship stays maintainable by people who were not in the original room.",
  },
];

const PRINCIPLES = [
  {
    id: "production",
    title: "Production from day one",
    description:
      "Security, tests, documentation, and performance are part of delivery — never a hardening phase funded later.",
    art: "linear-gradient(135deg,#1e4fd8,#163db0)",
  },
  {
    id: "clarity",
    title: "Clarity over ceremony",
    description:
      "You always know who owns the project, what is shipping next, and how progress maps to the outcome we agreed.",
    art: "linear-gradient(135deg,#3f7bb0,#bfe3ff)",
  },
  {
    id: "transfer",
    title: "Knowledge transfer, always",
    description:
      "Runbooks, architecture decision records, and pairing — so your team can operate and extend the system without us.",
    art: "linear-gradient(135deg,#1a1a1c,#3a3a40)",
  },
];
---

<JsonLd
  data={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ])}
/>

<PageHero
  label="About Cognivac"
  title="A software partner for companies putting AI into real operations"
  description="We are a service-based software development company with AI integration at the centre of how we work. Enterprises come to us when initiatives stall between ambition and production."
  breadcrumbs={[{ label: "About" }]}
  primaryCta={{ label: "Work with us", href: NAV_ROUTES.contact }}
  secondaryCta={{ label: "See open roles", href: NAV_ROUTES.careers }}
  highlights={["120+ systems in production", "25+ industries", "98% retention"]}
/>

<section class="bg-background section-padding">
  <Container>
    <div class="grid gap-6 sm:gap-10 lg:grid-cols-12 lg:gap-16">
      <SectionIntro
        label="Our Mission"
        title="Close the gap between AI ambition and production reality"
        description="Help organizations turn AI and modern software into durable capability — secure, maintainable systems that reduce manual work and support clearer decisions, without the risk of demos that never reach production."
        class="max-w-none lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
        titleClass="max-w-[20ch]"
        descriptionClass="max-w-[46ch]"
      />

      <div class="divide-y divide-border lg:col-span-7">
        {
          POSITIONING.map((point, i) => (
            <FadeIn delay={0.08 * (i + 1)}>
              <div class="group flex gap-4 py-5 sm:gap-6 sm:py-8">
                <span
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-[11px] font-bold tracking-[0.16em] text-muted-light transition-colors duration-300 group-hover:text-accent [font-variant-numeric:tabular-nums] sm:mt-1.5 sm:text-[12px]"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="min-w-0">
                  <h3 class="text-[17px] font-bold leading-tight tracking-[-0.02em] text-foreground sm:text-heading-md">
                    {point.title}
                  </h3>
                  <p class="mt-2 max-w-[54ch] text-[14px] leading-[1.55] text-muted sm:mt-2.5 sm:text-[16.5px] sm:leading-[1.65]">
                    {point.description}
                  </p>
                </div>
              </div>
            </FadeIn>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<section class="relative overflow-hidden bg-[#1a1a1c] section-padding text-white">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <Container class="relative z-10">
    <SectionIntro
      tone="dark"
      align="center"
      label="Track Record"
      title="Measured by what stayed running"
      class="max-w-2xl"
    />

    <div class="mt-9 grid grid-cols-2 gap-x-5 gap-y-8 sm:mt-12 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-5 lg:gap-8">
      {
        STATS.map((stat, i) => (
          <FadeIn delay={0.06 * (i + 1)}>
            <div class="text-center">
              <p class="text-[clamp(1.75rem,7vw,3rem)] font-bold leading-none tracking-[-0.02em] text-white">
                <CountUp
                  value={stat.value}
                  prefix={stat.prefix}
                  suffix={stat.suffix}
                  decimals={stat.decimals}
                />
              </p>
              <p class="mx-auto mt-2.5 max-w-[20ch] text-[12.5px] leading-snug text-white/65 sm:mt-3 sm:text-[13.5px]">
                {stat.label}
              </p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="border-b border-border bg-card section-padding">
  <Container>
    <SectionIntro
      label="How We Engineer"
      title="Three principles that survive contact with a deadline"
      titleClass="max-w-[22ch]"
    />

    <div class="card-grid md:grid-cols-3">
      {
        PRINCIPLES.map((principle, i) => (
          <FadeIn delay={0.08 * (i + 1)} class="h-full">
            <div class="group flex h-full flex-col overflow-hidden rounded-md border border-border bg-background transition-[border-color,box-shadow] duration-300 hover:border-accent/40 hover:shadow-soft">
              <div
                class="h-22 w-full transition-transform duration-500 ease-out group-hover:scale-105 sm:h-35"
                style={`background:${principle.art}`}
              />
              <div class="flex flex-1 flex-col p-5 sm:p-7">
                <h3 class="text-[17px] font-bold leading-tight tracking-[-0.02em] text-foreground sm:text-heading-md">
                  {principle.title}
                </h3>
                <p class="mt-2.5 copy-md sm:mt-3">{principle.description}</p>
              </div>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="bg-background section-padding">
  <Container>
    <SectionIntro
      label="How We Work"
      title="Discovery first, always"
      description="Engagements begin with business discovery — objectives, constraints, existing systems, and the operational pain behind the request — not a technology pitch."
      titleClass="max-w-[24ch]"
      descriptionClass="max-w-[54ch]"
    />

    <div class="card-grid sm:grid-cols-2 lg:grid-cols-5 lg:gap-4">
      {
        PROCESS_STEPS.map((step, i) => (
          <FadeIn delay={0.06 * (i + 1)} class="h-full">
            <div class="group h-full rounded-md border border-border bg-card p-4 transition-[border-color,transform] duration-300 hover:border-accent/40 sm:p-6 [@media(hover:hover)]:hover:-translate-y-0.5">
              <span class="text-[11px] font-bold tracking-[0.16em] text-accent sm:text-[12px]">
                {step.index}
              </span>
              <h3 class="mt-2.5 text-[16px] font-bold leading-tight tracking-[-0.02em] text-foreground sm:mt-3 sm:text-heading-md">
                {step.title}
              </h3>
              <p class="mt-2 copy-md sm:mt-2.5">{step.description}</p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<section class="border-y border-border bg-card section-padding">
  <Container>
    <SectionIntro
      align="center"
      label="Why Clients Stay"
      title="Trust comes from transparency and consistency"
      class="max-w-2xl"
    />

    <div class="card-grid md:grid-cols-3">
      {
        WHY_ITEMS.map((item, i) => (
          <FadeIn delay={0.08 * (i + 1)} class="h-full">
            <div class="group flex h-full flex-col rounded-md border border-border bg-background p-5 transition-[border-color,box-shadow] duration-300 hover:border-accent/40 hover:shadow-soft sm:p-8">
              <span
                class="h-1 w-10 origin-left rounded-full transition-transform duration-500 ease-out group-hover:scale-x-150 sm:w-12"
                style={`background:${item.accentColor}`}
              />
              <h3 class="text-card-title mt-4 text-foreground sm:mt-6">
                {item.title}
              </h3>
              <p class="mt-2.5 copy-md sm:mt-3">{item.description}</p>
            </div>
          </FadeIn>
        ))
      }
    </div>
  </Container>
</section>

<CtaSection />
